<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMed | Assuntos</title>
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
<link rel="stylesheet" href="/public/css/content/base.css">
<link rel="stylesheet" href="/public/css/content/list.css">
<link rel="stylesheet" href="/public/css/content/form.css">

</head>
<body>
  <div class="container">
    <div class="topbar">
      <a href="/dashboard" class="btnSecondary">← Dashboard</a>
      <div class="tabs">
        <a class="tab" href="/conteudos/materias">Matérias</a>
        <a class="tab" href="/conteudos/topicos">Tópicos</a>
        <a class="tab active" href="/conteudos/assuntos">Assuntos</a>
      </div>
      <a href="/logout" class="btnSecondary">Sair</a>
    </div>

    <div class="card">
      <h1>Assuntos</h1>
      <p class="sub">Assunto pertence a um tópico (ex: PA → Soma dos termos). Pode existir tópico sem assunto.</p>

      <% if (erro) { %><div class="alert"><%= erro %></div><% } %>
      <% if (ok) { %><div class="ok"><%= ok %></div><% } %>

      <form method="POST" action="/conteudos/assuntos" class="formGrid">
        <select name="topic_id" required>
          <option value="">Selecione o tópico</option>
          <% topics.forEach(t => { %>
            <option value="<%= t.id %>">
              <%= t.subject ? t.subject.nome : "-" %> → <%= t.nome %>
            </option>
          <% }) %>
        </select>

        <input name="nome" placeholder="Nome do assunto (opcional no registro)" required />
        <button type="submit">Adicionar</button>
      </form>

      <div class="table">
        <div class="thead">
          <div>Matéria</div>
          <div>Tópico</div>
          <div>Assunto</div>
          <div>Ações</div>
        </div>

        <% if (!subtopics.length) { %>
          <div class="trow"><div class="muted" style="grid-column:1/-1;">Nenhum assunto cadastrado ainda.</div></div>
        <% } %>

        <% subtopics.forEach(s => { %>
          <div class="trow">
            <div><%= s.topic && s.topic.subject ? s.topic.subject.nome : "-" %></div>
            <div><%= s.topic ? s.topic.nome : "-" %></div>
            <div><%= s.nome %></div>
            <div class="actions">
              <a class="btnSecondary" href="/conteudos/assuntos/<%= s.id %>/editar">Editar</a>
              <form method="POST" action="/conteudos/assuntos/<%= s.id %>/excluir" onsubmit="return confirm('Excluir assunto?');">
                <button class="danger" type="submit">Excluir</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</body>
</html>
