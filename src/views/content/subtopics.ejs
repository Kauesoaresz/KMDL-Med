<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Assuntos - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/content/assuntos.css">
</head>

<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- Header -->
    <div class="page-header">
      <div>
        <h1>📝 Assuntos</h1>
        <p>Cadastre assuntos dentro de cada tópico</p>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
      <div class="tabs">
        <a class="tab" href="/conteudos/materias">Matérias</a>
        <a class="tab" href="/conteudos/topicos">Tópicos</a>
        <a class="tab active" href="/conteudos/assuntos">Assuntos</a>
      </div>
    </div>

    <!-- Alert Messages -->
    <% if (erro) { %>
      <div class="alert alert-error"><%= erro %></div>
    <% } %>
    
    <% if (ok) { %>
      <div class="alert alert-success"><%= ok %></div>
    <% } %>

    <!-- Filters Card -->
    <div class="section">
      <div class="form-card">
        <h2 class="section-title">Filtrar por Matéria</h2>
        <div class="filter-grid">
          <div class="form-group">
            <label for="filter_subject">Matéria</label>
            <select name="subject_id" id="filter_subject" onchange="window.location.href='?subject_id=' + this.value">
              <option value="">Todas as matérias</option>
              <% subjects.forEach(s => { %>
                <option value="<%= s.id %>" <%= String(filtroSubjectId) === String(s.id) ? "selected" : "" %>>
                  <%= s.nome %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="section">
      <div class="form-card">
        <h2 class="section-title">Novo Assunto</h2>
        <form method="POST" action="/conteudos/assuntos?subject_id=<%= filtroSubjectId || '' %>&topic_id=<%= filtroTopicId || '' %>" class="form-grid">
          <div class="form-group">
            <label for="topic_id">Tópico</label>
            <select name="topic_id" id="topic_id" required onchange="window.location.href='?subject_id=<%= filtroSubjectId || '' %>&topic_id=' + this.value">
              <option value="">Selecione o tópico</option>
              <% topics.forEach(t => { %>
                <option value="<%= t.id %>" <%= String(filtroTopicId) === String(t.id) ? "selected" : "" %>>
                  <%= t.subject?.nome %> → <%= t.nome %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="nome">Nome do assunto</label>
            <input 
              type="text" 
              id="nome" 
              name="nome" 
              placeholder="Ex: Função do 1º grau, Lei de Newton..." 
              required 
              <%= !filtroTopicId ? "disabled" : "" %>
            />
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" <%= !filtroTopicId ? "disabled" : "" %>>
              + Adicionar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- List -->
    <div class="section">
      <h2 class="section-title">Assuntos Cadastrados</h2>
      
      <% if (!subtopics || subtopics.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📝</div>
          <h3>Nenhum assunto encontrado</h3>
          <p>Selecione um tópico acima e adicione seus primeiros assuntos!</p>
        </div>
      <% } else { %>
        <div class="list-table">
          <% subtopics.forEach(s => { %>
            <div class="list-row">
              <div class="list-cell cell-topic">
                <span class="cell-badge"><%= s.topic?.subject?.nome || "-" %></span>
              </div>
              <div class="list-cell cell-subtopic">
                <span class="cell-badge-secondary"><%= s.topic?.nome || "-" %></span>
              </div>
              <div class="list-cell cell-name">
                <span class="cell-icon">📋</span>
                <span class="cell-text"><%= s.nome %></span>
              </div>
              <div class="list-cell cell-actions">
                <a href="/conteudos/assuntos/<%= s.id %>/editar" class="btn-secondary">
                  Editar
                </a>
                <form method="POST" action="/conteudos/assuntos/<%= s.id %>/excluir"
                      onsubmit="return confirm('Excluir assunto?');" class="inline-form">
                  <button type="submit" class="btn-danger">
                    Excluir
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</main>

</body>
</html>

