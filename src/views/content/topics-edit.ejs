<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Editar tópico", css: ["conteudos"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>✏️ Editar tópico</h1>
        <p>Você pode mudar o nome ou mover o tópico para outra matéria.</p>
      </div>
      <a href="/conteudos/topicos?subject_id=<%= topic.subject_id %>" class="btn">← Voltar</a>
    </header>

    <% if (erro) { %><div class="alert alert-error"><%= erro %></div><% } %>

    <form method="POST" action="/conteudos/topicos/<%= topic.id %>/editar" class="card edit-card stack" autocomplete="off">
      <div class="form-group">
        <label for="subject_id">Matéria</label>
        <select id="subject_id" name="subject_id" required>
          <% subjects.forEach(s => { %>
            <option value="<%= s.id %>" <%= s.id === topic.subject_id ? "selected" : "" %>><%= s.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="nome">Nome do tópico</label>
        <input type="text" id="nome" name="nome" maxlength="120" required autofocus value="<%= topic.nome %>">
      </div>

      <div class="row">
        <button type="submit" class="btn-primary">💾 Salvar</button>
        <a href="/conteudos/topicos?subject_id=<%= topic.subject_id %>" class="btn">Cancelar</a>
      </div>
    </form>

  </div>
</main>

</body>
</html>