<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMed | Editar Tópico</title>

  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/content/base.css">
  <link rel="stylesheet" href="/public/css/content/form.css">
</head>

<body class="page-bg">

  <%- include("../partials/sidebar", { active: "conteudos", userNome }) %>


  <main class="with-sidebar">
    <div class="container">

      <div class="topbar">
        <a href="/conteudos/topicos" class="btnSecondary">← Voltar</a>
        
      </div>

      <div class="card">
        <h1>Editar Tópico</h1>

        <% if (erro) { %>
          <div class="alert"><%= erro %></div>
        <% } %>

        <form method="POST"
              action="/conteudos/topicos/<%= topic.id %>/editar"
              class="formCol">

          <label>Matéria</label>
          <select name="subject_id" required>
            <% subjects.forEach(s => { %>
              <option value="<%= s.id %>" <%= s.id === topic.subject_id ? "selected" : "" %>>
                <%= s.nome %>
              </option>
            <% }) %>
          </select>

          <label>Nome do tópico</label>
          <input name="nome" value="<%= topic.nome %>" required />

          <button type="submit">Salvar</button>
        </form>
      </div>

    </div>
  </main>

</body>
</html>
