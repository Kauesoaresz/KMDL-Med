<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Tópicos", css: ["conteudos"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📚 Conteúdos</h1>
        <p>Organize suas matérias e os tópicos de cada uma.</p>
      </div>
    </header>

    <div class="tabs">
      <a class="tab" href="/conteudos/materias">Matérias <span class="badge"><%= subjects.length %></span></a>
      <a class="tab active" href="/conteudos/topicos">Tópicos</a>
    </div>

    <% if (erro) { %><div class="alert alert-error"><%= erro %></div><% } %>
    <% if (ok) { %><div class="alert alert-success"><%= ok %></div><% } %>

    <% if (subjects.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📚</div>
        <h3>Cadastre uma matéria primeiro</h3>
        <p>Os tópicos ficam dentro das matérias. <a href="/conteudos/materias">Ir para Matérias →</a></p>
      </div>
    <% } else { %>

    <div class="topics-layout">

      <!-- MATÉRIAS -->
      <aside class="card side-list">
        <div class="band-label">Matéria</div>
        <% subjects.forEach(s => { %>
          <a href="/conteudos/topicos?subject_id=<%= s.id %>"
             class="side-item <%= selected && selected.id === s.id ? 'on' : '' %>" style="--h: <%= s.hue %>">
            <span class="subj-dot"></span>
            <span class="side-name"><%= s.nome %></span>
            <span class="badge"><%= s.topicos %></span>
          </a>
        <% }) %>
      </aside>

      <!-- TÓPICOS DA MATÉRIA -->
      <section class="topics-main" style="--h: <%= selected.hue %>">

        <form method="POST" action="/conteudos/topicos" class="card add-bar" autocomplete="off">
          <input type="hidden" name="subject_id" value="<%= selected.id %>">
          <input type="text" name="nome" maxlength="120" required autofocus
                 placeholder="Novo tópico de <%= selected.nome %> (ex: Funções, Genética…) e Enter">
          <button type="submit" class="btn-primary">＋ Adicionar</button>
        </form>

        <% if (topics.length === 0) { %>
          <div class="empty-state">
            <div class="empty-icon">📑</div>
            <h3>Nenhum tópico em <%= selected.nome %></h3>
            <p>Adicione acima. Se não escolher um tópico ao registrar, o estudo vai para "Geral".</p>
          </div>
        <% } else { %>
          <div class="list-table">
            <% topics.forEach(t => { %>
              <div class="list-row">
                <div class="list-cell">
                  <span class="subj-dot"></span>
                  <span><%= t.nome %></span>
                  <% if (t.nome.trim().toLowerCase() === "geral") { %><span class="badge">padrão</span><% } %>
                </div>
                <div class="list-cell cell-actions">
                  <a href="/conteudos/topicos/<%= t.id %>/editar" class="btn btn-sm">✏️ Editar</a>
                  <form method="POST" action="/conteudos/topicos/<%= t.id %>/excluir" class="inline-form"
                        onsubmit="return confirm('Excluir este tópico?')">
                    <button type="submit" class="btn-danger btn-sm">🗑</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>

    <% } %>

  </div>
</main>

</body>
</html>