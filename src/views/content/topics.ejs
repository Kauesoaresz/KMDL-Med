<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tópicos - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/content/topicos.css">
</head>

<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- Header -->
    <div class="page-header">
      <div>
        <h1>📑 Tópicos</h1>
        <p>Cadastre tópicos dentro de cada matéria</p>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
      <div class="tabs">
        <a class="tab" href="/conteudos/materias">Matérias</a>
        <a class="tab active" href="/conteudos/topicos">Tópicos</a>
        <a class="tab" href="/conteudos/assuntos">Assuntos</a>
      </div>
    </div>

    <!-- Alert Messages -->
    <% if (erro) { %>
      <div class="alert alert-error"><%= erro %></div>
    <% } %>
    
    <% if (ok) { %>
      <div class="alert alert-success"><%= ok %></div>
    <% } %>

    <!-- Form Card -->
    <div class="section">
      <div class="form-card">
        <h2 class="section-title">Novo Tópico</h2>
        <form method="POST" action="/conteudos/topicos?subject_id=<%= filtroSubjectId || '' %>" class="form-grid">
          <div class="form-group">
            <label for="subject_id">Matéria</label>
            <select name="subject_id" id="subject_id" required onchange="window.location.href='?subject_id=' + this.value">
              <option value="">Selecione a matéria</option>
              <% subjects.forEach(s => { %>
                <option value="<%= s.id %>" <%= String(filtroSubjectId) === String(s.id) ? "selected" : "" %>>
                  <%= s.nome %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="nome">Nome do tópico</label>
            <input 
              type="text" 
              id="nome" 
              name="nome" 
              placeholder="Ex: Funções, Cinemática, Genética..." 
              required 
              <%= !filtroSubjectId ? "disabled" : "" %>
            />
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" <%= !filtroSubjectId ? "disabled" : "" %>>
              + Adicionar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- List -->
    <div class="section">
      <h2 class="section-title">Tópicos Cadastrados</h2>
      
      <% if (!topics || topics.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📑</div>
          <h3>Nenhum tópico encontrado</h3>
          <p>Selecione uma matéria acima e adicione seus primeiros tópicos!</p>
        </div>
      <% } else { %>
        <div class="list-table">
          <% topics.forEach(t => { %>
            <div class="list-row">
              <div class="list-cell cell-subject">
                <span class="cell-badge"><%= t.subject?.nome || "-" %></span>
              </div>
              <div class="list-cell cell-name">
                <span class="cell-icon">📄</span>
                <span class="cell-text"><%= t.nome %></span>
              </div>
              <div class="list-cell cell-actions">
                <a href="/conteudos/topicos/<%= t.id %>/editar" class="btn-secondary">
                  Editar
                </a>
                <form method="POST" action="/conteudos/topicos/<%= t.id %>/excluir"
                      onsubmit="return confirm('Excluir tópico?');" class="inline-form">
                  <button type="submit" class="btn-danger">
                    Excluir
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</main>

</body>
</html>

