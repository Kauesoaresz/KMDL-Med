<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Matérias - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/components/theme.css">
  <link rel="stylesheet" href="/public/css/content/materias.css">
</head>

<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- Header -->
    <div class="page-header">
      <div>
        <h1>📚 Matérias</h1>
        <p>Cadastre suas matérias para organizar seus estudos</p>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
      <div class="tabs">
        <a class="tab active" href="/conteudos/materias">Matérias</a>
        <a class="tab" href="/conteudos/topicos">Tópicos</a>
      </div>
    </div>

    <!-- Alert Messages -->
    <% if (erro) { %>
      <div class="alert alert-error"><%= erro %></div>
    <% } %>
    
    <% if (ok) { %>
      <div class="alert alert-success"><%= ok %></div>
    <% } %>

    <!-- Form Card -->
    <div class="section">
      <div class="form-card">
        <h2 class="section-title">Nova Matéria</h2>
        <form method="POST" action="/conteudos/materias" class="form-row">
          <div class="form-group">
            <label for="nome">Nome da matéria</label>
            <input 
              type="text" 
              id="nome" 
              name="nome" 
              placeholder="Ex: Matemática, Biologia, Física..." 
              required 
            />
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">
              + Adicionar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- List -->
    <div class="section">
      <h2 class="section-title">Matérias Cadastradas</h2>
      
      <% if (!subjects || subjects.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📚</div>
          <h3>Nenhuma matéria cadastrada</h3>
          <p>Adicione suas primeiras matérias para organizar seus estudos!</p>
        </div>
      <% } else { %>
        <div class="list-table">
          <% subjects.forEach(s => { %>
            <div class="list-row">
              <div class="list-cell cell-name">
                <span class="cell-icon">📖</span>
                <span class="cell-text"><%= s.nome %></span>
              </div>
              <div class="list-cell cell-actions">
                <a href="/conteudos/materias/<%= s.id %>/editar" class="btn-secondary">
                  Editar
                </a>
                <form method="POST" action="/conteudos/materias/<%= s.id %>/excluir"
                      onsubmit="return confirm('Excluir matéria?');" class="inline-form">
                  <button type="submit" class="btn-danger">
                    Excluir
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</main>

</body>
</html>

