<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Matérias", css: ["conteudos"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📚 Conteúdos</h1>
        <p>Organize suas matérias e os tópicos de cada uma.</p>
      </div>
    </header>

    <div class="tabs">
      <a class="tab active" href="/conteudos/materias">Matérias <span class="badge"><%= subjects.length %></span></a>
      <a class="tab" href="/conteudos/topicos">Tópicos</a>
    </div>

    <% if (erro) { %><div class="alert alert-error"><%= erro %></div><% } %>
    <% if (ok) { %><div class="alert alert-success"><%= ok %></div><% } %>

    <form method="POST" action="/conteudos/materias" class="card add-bar" autocomplete="off">
      <input type="text" name="nome" maxlength="120" required autofocus
             placeholder="Nova matéria (ex: Matemática, Biologia…) e Enter">
      <button type="submit" class="btn-primary">＋ Adicionar</button>
    </form>

    <% if (subjects.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📚</div>
        <h3>Nenhuma matéria cadastrada</h3>
        <p>Adicione a primeira para começar a registrar seus estudos.</p>
      </div>
    <% } else { %>
      <div class="subj-grid">
        <% subjects.forEach(s => { %>
          <article class="card subj" style="--h: <%= s.hue %>">
            <div class="subj-top">
              <span class="subj-dot"></span>
              <h3 title="<%= s.nome %>"><%= s.nome %></h3>
            </div>

            <a href="/conteudos/topicos?subject_id=<%= s.id %>" class="subj-count">
              <strong class="num"><%= s.topicos %></strong>
              <span><%= s.topicos === 1 ? "tópico" : "tópicos" %> →</span>
            </a>

            <div class="subj-actions">
              <a href="/conteudos/materias/<%= s.id %>/editar" class="btn btn-sm">✏️ Editar</a>
              <form method="POST" action="/conteudos/materias/<%= s.id %>/excluir" class="inline-form"
                    onsubmit="return confirm('Excluir a matéria <%= s.nome.replace(/'/g, "\\'") %>?')">
                <button type="submit" class="btn-danger btn-sm">🗑</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>

  </div>
</main>

</body>
</html>