<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Editar matéria", css: ["conteudos"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "conteudos", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>✏️ Editar matéria</h1>
        <p>Renomear não afeta seus registros de estudo.</p>
      </div>
      <a href="/conteudos/materias" class="btn">← Voltar</a>
    </header>

    <% if (erro) { %><div class="alert alert-error"><%= erro %></div><% } %>

    <form method="POST" action="/conteudos/materias/<%= subject.id %>/editar" class="card edit-card stack" autocomplete="off">
      <div class="form-group">
        <label for="nome">Nome da matéria</label>
        <input type="text" id="nome" name="nome" maxlength="120" required autofocus value="<%= subject.nome %>">
      </div>
      <div class="row">
        <button type="submit" class="btn-primary">💾 Salvar</button>
        <a href="/conteudos/materias" class="btn">Cancelar</a>
      </div>
    </form>

  </div>
</main>

</body>
</html>