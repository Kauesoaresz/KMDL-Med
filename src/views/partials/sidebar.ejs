    <a href="/registrar" class="item <%= active === 'registrar' ? 'active' : '' %>">
      <span>✍️</span>
      <p>Registrar</p>
    </a>

    <a href="/revisoes" class="item <%= active === 'revisoes' ? 'active' : '' %>">
      <span>🔥</span>
      <p>Revisões</p>
    </a>

    <a href="/estatisticas" class="item <%= active === 'estatisticas' ? 'active' : '' %>">
      <span>📊</span>
      <p>Estatísticas</p>
    </a>

    <a href="/relatorio" class="item <%= active === 'relatorio' ? 'active' : '' %>">
      <span>📄</span>
      <p>Relatório PDF</p>
    </a>

    <a href="/calendario" class="item <%= active === 'calendario' ? 'active' : '' %>">
      <span>📅</span>
      <p>Calendário</p>
    </a>

    <a href="/simulados" class="item <%= active === 'simulados' ? 'active' : '' %>">
