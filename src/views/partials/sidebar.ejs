<!-- HAMBURGER MOBILE -->
<button class="hamburger" id="hamburger" aria-label="Abrir Menu">
  <span></span>
  <span></span>
  <span></span>
</button>

<!-- OVERLAY (FUNDO ESCURO) -->
<div class="overlay" id="overlay"></div>

<aside class="sidebar" id="sidebar">

  <!-- LOGO -->
  <div class="sidebar-brand">
    <a href="/dashboard">
      <img src="/public/img/Logo sistema.png" class="logo">
      <span>KMDL Med</span>
    </a>
  </div>

  <!-- MENU -->
  <nav class="sidebar-menu">

    <a href="/dashboard" class="item <%= active === 'dashboard' ? 'active' : '' %>">
      <span>🏠</span>
      <p>Dashboard</p>
    </a>

    <a href="/registrar" class="item <%= active === 'registrar' ? 'active' : '' %>">
      <span>✍️</span>
      <p>Registrar</p>
    </a>

    <a href="/revisoes" class="item <%= active === 'revisoes' ? 'active' : '' %>">
      <span>🔥</span>
      <p>Revisões</p>
    </a>

    <a href="/estatisticas" class="item <%= active === 'estatisticas' ? 'active' : '' %>">
      <span>📊</span>
      <p>Estatísticas</p>
    </a>

    <a href="/relatorio" class="item <%= active === 'relatorio' ? 'active' : '' %>">
      <span>📄</span>
      <p>Relatório PDF</p>
    </a>

    <a href="/calendario" class="item <%= active === 'calendario' ? 'active' : '' %>">
      <span>📅</span>
      <p>Calendário</p>
    </a>

    <a href="/simulados" class="item <%= active === 'simulados' ? 'active' : '' %>">
      <span>📘</span>
      <p>Simulados</p>
    </a>

    <a href="/provas" class="item <%= active === 'provas' ? 'active' : '' %>">
      <span>🎯</span>
      <p>Provas</p>
    </a>

    <a href="/conteudos" class="item <%= active === 'conteudos' ? 'active' : '' %>">
      <span>📚</span>
      <p>Conteúdos</p>
    </a>

    <a href="/conquistas" class="item <%= active === 'conquistas' ? 'active' : '' %>">
      <span>🏆</span>
      <p>Conquistas</p>
    </a>

  </nav>

  <!-- FOOTER -->
  <div class="sidebar-footer">

    <a href="/perfil" class="item profile">
      <img src="<%= userFoto || '/public/img/avatar-default.png' %>">
      <p><%= userNome || 'Usuário' %></p>
    </a>

    <a href="/logout" class="item logout">
      <span>🚪</span>
      <p>Sair</p>
    </a>

  </div>

</aside>

<script src="/public/js/app/sidebar.js"></script>
