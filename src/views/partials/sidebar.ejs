<aside class="sidebar" aria-label="Menu lateral">

  <div class="sidebar__brand">
    <a class="sidebar__brandLink" href="/dashboard" title="KMed">
      <div class="sidebar__logo">
  <img 
    src="/public/img/Logo sistema.png" 
    alt="KMed"
    class="sidebar__logoImg"
  >
</div>

      <div class="sidebar__brandText">KMDL Med</div>
    </a>
  </div>

  <nav class="sidebar__nav">

    <!-- DASHBOARD -->
    <a class="sidebar__item <%= (active === 'dashboard') ? 'is-active' : '' %>"
       href="/dashboard" title="Dashboard">
      <span class="sidebar__icon">🏠</span>
      <span class="sidebar__label">Dashboard</span>
      <span class="sidebar__tooltip">Dashboard</span>
    </a>

    <!-- REGISTRAR O DIA -->
    <a class="sidebar__item <%= (active === 'registrar') ? 'is-active' : '' %>"
       href="/registrar" title="Registrar o Dia">
      <span class="sidebar__icon">✍️</span>
      <span class="sidebar__label">Registrar o Dia</span>
      <span class="sidebar__tooltip">Registrar o Dia</span>
    </a>

    <!-- REVISÕES -->
<a class="sidebar__item <%= (active === 'revisoes') ? 'is-active' : '' %>"
   href="/revisoes" title="Revisões">
  <span class="sidebar__icon">🔥</span>
  <span class="sidebar__label">Revisões</span>
  <span class="sidebar__tooltip">Revisões</span>
</a>


    <!-- ESTATÍSTICAS -->
    <a class="sidebar__item <%= (active === 'estatisticas') ? 'is-active' : '' %>"
       href="/estatisticas" title="Estatísticas">
      <span class="sidebar__icon">📊</span>
      <span class="sidebar__label">Estatísticas</span>
      <span class="sidebar__tooltip">Estatísticas</span>
    </a>

    <!-- CALENDÁRIO -->
    <a class="sidebar__item <%= (active === 'calendario') ? 'is-active' : '' %>"
       href="/calendario" title="Calendário">
      <span class="sidebar__icon">📅</span>
      <span class="sidebar__label">Calendário</span>
      <span class="sidebar__tooltip">Calendário</span>
    </a>

    <!-- SIMULADOS -->
<a class="sidebar__item <%= (active === 'simulados') ? 'is-active' : '' %>"
   href="/simulados" title="Simulados">
  <span class="sidebar__icon">📘</span>
  <span class="sidebar__label">Simulados</span>
  <span class="sidebar__tooltip">Simulados</span>
</a>

<!-- PROVAS -->
<a class="sidebar__item <%= (active === 'provas') ? 'is-active' : '' %>"
   href="/provas" title="Provas">
  <span class="sidebar__icon">🎯</span>
  <span class="sidebar__label">Provas</span>
  <span class="sidebar__tooltip">Provas</span>
</a>



    <!-- MATÉRIAS / TÓPICOS (ÚLTIMO) -->
    <a class="sidebar__item <%= (active === 'conteudos') ? 'is-active' : '' %>"
       href="/conteudos" title="Matérias / Tópicos">
      <span class="sidebar__icon">📚</span>
      <span class="sidebar__label">Matérias / Tópicos</span>
      <span class="sidebar__tooltip">Matérias / Tópicos</span>
    </a>

  </nav>

  <div class="sidebar__footer">

    <!-- PERFIL -->
    <a class="sidebar__item sidebar__profile <%= (active === 'perfil') ? 'is-active' : '' %>"
       href="/perfil" title="Meu Perfil">

      <span class="sidebar__icon sidebar__avatar">
        <img 
          src="<%= userFoto || '/public/img/avatar-default.png' %>" 
          alt="Foto do usuário"
        >
      </span>

      <span class="sidebar__label"><%= userNome || 'Usuário' %></span>
      <span class="sidebar__tooltip">Meu perfil</span>
    </a>

    <!-- LOGOUT -->
    <a class="sidebar__item sidebar__logout" href="/logout" title="Sair">
      <span class="sidebar__icon">🚪</span>
      <span class="sidebar__label">Sair</span>
      <span class="sidebar__tooltip">Sair</span>
    </a>

  </div>

</aside>
