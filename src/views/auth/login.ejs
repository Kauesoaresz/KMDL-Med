<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Entrar", css: ["auth"] }) %>
</head>
<body class="auth">

<aside class="auth-image" id="auth-bg"></aside>

<main class="auth-side">
  <div class="auth-card">

    <div class="auth-head">
      <img src="/public/img/Logo sistema.png" alt="" class="brand-logo">
      <h1 id="greet">Bem-vindo de volta</h1>
      <p class="muted">KMDL Med</p>
    </div>

    <% if (erro) { %><div class="alert alert-error"><%= erro %></div><% } %>

    <form method="POST" action="/login" class="auth-form" autocomplete="on">
      <div class="field">
        <label for="email">E-mail</label>
        <div class="field-box">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <input id="email" name="email" type="email" required autofocus placeholder="voce@email.com" autocomplete="email">
        </div>
      </div>

      <div class="field">
        <label for="senha">Senha</label>
        <div class="field-box">
          <svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <input id="senha" name="senha" type="password" required placeholder="••••••••" autocomplete="current-password">
          <button type="button" class="eye" data-toggle="senha" aria-label="Mostrar senha">
            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <button type="submit" class="auth-btn"><span>Entrar</span></button>
    </form>

    <p class="auth-link">Não tem conta? <a href="/cadastrar">Criar agora</a></p>
  </div>
</main>

<script src="/public/js/app/auth.js"></script>
</body>
</html>