<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>KMed | Simulados</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- CSS GLOBAL -->
  <link rel="stylesheet" href="/public/css/components/sidebar.css">

  <!-- CSS DA TELA -->
  <link rel="stylesheet" href="/public/css/app/simulados.css">
</head>

<body class="page-bg">

  <!-- 🔑 INCLUDE CORRETO -->
  <%- include("../partials/sidebar", {
    active: "simulados",
    userNome,
    userFoto
  }) %>

  <main class="with-sidebar">
    <section class="page simulados-page">

      <header class="kmed-header">
        <h1>Simulados</h1>
        <p>Cadastre, continue ou acompanhe seus simulados do ENEM.</p>
      </header>

      <div class="simulados-hub">

        <!-- CARD 1 -->
        <a href="/simulados/novo" class="sim-card primary">
          <div class="sim-card-icon">📝</div>
          <div class="sim-card-content">
            <h2>Cadastrar / Continuar Simulado</h2>
            <p>
              Inicie um novo simulado ou continue um que ainda não foi finalizado.
            </p>
          </div>
        </a>

        <!-- CARD 2 -->
        <a href="/simulados/lista" class="sim-card">
          <div class="sim-card-icon">📊</div>
          <div class="sim-card-content">
            <h2>Meus Simulados</h2>
            <p>
              Veja todos os simulados realizados, em andamento ou concluídos.
            </p>
          </div>
        </a>

      </div>

    </section>
  </main>

</body>
</html>
