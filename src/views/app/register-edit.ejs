<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMDL Med | Editar Dia</title>

  <!-- Prevent flash of wrong theme -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('kmed-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (!savedTheme && !prefersDark || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/theme.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/register-edit.css" />
</head>

<body class="page-bg">

<%- include("../partials/sidebar", { active: "registrar", userNome }) %>

<main class="with-sidebar">
  <div class="page">
    <h1>Editar dia</h1>
    <a href="/registrar" class="btn-back">← Voltar</a>

    <form method="POST" action="/registrar/editar/<%= data %>" id="form-dia">

      <label>Data</label>
      <input type="date" name="data" value="<%= data %>" required>

      <div id="blocos"></div>

      <button type="button" class="btn-add" onclick="addBloco()">+ Adicionar bloco</button>

      <br><br>
      <button type="submit" class="btn-primary">Salvar alterações</button>
    </form>
  </div>
</main>

<script>
const subjects = <%- JSON.stringify(subjects) %>;
const entries = <%- JSON.stringify(entries) %>;
let blocoIndex = 0;

function getHorasEMinutos(minutos) {
  const m = minutos || 0;
  return { horas: Math.floor(m / 60), minutos: m % 60 };
}

function addBloco(entry = null) {
  const idx = blocoIndex++;
  const tempo = entry ? getHorasEMinutos(entry.minutos) : { horas: 0, minutos: 0 };

  const bloco = document.createElement("div");
  bloco.className = "bloco";

  bloco.innerHTML = `
    <button type="button" class="btn-remove" onclick="this.closest('.bloco').remove()">🗑</button>

    <select name="blocos[${idx}][subject_id]" class="subject-select" required>
      <option value="">Selecione a disciplina</option>
      ${subjects.map(s => `
        <option value="${s.id}" ${entry && entry.subject_id === s.id ? "selected" : ""}>
          ${s.nome}
        </option>
      `).join("")}
    </select>

    <select name="blocos[${idx}][topic_id]" class="topic-select" disabled required>
      <option value="">Selecione o tópico</option>
    </select>

    <div class="linha-numeros">
      <div class="input-group time-input">
        <input type="number" name="blocos[${idx}][horas]" placeholder="Horas" min="0" value="${tempo.horas}" required>
        <span class="time-separator">:</span>
        <input type="number" name="blocos[${idx}][minutos]" placeholder="Min" min="0" max="59" value="${tempo.minutos}" required>
      </div>
      <input type="number" name="blocos[${idx}][questoes]" placeholder="Questões" value="${entry?.questoes || ''}">
      <input type="number" name="blocos[${idx}][acertos]" placeholder="Acertos" value="${entry?.acertos || ''}">

      <select name="blocos[${idx}][dificuldade]">
        <option value="MUITO_FACIL" ${entry?.dificuldade === "MUITO_FACIL" ? "selected" : ""}>Muito Fácil</option>
        <option value="FACIL" ${entry?.dificuldade === "FACIL" ? "selected" : ""}>Fácil</option>
        <option value="MEDIA" ${!entry || entry?.dificuldade === "MEDIA" ? "selected" : ""}>Média</option>
        <option value="DIFICIL" ${entry?.dificuldade === "DIFICIL" ? "selected" : ""}>Difícil</option>
        <option value="MUITO_DIFICIL" ${entry?.dificuldade === "MUITO_DIFICIL" ? "selected" : ""}>Muito Difícil</option>
      </select>
    </div>
  `;

  const subjectSelect = bloco.querySelector(".subject-select");
  const topicSelect = bloco.querySelector(".topic-select");

  // DISCIPLINA → TÓPICOS
  subjectSelect.addEventListener("change", async () => {
    const subjectId = subjectSelect.value;

    topicSelect.innerHTML = `<option>Carregando...</option>`;
    topicSelect.disabled = true;

    if (!subjectId) {
      topicSelect.innerHTML = `<option value="">Selecione o tópico</option>`;
      return;
    }

    const res = await fetch(`/api/subjects/${subjectId}/topics`);
    const topics = await res.json();

    topicSelect.innerHTML = `<option value="">Selecione o tópico</option>`;
    topics.forEach(t => {
      topicSelect.innerHTML += `<option value="${t.id}">${t.nome}</option>`;
    });

    topicSelect.disabled = false;

    // Só pré-seleciona o tópico salvo se a matéria ainda for a original
    if (entry?.topic_id && Number(subjectId) === entry.subject_id) {
      topicSelect.value = entry.topic_id;
    }
  });

  document.getElementById("blocos").appendChild(bloco);

  if (entry?.subject_id) {
    subjectSelect.dispatchEvent(new Event("change"));
  }
}

entries.forEach(e => addBloco(e));
</script>

</body>
</html>
