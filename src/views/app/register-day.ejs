<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMDL Med | Registrar Novo Dia</title>

  <!-- Prevent flash of wrong theme -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('kmed-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (!savedTheme && !prefersDark || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/theme.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/register-day.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "registrar", userNome }) %>

<main class="with-sidebar">
  <div class="page">
    <h1>Registrar novo dia</h1>
    <a href="/registrar" class="btn-back">← Voltar</a>

    <form method="POST" action="/registrar/novo" id="form-dia">

      <label>Data</label>
      <input type="text" name="data" id="data-input" value="<%= hoje %>">

      <div id="blocos"></div>

      <button type="button" class="btn-add" onclick="addBloco()">+ Adicionar bloco</button>

      <br><br>
      <button type="submit" class="btn-primary">Salvar dia</button>
    </form>
  </div>
</main>


<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/pt.js"></script>
<script>
  flatpickr("#data-input", {
    inline: true,
    locale: "pt",
    dateFormat: "Y-m-d",
    defaultDate: "<%= hoje %>"
  });
</script>

<script>
const subjects = <%- JSON.stringify(subjects) %>;
let blocoIndex = 0;

function addBloco() {
  const idx = blocoIndex++;

  const bloco = document.createElement("div");
  bloco.className = "bloco";

  bloco.innerHTML = `
    <button type="button" class="btn-remove" onclick="this.closest('.bloco').remove()">🗑</button>

    <select name="blocos[${idx}][subject_id]" class="subject-select" required>
      <option value="">Selecione a disciplina</option>
      ${subjects.map(s => `<option value="${s.id}">${s.nome}</option>`).join("")}
    </select>

    <select name="blocos[${idx}][topic_id]" class="topic-select" disabled>
      <option value="">Tópico (opcional)</option>
    </select>

    <div class="linha-numeros">
      <div class="input-group time-input">
        <input type="number" name="blocos[${idx}][horas]" placeholder="Horas" min="0" value="0" required>
        <span class="time-separator">:</span>
        <input type="number" name="blocos[${idx}][minutos]" placeholder="Min" min="0" max="59" value="0" required>
      </div>
      <input type="number" name="blocos[${idx}][questoes]" placeholder="Questões">
      <input type="number" name="blocos[${idx}][acertos]" placeholder="Acertos">

    </div>
  `;

  const subjectSelect = bloco.querySelector(".subject-select");
  const topicSelect = bloco.querySelector(".topic-select");

  // DISCIPLINA → TÓPICOS
  subjectSelect.addEventListener("change", async () => {
    const subjectId = subjectSelect.value;

    topicSelect.innerHTML = `<option>Carregando...</option>`;
    topicSelect.disabled = true;

    if (!subjectId) {
      topicSelect.innerHTML = `<option value="">Tópico (opcional)</option>`;
      return;
    }

    const res = await fetch(`/api/subjects/${subjectId}/topics`);
    const topics = await res.json();

    topicSelect.innerHTML = `<option value="">Tópico (opcional)</option>`;
    topics.forEach(t => {
      topicSelect.innerHTML += `<option value="${t.id}">${t.nome}</option>`;
    });

    topicSelect.disabled = false;
  });

  document.getElementById("blocos").appendChild(bloco);
}

addBloco();
</script>

</body>
</html>
