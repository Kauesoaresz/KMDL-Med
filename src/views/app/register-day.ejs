<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: editing ? "Editar dia" : "Registrar estudo", css: ["registrar"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "registrar", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1><%= editing ? "Editar dia" : "Registrar estudo" %></h1>
        <p id="date-label" class="date-label"></p>
      </div>
      <a href="/registrar/lista" class="btn">📚 Dias registrados</a>
    </header>

    <form id="form-dia" method="POST" autocomplete="off"
          action="<%= editing ? '/registrar/editar/' + data : '/registrar/novo' %>">
      <input type="hidden" name="data" id="f-data" value="<%= data %>">
      <div id="hidden"></div>

      <div class="reg-layout">

        <!-- ============ LATERAL ============ -->
        <aside class="reg-side">

          <% if (!editing) { %>
          <div class="card cal-card">
            <div class="cal-head">
              <button type="button" class="cal-nav" id="cal-prev" aria-label="Mês anterior">‹</button>
              <strong id="cal-title"></strong>
              <button type="button" class="cal-nav" id="cal-next" aria-label="Próximo mês">›</button>
            </div>
            <div class="cal-week"><span>D</span><span>S</span><span>T</span><span>Q</span><span>Q</span><span>S</span><span>S</span></div>
            <div class="cal-days" id="cal-days"></div>
            <div class="cal-quick">
              <button type="button" class="btn btn-sm" id="q-hoje">Hoje</button>
              <button type="button" class="btn btn-sm" id="q-ontem">Ontem</button>
            </div>
            <div class="alert alert-warn dup" id="dup" hidden>
              Este dia já tem registro e será <strong>substituído</strong>.
              <a href="#" id="dup-link">Editar este dia →</a>
            </div>
          </div>
          <% } %>

          <div class="card save-card">
            <div class="sum-grid">
              <div><small>Tempo</small><strong class="num" id="s-tempo">0min</strong></div>
              <div><small>Questões</small><strong class="num" id="s-q">0</strong></div>
              <div><small>Acertos</small><strong class="num" id="s-a">0</strong></div>
              <div><small>Aproveit.</small><strong class="num" id="s-pct">—</strong></div>
            </div>
            <div class="alert alert-error" id="f-err" hidden></div>
            <button type="submit" class="btn-primary btn-save" id="btn-save">💾 Salvar dia</button>
            <small class="faint center">Ctrl + Enter também salva</small>
          </div>
        </aside>

        <!-- ============ PRINCIPAL ============ -->
        <section class="reg-main">

          <div class="card composer">
            <div class="band">
              <div class="band-label">Matéria</div>
              <div class="chip-grid" id="subj-chips"></div>
            </div>

            <div class="band">
              <div class="band-label">Tópico <span class="faint">(opcional)</span></div>
              <div class="chip-grid topics-box" id="topic-chips"></div>
            </div>

            <div class="band band-fields off" id="comp-fields">
              <div class="field-block">
                <div class="band-label">Tempo</div>
                <div class="time-display">
                  <input type="number" id="t-h" min="0" value="0" aria-label="Horas"><span>h</span>
                  <input type="number" id="t-m" min="0" max="59" value="0" aria-label="Minutos"><span>min</span>
                </div>
                <div class="quick">
                  <button type="button" class="btn btn-sm" data-add="15">+15</button>
                  <button type="button" class="btn btn-sm" data-add="30">+30</button>
                  <button type="button" class="btn btn-sm" data-add="60">+1h</button>
                  <button type="button" class="btn btn-sm" data-add="120">+2h</button>
                  <button type="button" class="btn-ghost btn-sm" id="t-reset">Zerar</button>
                </div>
              </div>

              <div class="field-block">
                <div class="band-label">Questões <span class="faint">(opcional)</span></div>
                <div class="qa-row">
                  <input type="number" id="c-q" min="0" placeholder="Feitas" aria-label="Questões feitas">
                  <input type="number" id="c-a" min="0" placeholder="Acertos" aria-label="Acertos">
                  <span class="badge" id="c-pct">—</span>
                </div>
                <div class="alert alert-error" id="c-err" hidden></div>
              </div>

              <button type="button" class="btn-primary btn-add" id="c-add">＋ Adicionar<br><small>Enter</small></button>
            </div>
          </div>

          <div class="card blocks-card">
            <div class="section-header">
              <h2 class="card-heading">Blocos do dia</h2>
              <span class="badge" id="count">0</span>
            </div>
            <div id="blocks" class="blocks"></div>
          </div>

        </section>
      </div>
    </form>

  </div>
</main>

<script>
  window.REG = <%- JSON.stringify({
    subjects, entries, registered: diasRegistrados, hoje, data, editing
  }).replace(/</g, "\\u003c") %>;
</script>
<script src="/public/js/app/registrar.js"></script>

</body>
</html>