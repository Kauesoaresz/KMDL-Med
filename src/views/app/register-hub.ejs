<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMed | Registrar Dia</title>

  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/register-hub.css" />
</head>

<body class="page-bg">

  <%- include("../partials/sidebar", { active: "registrar", userNome }) %>

  <main class="with-sidebar">
    <div class="page register-layout">

      <!-- ESQUERDA -->
      <section class="register-actions">
        <h1>Registrar Dia</h1>

        <a href="/registrar/novo" class="action-link">
          <div class="card new">
            <h2>Registrar novo dia</h2>
            <p>Cadastrar um novo dia de estudos</p>
          </div>
        </a>

        <a href="/registrar/lista" class="action-link">
          <div class="card list">
            <h2>Dias já registrados</h2>
            <p>Ver, editar ou excluir dias cadastrados</p>
          </div>
        </a>
      </section>

      <!-- DIREITA -->
      <section class="register-visual">
  <div class="image-frame">

    <!-- SETA ESQUERDA -->
    <button class="slider-arrow left" id="arrowLeft">‹</button>

    <!-- SLIDER -->
    <div class="image-slider" id="imageSlider"></div>

    <!-- SETA DIREITA -->
    <button class="slider-arrow right" id="arrowRight">›</button>

  </div>
</section>



    </div>
  </main>

  <script>
  const images = [
    "/public/img/estudos1.jpg",
    "/public/img/estudos2.png",
    "/public/img/estudos3.png",
    "/public/img/estudos4.jpg",
    "/public/img/estudos5.jpg",
    "/public/img/estudos6.jpg",
    "/public/img/estudos8.jpg",
    "/public/img/estudos9.jpg",
    "/public/img/estudos10.jpg",
    "/public/img/estudos11.png",
    "/public/img/estudos12.jpg",
    "/public/img/estudos13.jpg",
    "/public/img/estudos14.jpg",
    "/public/img/estudos15.jpg",
    "/public/img/medicina1.jpg",
    "/public/img/medicina2.jpg",
    "/public/img/medicina3.jpg",
    "/public/img/medicina4.jpg",
    "/public/img/medicina5.jpg"
  ];

  const slider = document.getElementById("imageSlider");
  let index = 0;

  /* =========================
     CRIA IMAGENS
  ========================= */
  images.forEach(src => {
    const img = document.createElement("img");
    img.src = src;
    slider.appendChild(img);
  });

  /* =========================
     MOVIMENTO
  ========================= */
  function updateSlider() {
    slider.style.transform = `translateX(-${index * 100}%)`;
  }

  /* =========================
     AUTOPLAY
  ========================= */
  let autoPlay = setInterval(() => {
    index = (index + 1) % images.length;
    updateSlider();
  }, 6000);

  function resetAutoplay() {
    clearInterval(autoPlay);
    autoPlay = setInterval(() => {
      index = (index + 1) % images.length;
      updateSlider();
    }, 6000);
  }

  /* =========================
     DRAG / SWIPE
  ========================= */
  let startX = 0;
  let isDragging = false;

  slider.addEventListener("mousedown", e => {
    isDragging = true;
    startX = e.clientX;
    slider.style.transition = "none";
    clearInterval(autoPlay);
  });

  slider.addEventListener("mousemove", e => {
    if (!isDragging) return;
    const delta = e.clientX - startX;
    slider.style.transform = `translateX(${ -index * window.innerWidth + delta }px)`;
  });

  slider.addEventListener("mouseup", e => {
    if (!isDragging) return;
    isDragging = false;
    slider.style.transition = "transform 0.6s ease";

    const delta = e.clientX - startX;
    if (delta < -80 && index < images.length - 1) index++;
    if (delta > 80 && index > 0) index--;

    updateSlider();
    resetAutoplay();
  });

  slider.addEventListener("mouseleave", () => {
    if (isDragging) {
      isDragging = false;
      slider.style.transition = "transform 0.6s ease";
      updateSlider();
      resetAutoplay();
    }
  });

  /* =========================
     TOUCH (MOBILE)
  ========================= */
  slider.addEventListener("touchstart", e => {
    startX = e.touches[0].clientX;
    clearInterval(autoPlay);
  });

  slider.addEventListener("touchend", e => {
    const endX = e.changedTouches[0].clientX;
    const delta = endX - startX;

    if (delta < -60 && index < images.length - 1) index++;
    if (delta > 60 && index > 0) index--;

    updateSlider();
    resetAutoplay();
  });
</script>

<script>
  const arrowLeft = document.getElementById("arrowLeft");
  const arrowRight = document.getElementById("arrowRight");

  arrowLeft.addEventListener("click", () => {
    index = index > 0 ? index - 1 : images.length - 1;
    updateSlider();
    resetAutoplay();
  });

  arrowRight.addEventListener("click", () => {
    index = (index + 1) % images.length;
    updateSlider();
    resetAutoplay();
  });
</script>


</body>
</html>
