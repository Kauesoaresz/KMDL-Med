<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Dashboard", css: ["dashboard"] }) %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "dashboard", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- TOPO -->
    <header class="page-header">
      <div>
        <h1>Olá, <%= userNome %> 👋</h1>
        <p>Seu objetivo está cada dia mais próximo.</p>
      </div>

      <div class="streak">
        <span class="streak-icon">🔥</span>
        <div>
          <strong class="num"><%= streak %></strong>
          <small><%= streak === 1 ? "dia seguido" : "dias seguidos" %></small>
        </div>
      </div>
    </header>

    <!-- AÇÕES + FILTRO -->
    <div class="toolbar">
      <div class="row">
        <a href="/registrar/novo" class="btn-primary">📝 Registrar estudo</a>
        <a href="/simulados/lista" class="btn">📋 Novo simulado</a>
      </div>

      <div class="dashboard-filter">
        <% periodos.forEach(p => { %>
          <a href="/dashboard?periodo=<%= p.key %>"
             class="filter-btn <%= periodo === p.key ? 'active' : '' %>"><%= p.label %></a>
        <% }) %>
      </div>
    </div>

    <!-- KPIs -->
    <section class="grid-4">
      <div class="card kpi">
        <h3>Horas</h3>
        <p class="value"><%= formatHours(stats.horas) %></p>
        <span class="label"><%= stats.dias %> <%= stats.dias === 1 ? "dia estudado" : "dias estudados" %></span>
      </div>

      <div class="card kpi">
        <h3>Questões</h3>
        <p class="value"><%= stats.questoes %></p>
        <span class="label">Resolvidas</span>
      </div>

      <div class="card kpi">
        <h3>Acertos</h3>
        <p class="value"><%= stats.acertos %></p>
        <span class="label"><%= stats.erros %> erros</span>
      </div>

      <div class="card kpi">
        <h3>Taxa de acerto</h3>
        <p class="value"><%= stats.taxa %>%</p>
        <div class="progress mt"><span style="width: <%= stats.taxa %>%"></span></div>
      </div>
    </section>

    <!-- PIZZAS -->
    <section class="grid-2">

      <div class="card">
        <h2 class="card-heading">⏱ Horas por matéria</h2>
        <% if (pizzaHoras.itens.length === 0) { %>
          <p class="muted empty-note">Nenhum estudo neste período.</p>
        <% } else { %>
          <div class="pie-wrap">
            <div class="pie-canvas"><canvas id="pizzaHoras"></canvas></div>
            <ul class="legend">
              <% pizzaHoras.itens.forEach(m => { %>
                <li>
                  <i style="background: hsl(<%= m.hue %> var(--chart-s) var(--chart-l))"></i>
                  <span class="legend-name"><%= m.nome %></span>
                  <span class="legend-val num"><%= formatHours(m.valor) %> · <%= m.share %>%</span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>

      <div class="card">
        <h2 class="card-heading">📝 Questões por matéria</h2>
        <% if (pizzaQuestoes.itens.length === 0) { %>
          <p class="muted empty-note">Nenhuma questão neste período.</p>
        <% } else { %>
          <div class="pie-wrap">
            <div class="pie-canvas"><canvas id="pizzaQuestoes"></canvas></div>
            <ul class="legend">
              <% pizzaQuestoes.itens.forEach(m => { %>
                <li>
                  <i style="background: hsl(<%= m.hue %> var(--chart-s) var(--chart-l))"></i>
                  <span class="legend-name"><%= m.nome %></span>
                  <span class="legend-val num"><%= m.valor %> · <%= m.share %>%</span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>

    </section>

    <!-- METAS -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">🎯 Minhas metas</h2>
        <a href="/metas" class="btn-ghost btn-sm">Gerenciar →</a>
      </div>

      <% if (metas.length > 0) { %>
        <div class="grid-2">
          <% metas.forEach(meta => { %>
            <div class="card meta">
              <div class="meta-top">
                <strong><%= meta.nome %></strong>
                <span class="badge">⏰ <%= meta.data_limite_formatada %></span>
              </div>

              <div class="meta-item">
                <div class="meta-line">
                  <span>Horas</span>
                  <span class="num"><%= formatHours(meta.horas_concluidas) %> / <%= meta.meta_horas %>h</span>
                </div>
                <div class="progress"><span style="width: <%= meta.progresso_horas %>%"></span></div>
              </div>

              <% if (meta.progresso_questoes !== null) { %>
                <div class="meta-item">
                  <div class="meta-line">
                    <span>Questões</span>
                    <span class="num"><%= meta.questoes_concluidas %> / <%= meta.meta_questoes %></span>
                  </div>
                  <div class="progress"><span style="width: <%= meta.progresso_questoes %>%"></span></div>
                </div>
              <% } %>

              <span class="meta-total"><%= meta.progresso_total %>% completo</span>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">🎯</div>
          <h3>Nenhuma meta principal</h3>
          <p>Crie uma em <a href="/metas">Metas</a> e marque como principal para ela aparecer aqui.</p>
        </div>
      <% } %>
    </section>

  </div>
</main>

<script>
  const DATA = <%- chartJson %>;

  function fmtHoras(h) {
    const hi = Math.floor(h);
    return hi + "h " + Math.round((h - hi) * 60) + "min";
  }

  const charts = [];

  function corHue(h) {
    const cs = getComputedStyle(document.documentElement);
    return "hsl(" + h + " " + cs.getPropertyValue("--chart-s").trim() + " " + cs.getPropertyValue("--chart-l").trim() + ")";
  }

  function pizza(id, itens, fmt) {
    const el = document.getElementById(id);
    if (!el || !itens.length) return;

    const surface = getComputedStyle(document.documentElement).getPropertyValue("--surface").trim();

    charts.push(new Chart(el, {
      type: "pie",
      data: {
        labels: itens.map(i => i.nome),
        datasets: [{
          data: itens.map(i => i.valor),
          backgroundColor: itens.map(i => corHue(i.hue)),
          borderColor: surface,
          borderWidth: 2,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => " " + c.label + ": " + fmt(c.raw) } }
        }
      }
    }));
  }

  function desenhar() {
    charts.splice(0).forEach(c => c.destroy());
    pizza("pizzaHoras", DATA.horas, fmtHoras);
    pizza("pizzaQuestoes", DATA.questoes, v => v + " questões");
  }

  desenhar();
  document.addEventListener("themechange", desenhar); // refaz as cores ao trocar o tema
</script>

</body>
</html>