<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KMed | Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/dashboard.css" />

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="page-bg">

  <%- include("../partials/sidebar", { active: "dashboard", userNome, userFoto }) %>

  <main class="with-sidebar">
    <div class="page">

      <!-- =========================
           BOAS-VINDAS + STREAK
      ========================== -->
      <section class="welcome-card">
        <div class="welcome-text">
          <h1>Olá, <%= userNome %>! 👋</h1>
          <p>Seu objetivo está cada dia mais próximo.</p>
        </div>

        <div class="streak-box">
          <span class="streak-fire">🔥</span>
          <strong><%= streakAtual || 0 %> dias seguidos</strong>

          <div class="streak-week">
            <% (streakSemana || []).forEach(d => { %>
              <span class="day <%= d ? 'on' : '' %>"></span>
            <% }) %>
          </div>
        </div>
      </section>

      <!-- =========================
           QUICK ACTIONS
      ========================== -->
      <section class="quick-actions">
        <a href="/registrar/novo" class="quick-action-btn">
          <span class="icon">📝</span>
          <span class="label">Registrar Estudo</span>
        </a>
        <a href="/simulados/lista" class="quick-action-btn">
          <span class="icon">📋</span>
          <span class="label">Novo Simulado</span>
        </a>
      </section>

      <!-- =========================
           FILTRO GLOBAL
      ========================== -->
      <section class="dashboard-filter">
        <% const filtros = ["hoje", "semana", "mes", "total"]; %>
        <% filtros.forEach(f => { %>
          <a
            href="/dashboard?periodo=<%= f %>"
            class="filter-btn <%= periodo === f ? 'active' : '' %>"
          >
            <%= f.charAt(0).toUpperCase() + f.slice(1) %>
          </a>
        <% }) %>
      </section>

      <!-- =========================
           CARDS RESUMO + META
      ========================== -->
      <section class="dashboard-cards">

        <div class="card kpi">
          <h3>Horas</h3>
          <p class="value"><span class="counter" data-target="<%= stats?.horas || 0 %>">0</span>h</p>
          <span class="label">Estudadas</span>
          <% if (stats?.horasDiff !== undefined) { %>
            <span class="extra <%= stats.horasDiff >= 0 ? 'up' : 'down' %>">
              <%= stats.horasDiff >= 0 ? '↑' : '↓' %>
              <%= Math.abs(stats.horasDiff) %>h
            </span>
          <% } %>
        </div>

        <div class="card kpi">
          <h3>Questões</h3>
          <p class="value counter" data-target="<%= stats?.questoes || 0 %>">0</p>
          <span class="label">Resolvidas</span>
        </div>

        <div class="card kpi">
          <h3>Aproveitamento</h3>
          <p class="value"><%= stats?.taxa || 0 %>%</p>
          <span class="label">Acertos</span>
        </div>

        <div class="card kpi">
          <h3>Constância</h3>
          <p class="value"><%= stats?.dias || 0 %></p>
          <span class="label">Dias estudados</span>
        </div>

        <!-- Meta Diária -->
        <div class="card meta-card">
          <div class="meta-header">
            <h3>🎯 Meta Diária</h3>
            <span class="meta-percent"><%= metaPercentual %>%</span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar">
              <div class="progress-fill" style="width: <%= metaPercentual %>%"></div>
            </div>
          </div>
          <p class="meta-text"><%= horasHoje %>h de <%= metaDiaria %>h hoje</p>
        </div>

      </section>

      <!-- =========================
           REVISÕES PENDENTES
      ========================== -->
      <% if (revisoesPendentes && revisoesPendentes.length > 0) { %>
        <section class="dashboard-section revisoes-section">
          <div class="section-header">
            <h2>🔄 Revisões Pendentes</h2>
            <a href="/revisoes" class="section-link">Ver todas →</a>
          </div>
          <div class="revisoes-grid">
            <% revisoesPendentes.forEach(r => { %>
              <div class="revisao-card">
                <div class="revisao-info">
                  <span class="revisao-materia"><%= r.subject ? r.subject.nome : 'Matéria' %></span>
                  <span class="revisao-topico"><%= r.nome %></span>
                </div>
                <a href="/revisoes" class="revisao-btn">Revisar</a>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- =========================
           ROW: CALENDÁRIO + SIMULADOS
      ========================== -->
      <section class="dashboard-row">

        <!-- Mini Calendário -->
        <div class="dashboard-card mini-calendar-card">
          <h3>📅 Este Mês</h3>
          <div class="mini-calendar">
            <% 
            const mesNomes = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
            const mesAtualNum = new Date().getMonth();
            %>
            <div class="calendar-month"><%= mesNomes[mesAtualNum] %></div>
            <div class="calendar-grid">
              <% diasCalendario.forEach(d => { 
                const horaClasse = 'h' + Math.min(Math.floor(d.horas), 12);
              %>
                <div 
                  class="calendar-day <%= horaClasse %>"
                  title="<%= d.horas %>h"
                >
                  <%= d.dia %>
                </div>
              <% }) %>
            </div>
            <div class="calendar-legend">
              <span>0h</span>
              <span class="legend-box h1"></span>
              <span class="legend-box h2"></span>
              <span class="legend-box h3"></span>
              <span class="legend-box h4"></span>
              <span class="legend-box h5"></span>
              <span class="legend-box h6"></span>
              <span class="legend-box h7"></span>
              <span class="legend-box h8"></span>
            </div>
          </div>
        </div>

        <!-- Simulados -->
        <div class="dashboard-card simulados-card">
          <h3>📝 Último Simulado</h3>
          <% if (ultimoSimulado) { %>
            <div class="simulado-main">
              <div class="simulado-header">
                <span class="simulado-nome"><%= ultimoSimulado.nome %></span>
                <span class="simulado-data"><%= new Date(ultimoSimulado.data).toLocaleDateString('pt-BR') %></span>
              </div>
              <div class="simulado-stats">
                <div class="stat-item">
                  <span class="stat-value <%= ultimoSimulado.nota >= 70 ? 'alta' : ultimoSimulado.nota >= 50 ? 'media' : 'baixa' %>"><%= ultimoSimulado.nota %>%</span>
                  <span class="stat-label">Nota</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value"><%= ultimoSimulado.acertos %></span>
                  <span class="stat-label">Acertos</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value"><%= ultimoSimulado.questoes %></span>
                  <span class="stat-label">Questões</span>
                </div>
              </div>
              <div class="simulado-bar">
                <div class="simulado-bar-fill <%= ultimoSimulado.nota >= 70 ? 'alta' : ultimoSimulado.nota >= 50 ? 'media' : 'baixa' %>" style="width: <%= ultimoSimulado.nota %>%"></div>
              </div>
            </div>
            <div class="simulado-media">
              <span>Média geral: <strong><%= mediaSimulados %>%</strong></span>
            </div>
          <% } else { %>
            <div class="empty-state-small">
              <p>Nenhum simulado realizado ainda.</p>
              <a href="/simulados/lista" class="btn-link">Criar primeiro simulado</a>
            </div>
          <% } %>
          <a href="/simulados/lista" class="card-link">Ver todos →</a>
        </div>

      </section>

      <!-- =========================
           ROW: GRÁFICOS
      ========================== -->
      <section class="dashboard-row charts-row">

        <!-- Evolução -->
        <div class="dashboard-card chart-card">
          <h2>📈 Evolução de estudos</h2>
          <% if (!evolucao || evolucao.length === 0) { %>
            <p class="muted">Ainda não há dados suficientes.</p>
          <% } else { %>
            <canvas id="evolucaoChart" height="100"></canvas>
          <% } %>
        </div>

        <!-- Por Dia da Semana -->
        <div class="dashboard-card chart-card">
          <h2>📊 Estudos por Dia</h2>
          <canvas id="diaSemanaChart" height="100"></canvas>
        </div>

      </section>

      <!-- =========================
           ROW: MATÉRIAS + CONQUISTAS
      ========================== -->
      <section class="dashboard-row charts-row">

        <!-- Matérias (Rosca) -->
        <div class="dashboard-card chart-card">
          <h2>🥧 Tempo por Matéria</h2>
          <% if (!porMateria || porMateria.length === 0) { %>
            <p class="muted">Nenhuma matéria estudada ainda.</p>
          <% } else { %>
            <div class="chart-container-rosca">
              <canvas id="materiaChart"></canvas>
            </div>
            <div class="materias-legend">
              <% porMateria.slice(0, 5).forEach(m => { %>
                <div class="legend-item">
                  <span class="legend-color" style="background: <%= m.cor || '#6b7280' %>"></span>
                  <span class="legend-name"><%= m.nome %></span>
                  <span class="legend-value"><%= m.horas %>h</span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Conquistas -->
        <div class="dashboard-card conquistas-card">
          <h2>🏆 Conquistas</h2>
          <% if ((conquistas && conquistas.length > 0) || (conquistasProgresso && conquistasProgresso.length > 0)) { %>
            <div class="conquistas-grid">
              <% conquistas.forEach(c => { %>
                <div class="conquista-item conquista-concluida" title="<%= c.descricao %>">
                  <span class="conquista-icone"><%= c.icone %></span>
                  <span class="conquista-titulo"><%= c.titulo %></span>
                  <span class="conquista-status">✓ Conquistado!</span>
                </div>
              <% }) %>
              <% conquistasProgresso.forEach(c => { 
                const progressoPercentual = Math.min(Math.round((c.progresso / c.meta) * 100), 100);
              %>
                <div class="conquista-item conquista-em-progresso" title="<%= c.descricao %>">
                  <span class="conquista-icone"><%= c.icone %></span>
                  <span class="conquista-titulo"><%= c.titulo %></span>
                  <div class="conquista-progresso">
                    <div class="conquista-progresso-bar" style="width: <%= progressoPercentual %>%"></div>
                  </div>
                  <span class="conquista-progresso-text"><%= progressoPercentual %>%</span>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="conquistas-empty">
              <p>Complete metas para desbloquear conquistas!</p>
              <div class="stats-mini">
                <span>⏱️ <%= horasTotal || 0 %>h</span>
                <span>📝 <%= questoesTotal || 0 %> questões</span>
              </div>
            </div>
          <% } %>
        </div>

      </section>

      <!-- =========================
           AÇÃO FINAL
      ========================== -->
      <section class="dashboard-action">
        <p>O que vamos fazer agora?</p>
        <a href="/registrar/novo" class="btn-primary">
          Registrar estudo de hoje
        </a>
      </section>

    </div>
  </main>

  <!-- Scripts - Gráficos -->
  <script>
    // Dados do servidor
    const evolucaoLabels = <%- JSON.stringify((evolucao || []).map(e => e.label)) %>;
    const evolucaoData = <%- JSON.stringify((evolucao || []).map(e => e.horas)) %>;
    const diasSemanaLabels = <%- JSON.stringify(diasSemanaLabels || ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb']) %>;
    const horasPorDia = <%- JSON.stringify(horasPorDia || [0,0,0,0,0,0,0]) %>;
    const materiaLabels = <%- JSON.stringify((porMateria || []).slice(0,5).map(m => m.nome)) %>;
    const materiaData = <%- JSON.stringify((porMateria || []).slice(0,5).map(m => m.horas)) %>;
    const materiaCores = <%- JSON.stringify((porMateria || []).slice(0,5).map(m => m.cor || '#6b7280')) %>;
  </script>

  <% if (evolucao && evolucao.length > 0) { %>
  <script>
    // Gráfico de Evolução
    const ctxEvolucao = document.getElementById("evolucaoChart").getContext("2d");
    new Chart(ctxEvolucao, {
      type: "line",
      data: {
        labels: evolucaoLabels,
        datasets: [{
          data: evolucaoData,
          borderColor: "#2ee59d",
          backgroundColor: "rgba(46,229,157,0.15)",
          tension: 0.35,
          fill: true,
          pointRadius: 3,
          pointBackgroundColor: "#2ee59d"
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { 
            grid: { color: "#1f2a3a" },
            beginAtZero: true
          }
        }
      }
    });

    // Gráfico por Dia da Semana
    const ctxDia = document.getElementById("diaSemanaChart").getContext("2d");
    new Chart(ctxDia, {
      type: "bar",
      data: {
        labels: diasSemanaLabels,
        datasets: [{
          data: horasPorDia,
          backgroundColor: [
            "rgba(239, 68, 68, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(239, 68, 68, 0.7)"
          ],
          borderColor: [
            "#ef4444",
            "#2ee59d",
            "#2ee59d",
            "#2ee59d",
            "#2ee59d",
            "#2ee59d",
            "#ef4444"
          ],
          borderWidth: 2,
          borderRadius: 8
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { 
            grid: { color: "#1f2a3a" },
            beginAtZero: true
          }
        }
      }
    });

    // Gráfico Rosca de Matérias
    if (materiaLabels.length > 0) {
      const ctxMateria = document.getElementById("materiaChart").getContext("2d");
      new Chart(ctxMateria, {
        type: "doughnut",
        data: {
          labels: materiaLabels,
          datasets: [{
            data: materiaData,
            backgroundColor: materiaCores,
            borderWidth: 0,
            hoverOffset: 10
          }]
        },
        options: {
          cutout: "65%",
          plugins: { 
            legend: { display: false } 
          }
        }
      });
    }
  </script>
  <% } %>

  <!-- Animação de Contadores - Corrigida -->
  <script>
    document.querySelectorAll('.counter').forEach(counter => {
      const target = parseFloat(counter.getAttribute('data-target')) || 0;
      const duration = 800;
      const startTime = performance.now();

      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Easing function
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);
        const current = target * easeOutQuart;
        
        if (Number.isInteger(target)) {
          counter.textContent = Math.floor(current);
        } else {
          counter.textContent = current.toFixed(1);
        }

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      requestAnimationFrame(update);
    });
  </script>

</body>
</html>

