<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KMed | Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/dashboard.css" />

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="page-bg">

  <%- include("../partials/sidebar", { active: "dashboard", userNome, userFoto }) %>

  <main class="with-sidebar">
    <div class="page">

      <!-- =========================
           BOAS-VINDAS + STREAK + GAMIFICAÇÃO
      ========================== -->
      <section class="welcome-card">
        <div class="welcome-text">
          <h1>Olá, <%= userNome %>! 👋</h1>
          <p>Seu objetivo está cada dia mais próximo.</p>
        </div>

        <!-- Badge de Nível Gamificação -->
        <% if (gamificacao) { %>
          <div class="level-badge-dashboard">
            <div class="level-icon">
              <span class="level-number"><%= gamificacao.nivel %></span>
            </div>
            <div class="level-info">
              <span class="level-title"><%= gamificacao.titulo %></span>
              <div class="level-progress">
                <div class="level-progress-bar">
                  <div class="level-progress-fill" style="width: <%= Math.round((gamificacao.xp_atual / gamificacao.xp_proximo_nivel) * 100) %>%"></div>
                </div>
                <span class="level-xp"><%= gamificacao.xp_atual.toLocaleString('pt-BR') %> / <%= gamificacao.xp_proximo_nivel.toLocaleString('pt-BR') %> XP</span>
              </div>
            </div>
          </div>
        <% } %>

        <div class="streak-box">
          <span class="streak-fire">🔥</span>
          <strong><%= streakAtual || 0 %> dias seguidos</strong>

          <div class="streak-week">
            <% (streakSemana || []).forEach(d => { %>
              <span class="day <%= d ? 'on' : '' %>"></span>
            <% }) %>
          </div>
        </div>
      </section>

      <!-- =========================
           QUICK ACTIONS
      ========================== -->
      <section class="quick-actions">
        <a href="/registrar/novo" class="quick-action-btn">
          <span class="icon">📝</span>
          <span class="label">Registrar Estudo</span>
        </a>
        <a href="/simulados/lista" class="quick-action-btn">
          <span class="icon">📋</span>
          <span class="label">Novo Simulado</span>
        </a>
      </section>

      <!-- =========================
           FILTRO GLOBAL
      ========================== -->
      <section class="dashboard-filter">
        <% const filtros = ["hoje", "semana", "mes", "total"]; %>
        <% filtros.forEach(f => { %>
          <a
            href="/dashboard?periodo=<%= f %>"
            class="filter-btn <%= periodo === f ? 'active' : '' %>"
          >
            <%= f.charAt(0).toUpperCase() + f.slice(1) %>
          </a>
        <% }) %>
      </section>

      <!-- =========================
           CARDS RESUMO + META
      ========================== -->
      <section class="dashboard-cards">

        <div class="card kpi">
          <h3>Horas</h3>
          <% 
            const horasTotal = stats?.horas || 0;
            const horasDisplay = Math.floor(horasTotal);
            const minutosDisplay = Math.round((horasTotal - horasDisplay) * 60);
          %>
          <p class="value"><span class="counter" data-target="<%= horasDisplay %>">0</span>h <span class="counter-minutes" data-target="<%= minutosDisplay %>">0</span>m</p>
          <span class="label">Estudadas</span>
          <% if (stats?.horasDiff !== undefined) { %>
            <% 
              const horasDiff = stats.horasDiff || 0;
              const horasDiffDisplay = Math.floor(Math.abs(horasDiff));
              const minutosDiffDisplay = Math.round((Math.abs(horasDiff) - horasDiffDisplay) * 60);
            %>
            <span class="extra <%= stats.horasDiff >= 0 ? 'up' : 'down' %>">
              <%= stats.horasDiff >= 0 ? '↑' : '↓' %>
              <%= horasDiffDisplay %>h <%= minutosDiffDisplay %>m
            </span>
          <% } %>
        </div>

        <div class="card kpi">
          <h3>Questões</h3>
          <p class="value counter" data-target="<%= stats?.questoes || 0 %>">0</p>
          <span class="label">Resolvidas</span>
        </div>

        <div class="card kpi">
          <h3>Aproveitamento</h3>
          <p class="value"><%= stats?.taxa || 0 %>%</p>
          <span class="label">Acertos</span>
        </div>

        <div class="card kpi">
          <h3>Constância</h3>
          <p class="value"><%= stats?.dias || 0 %></p>
          <span class="label">Dias estudados</span>
        </div>

      </section>

      <!-- =========================
           REVISÕES PENDENTES
      ========================== -->
      <% if (revisoesPendentes && revisoesPendentes.length > 0) { %>
        <section class="dashboard-section revisoes-section">
          <div class="section-header">
            <h2>🔄 Revisões Pendentes</h2>
            <a href="/revisoes" class="section-link">Ver todas →</a>
          </div>
          <div class="revisoes-grid">
            <% revisoesPendentes.forEach(r => { %>
              <div class="revisao-card">
                <div class="revisao-info">
                  <span class="revisao-materia"><%= r.subject ? r.subject.nome : 'Matéria' %></span>
                  <span class="revisao-topico"><%= r.nome %></span>
                </div>
                <a href="/revisoes" class="revisao-btn">Revisar</a>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- =========================
           METAS PRINCIPAIS
      ========================== -->
      <section class="dashboard-section metas-section">
        <div class="section-header">
          <h2>🎯 Minhas Metas</h2>
          <div class="metas-actions">
            <button class="btn-criar-meta" onclick="abrirModalMeta()">
              + Nova Meta
            </button>
            <a href="/metas" class="section-link">Ver histórico →</a>
          </div>
        </div>
        
        <% if (metasPrincipais && metasPrincipais.length > 0) { %>
          <div class="metas-grid">
            <% metasPrincipais.forEach(meta => { %>
              <div class="meta-card-dashboard">
                <div class="meta-card-header">
                  <span class="meta-nome"><%= meta.nome %></span>
                  <span class="meta-prazo">⏰ <%= meta.data_limite_formatada %></span>
                </div>
                
                <div class="meta-progressos">
                  <% 
                    const horasConcluidasMeta = meta.horas_concluidas || 0;
                    const metaHoras = meta.meta_horas || 0;
                    const horasConcluidasDisplay = Math.floor(horasConcluidasMeta);
                    const minutosConcluidosDisplay = Math.round((horasConcluidasMeta - horasConcluidasDisplay) * 60);
                  %>
                  <div class="progress-item">
                    <div class="progress-header">
                      <span class="progress-label">Horas</span>
                      <span class="progress-values"><%= horasConcluidasDisplay %>h <%= minutosConcluidosDisplay %>m / <%= metaHoras %>h</span>
                    </div>
                    <div class="progress-bar">
                      <div class="progress-fill" style="width: <%= meta.progresso_horas %>%"></div>
                    </div>
                  </div>
                  <% if (meta.meta_questoes > 0) { %>
                    <div class="progress-item">
                      <div class="progress-header">
                        <span class="progress-label">Questões</span>
                        <span class="progress-values"><%= meta.questoes_concluidas %> / <%= meta.meta_questoes %></span>
                      </div>
                      <div class="progress-bar">
                        <div class="progress-fill" style="width: <%= meta.progresso_questoes %>%"></div>
                      </div>
                    </div>
                  <% } %>
                </div>
                
                <div class="meta-footer">
                  <span class="meta-progresso-total"><%= meta.progresso_total %>% completo</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="metas-empty">
            <p>Você ainda não tem metas principais.</p>
            <p class="metas-hint">Crie uma meta e marque como principal para aparecer aqui!</p>
          </div>
        <% } %>
      </section>

      <!-- =========================
           ROW: CALENDÁRIO + SIMULADOS
      ========================== -->
      <section class="dashboard-row">

        <!-- Mini Calendário -->
        <div class="dashboard-card mini-calendar-card">
          <h3>📅 Este Mês</h3>
          <div class="mini-calendar">
            <% 
            const mesNomes = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
            const mesAtualNum = new Date().getMonth();
            %>
            <div class="calendar-month"><%= mesNomes[mesAtualNum] %></div>
            <div class="calendar-grid">
              <% diasCalendario.forEach(d => { 
                const horaClasse = 'h' + Math.min(Math.floor(d.horas), 12);
              %>
                <div 
                  class="calendar-day <%= horaClasse %>"
                  title="<%= d.horas %>h"
                >
                  <%= d.dia %>
                </div>
              <% }) %>
            </div>
            <div class="calendar-legend">
              <span>0h</span>
              <span class="legend-box h1"></span>
              <span class="legend-box h2"></span>
              <span class="legend-box h3"></span>
              <span class="legend-box h4"></span>
              <span class="legend-box h5"></span>
              <span class="legend-box h6"></span>
              <span class="legend-box h7"></span>
              <span class="legend-box h8"></span>
            </div>
          </div>
        </div>

        <!-- Simulados -->
        <div class="dashboard-card simulados-card">
          <h3>📝 Último Simulado</h3>
          <% if (ultimoSimulado) { %>
            <div class="simulado-main">
              <div class="simulado-header">
                <span class="simulado-nome"><%= ultimoSimulado.nome %></span>
                <span class="simulado-data"><%= new Date(ultimoSimulado.data).toLocaleDateString('pt-BR') %></span>
              </div>
              <div class="simulado-stats">
                <div class="stat-item">
                  <span class="stat-value <%= ultimoSimulado.nota >= 70 ? 'alta' : ultimoSimulado.nota >= 50 ? 'media' : 'baixa' %>"><%= ultimoSimulado.nota %>%</span>
                  <span class="stat-label">Nota</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value"><%= ultimoSimulado.acertos %></span>
                  <span class="stat-label">Acertos</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value"><%= ultimoSimulado.questoes %></span>
                  <span class="stat-label">Questões</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value">
                    <% 
                      const horas = Math.floor(ultimoSimulado.tempo / 60);
                      const minutos = ultimoSimulado.tempo % 60;
                    %>
                    <%= horas > 0 ? horas + 'h ' + minutos + 'm' : minutos + 'm' %>
                  </span>
                  <span class="stat-label">Tempo</span>
                </div>
              </div>
              <div class="simulado-bar">
                <div class="simulado-bar-fill <%= ultimoSimulado.nota >= 70 ? 'alta' : ultimoSimulado.nota >= 50 ? 'media' : 'baixa' %>" style="width: <%= ultimoSimulado.nota %>%"></div>
              </div>
              
              <!-- Breakdown por Área -->
              <% if (ultimoSimuladoBlocos && ultimoSimuladoBlocos.length > 0) { %>
                <div class="simulado-areas">
                  <span class="areas-title">Por Área:</span>
                  <div class="areas-grid">
                    <% ultimoSimuladoBlocos.forEach(bloco => { %>
                      <div class="area-item">
                        <div class="area-header">
                          <span class="area-nome" style="color: <%= bloco.cor %>"><%= bloco.area %></span>
                          <span class="area-nota <%= bloco.nota >= 70 ? 'alta' : bloco.nota >= 50 ? 'media' : 'baixa' %>"><%= bloco.nota %>%</span>
                        </div>
                        <div class="area-bar">
                          <div class="area-bar-fill" style="width: <%= bloco.nota %>%; background: <%= bloco.cor %>"></div>
                        </div>
                        <div class="area-details">
                          <span><%= bloco.acertos %>/<%= bloco.totalQuestoes %> acertos</span>
                          <span><%= bloco.tempo > 0 ? (bloco.tempo >= 60 ? Math.floor(bloco.tempo/60) + 'h' + (bloco.tempo%60) + 'm' : bloco.tempo + 'm') : '-' %></span>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } %>
            </div>
            <div class="simulado-media">
              <span>Média geral: <strong><%= mediaSimulados %>%</strong></span>
            </div>
          <% } else { %>
            <div class="empty-state-small">
              <p>Nenhum simulado realizado ainda.</p>
              <a href="/simulados/lista" class="btn-link">Criar primeiro simulado</a>
            </div>
          <% } %>
          <a href="/simulados/lista" class="card-link">Ver todos →</a>
        </div>

      </section>

      <!-- =========================
           ROW: GRÁFICOS
      ========================== -->
      <section class="dashboard-row charts-row">

        <!-- Evolução -->
        <div class="dashboard-card chart-card">
          <h2>📈 Evolução de estudos</h2>
          <% if (!evolucao || evolucao.length === 0) { %>
            <p class="muted">Ainda não há dados suficientes.</p>
          <% } else { %>
            <canvas id="evolucaoChart" height="100"></canvas>
          <% } %>
        </div>

        <!-- Por Dia da Semana -->
        <div class="dashboard-card chart-card">
          <h2>📊 Estudos por Dia</h2>
          <canvas id="diaSemanaChart" height="100"></canvas>
        </div>

      </section>

      <!-- =========================
           ROW: MATÉRIAS + CONQUISTAS
      ========================== -->
      <section class="dashboard-row charts-row">

        <!-- Matérias (Rosca) -->
        <div class="dashboard-card chart-card">
          <h2>🥧 Tempo por Matéria</h2>
          <% if (!porMateria || porMateria.length === 0) { %>
            <p class="muted">Nenhuma matéria estudada ainda.</p>
          <% } else { %>
            <div class="chart-container-rosca">
              <canvas id="materiaChart"></canvas>
            </div>
            <div class="materias-legend">
              <% porMateria.slice(0, 5).forEach(m => { %>
                <div class="legend-item">
                  <span class="legend-color" style="background: <%= m.cor || '#6b7280' %>"></span>
                  <span class="legend-name"><%= m.nome %></span>
                  <span class="legend-value"><%= m.horas %>h</span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Conquistas -->
        <div class="dashboard-card conquistas-card">
          <h2>🏆 Conquistas</h2>
          <% if ((conquistas && conquistas.length > 0) || (conquistasProgresso && conquistasProgresso.length > 0)) { %>
            <div class="conquistas-grid">
              <% conquistas.forEach(c => { %>
                <div class="conquista-item conquista-concluida" title="<%= c.descricao %>">
                  <span class="conquista-icone"><%= c.icone %></span>
                  <span class="conquista-titulo"><%= c.titulo %></span>
                  <span class="conquista-status">✓ Conquistado!</span>
                </div>
              <% }) %>
              <% conquistasProgresso.forEach(c => { 
                const progressoPercentual = Math.min(Math.round((c.progresso / c.meta) * 100), 100);
              %>
                <div class="conquista-item conquista-em-progresso" title="<%= c.descricao %>">
                  <span class="conquista-icone"><%= c.icone %></span>
                  <span class="conquista-titulo"><%= c.titulo %></span>
                  <div class="conquista-progresso">
                    <div class="conquista-progresso-bar" style="width: <%= progressoPercentual %>%"></div>
                  </div>
                  <span class="conquista-progresso-text"><%= progressoPercentual %>%</span>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="conquistas-empty">
              <p>Complete metas para desbloquear conquistas!</p>
              <div class="stats-mini">
                <span>⏱️ <%= horasTotal || 0 %>h</span>
                <span>📝 <%= questoesTotal || 0 %> questões</span>
              </div>
            </div>
          <% } %>
        </div>

      </section>

      <!-- =========================
           AÇÃO FINAL
      ========================== -->
      <section class="dashboard-action">
        <p>O que vamos fazer agora?</p>
        <a href="/registrar/novo" class="btn-primary">
          Registrar estudo de hoje
        </a>
      </section>

    </div>
  </main>

  <!-- Scripts - Gráficos -->
  <script>
    // Dados do servidor
    const evolucaoLabels = <%- JSON.stringify((evolucao || []).map(e => e.label)) %>;
    const evolucaoData = <%- JSON.stringify((evolucao || []).map(e => e.horas)) %>;
    const diasSemanaLabels = <%- JSON.stringify(diasSemanaLabels || ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb']) %>;
    const horasPorDia = <%- JSON.stringify(horasPorDia || [0,0,0,0,0,0,0]) %>;
    const materiaLabels = <%- JSON.stringify((porMateria || []).slice(0,5).map(m => m.nome)) %>;
    const materiaData = <%- JSON.stringify((porMateria || []).slice(0,5).map(m => m.horas)) %>;
    const materiaCores = <%- JSON.stringify((porMateria || []).slice(0,5).map(m => m.cor || '#6b7280')) %>;
  </script>

  <% if (evolucao && evolucao.length > 0) { %>
  <script>
    // Gráfico de Evolução
    const ctxEvolucao = document.getElementById("evolucaoChart").getContext("2d");
    new Chart(ctxEvolucao, {
      type: "line",
      data: {
        labels: evolucaoLabels,
        datasets: [{
          data: evolucaoData,
          borderColor: "#2ee59d",
          backgroundColor: "rgba(46,229,157,0.15)",
          tension: 0.35,
          fill: true,
          pointRadius: 3,
          pointBackgroundColor: "#2ee59d"
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { 
            grid: { color: "#1f2a3a" },
            beginAtZero: true
          }
        }
      }
    });

    // Gráfico por Dia da Semana
    const ctxDia = document.getElementById("diaSemanaChart").getContext("2d");
    new Chart(ctxDia, {
      type: "bar",
      data: {
        labels: diasSemanaLabels,
        datasets: [{
          data: horasPorDia,
          backgroundColor: [
            "rgba(239, 68, 68, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(46, 229, 157, 0.7)",
            "rgba(239, 68, 68, 0.7)"
          ],
          borderColor: [
            "#ef4444",
            "#2ee59d",
            "#2ee59d",
            "#2ee59d",
            "#2ee59d",
            "#2ee59d",
            "#ef4444"
          ],
          borderWidth: 2,
          borderRadius: 8
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { 
            grid: { color: "#1f2a3a" },
            beginAtZero: true
          }
        }
      }
    });

    // Gráfico Rosca de Matérias
    if (materiaLabels.length > 0) {
      const ctxMateria = document.getElementById("materiaChart").getContext("2d");
      new Chart(ctxMateria, {
        type: "doughnut",
        data: {
          labels: materiaLabels,
          datasets: [{
            data: materiaData,
            backgroundColor: materiaCores,
            borderWidth: 0,
            hoverOffset: 10
          }]
        },
        options: {
          cutout: "65%",
          plugins: { 
            legend: { display: false } 
          }
        }
      });
    }
  </script>
  <% } %>

  <!-- Animação de Contadores - Corrigida -->
  <script>
    // Animação para horas
    document.querySelectorAll('.counter').forEach(counter => {
      const target = parseFloat(counter.getAttribute('data-target')) || 0;
      const duration = 800;
      const startTime = performance.now();

      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Easing function
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);
        const current = target * easeOutQuart;
        
        if (Number.isInteger(target)) {
          counter.textContent = Math.floor(current);
        } else {
          counter.textContent = current.toFixed(1);
        }

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      requestAnimationFrame(update);
    });

    // Animação para minutos
    document.querySelectorAll('.counter-minutes').forEach(counter => {
      const target = parseFloat(counter.getAttribute('data-target')) || 0;
      const duration = 800;
      const startTime = performance.now();

      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Easing function
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);
        const current = target * easeOutQuart;
        
        counter.textContent = Math.floor(current);

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      requestAnimationFrame(update);
    });
  </script>

  <!-- Modal de Criar Meta -->
  <div id="modalMeta" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3>🎯 Criar Nova Meta</h3>
        <button class="modal-close" onclick="fecharModalMeta()">&times;</button>
      </div>
      <form id="formCriarMeta" class="modal-body">
        <div class="form-group">
          <label for="nome">Nome da Meta *</label>
          <input type="text" id="nome" name="nome" required placeholder="Ex: Estudar Matemática">
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="meta_horas">Meta de Horas *</label>
            <input type="number" id="meta_horas" name="meta_horas" required min="1" step="0.5" placeholder="Ex: 40">
          </div>
          <div class="form-group">
            <label for="meta_questoes">Meta de Questões</label>
            <input type="number" id="meta_questoes" name="meta_questoes" min="0" placeholder="500">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="data_inicio">Data de Início *</label>
            <input type="date" id="data_inicio" name="data_inicio" required>
          </div>
          <div class="form-group">
            <label for="data_limite">Data Limite *</label>
            <input type="date" id="data_limite" name="data_limite" required>
          </div>
        </div>

        <div class="form-group checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" id="eh_principal" name="eh_principal" value="true">
            <span>Definir como meta principal (aparece no dashboard)</span>
          </label>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="fecharModalMeta()">Cancelar</button>
          <button type="submit" class="btn btn-primary">Criar Meta</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Estilos do Modal -->
  <style>
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }
    
    .modal.active {
      display: flex;
    }
    
    .modal-content {
      background: linear-gradient(180deg, #161821, #0f1117);
      border: 1px solid rgba(46, 229, 157, 0.3);
      border-radius: 16px;
      width: 90%;
      max-width: 500px;
      max-height: 90vh;
      overflow-y: auto;
      transform: scale(0.9);
      transition: transform 0.3s ease;
    }
    
    .modal.active .modal-content {
      transform: scale(1);
    }
    
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .modal-header h3 {
      margin: 0;
      color: #fff;
      font-size: 1.25rem;
    }
    
    .modal-close {
      background: none;
      border: none;
      color: #9aa1ad;
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }
    
    .modal-close:hover {
      color: #ef4444;
    }
    
    .modal-body {
      padding: 24px;
    }
    
    .form-group {
      margin-bottom: 16px;
    }
    
    .form-group label {
      display: block;
      color: #9aa1ad;
      font-size: 0.875rem;
      margin-bottom: 6px;
    }
    
    .form-group input {
      width: 100%;
      padding: 12px;
      background: #1a1d24;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      color: #fff;
      font-size: 1rem;
      box-sizing: border-box;
    }
    
    .form-group input:focus {
      outline: none;
      border-color: #2ee59d;
    }
    
    .form-row {
      display: flex;
      gap: 16px;
    }
    
    .form-row .form-group {
      flex: 1;
    }
    
    .modal-footer {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      margin-top: 8px;
    }
    
    .btn {
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    
    .btn-primary {
      background: #2ee59d;
      color: #0f1218;
    }
    
    .btn-primary:hover {
      background: #26c992;
      transform: translateY(-1px);
    }
    
    .btn-secondary {
      background: transparent;
      color: #9aa1ad;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }

    @media (max-width: 500px) {
      .form-row {
        flex-direction: column;
        gap: 0;
      }
    }
    
    .checkbox-group {
      margin: 16px 0;
    }
    
    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      color: #9aa1ad;
      font-size: 0.9rem;
    }
    
    .checkbox-label input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: #2ee59d;
      cursor: pointer;
    }
  </style>

  <!-- Scripts do Modal de Meta -->
  <script>
    // Funções para abrir/fechar modal
    function abrirModalMeta() {
      const modal = document.getElementById('modalMeta');
      modal.classList.add('active');
      
      // Define datas padrão
      const hoje = new Date();
      const dataInicio = document.getElementById('data_inicio');
      const dataLimite = document.getElementById('data_limite');
      
      if (!dataInicio.value) {
        dataInicio.value = hoje.toISOString().split('T')[0];
      }
      
      if (!dataLimite.value) {
        const dataFutura = new Date(hoje);
        dataFutura.setMonth(dataFutura.getMonth() + 1);
        dataLimite.value = dataFutura.toISOString().split('T')[0];
      }
    }
    
    function fecharModalMeta() {
      const modal = document.getElementById('modalMeta');
      modal.classList.remove('active');
    }
    
    // Fechar modal ao clicar fora
    document.getElementById('modalMeta').addEventListener('click', function(e) {
      if (e.target === this) {
        fecharModalMeta();
      }
    });
    
    // Enviar formulário de criar meta
    document.getElementById('formCriarMeta').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const ehPrincipalCheckbox = document.getElementById('eh_principal');
      const dados = {
        nome: formData.get('nome'),
        meta_horas: formData.get('meta_horas'),
        meta_questoes: formData.get('meta_questoes') || 0,
        data_inicio: formData.get('data_inicio'),
        data_limite: formData.get('data_limite'),
        eh_principal: ehPrincipalCheckbox ? ehPrincipalCheckbox.checked : false
      };
      
      try {
        const response = await fetch('/api/metas/criar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(dados)
        });
        
        const result = await response.json();
        
        if (response.ok) {
          alert('Meta criada com sucesso!');
          fecharModalMeta();
          // Recarrega a página para mostrar a nova meta
          location.reload();
        } else {
          alert(result.erro || 'Erro ao criar meta');
        }
      } catch (error) {
        console.error('Erro:', error);
        alert('Erro ao criar meta');
      }
    });
  </script>

</body>
</html>

