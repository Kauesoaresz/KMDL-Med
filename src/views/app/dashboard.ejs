<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KMed | Dashboard</title>

  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/dashboard.css" />

  <!-- Chart.js (gráfico simples) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="page-bg">

  <%- include("../partials/sidebar", { active: "dashboard", userNome }) %>

  <main class="with-sidebar">
    <div class="page">

      <!-- =========================
           BOAS-VINDAS + STREAK
      ========================== -->
      <section class="welcome-card">
        <div class="welcome-text">
          <h1>Olá, <%= userNome %>!</h1>
          <p>Seu objetivo está cada dia mais próximo.</p>
        </div>

        <div class="streak-box">
          <span class="streak-fire">🔥</span>
          <strong><%= streakAtual || 0 %> dias seguidos</strong>

          <div class="streak-week">
            <% (streakSemana || []).forEach(d => { %>
              <span class="day <%= d ? 'on' : '' %>"></span>
            <% }) %>
          </div>
        </div>
      </section>

      <!-- =========================
           FILTRO GLOBAL
      ========================== -->
      <section class="dashboard-filter">
        <% const filtros = ["hoje", "semana", "mes", "total"]; %>
        <% filtros.forEach(f => { %>
          <a
            href="/dashboard?periodo=<%= f %>"
            class="filter-btn <%= periodo === f ? 'active' : '' %>"
          >
            <%= f.charAt(0).toUpperCase() + f.slice(1) %>
          </a>
        <% }) %>
      </section>

      <!-- =========================
           CARDS RESUMO
      ========================== -->
      <section class="dashboard-cards clean">

        <div class="card kpi">
          <h3>Horas</h3>
          <p class="value"><%= stats?.horas || 0 %>h</p>
          <span class="label">Estudadas</span>
          <% if (stats?.horasDiff !== undefined) { %>
            <span class="extra <%= stats.horasDiff >= 0 ? 'up' : 'down' %>">
              <%= stats.horasDiff >= 0 ? '↑' : '↓' %>
              <%= Math.abs(stats.horasDiff) %>h
            </span>
          <% } %>
        </div>

        <div class="card kpi">
          <h3>Questões</h3>
          <p class="value"><%= stats?.questoes || 0 %></p>
          <span class="label">Resolvidas</span>
        </div>

        <div class="card kpi">
          <h3>Aproveitamento</h3>
          <p class="value"><%= stats?.taxa || 0 %>%</p>
          <span class="label">Acertos</span>
        </div>

        <div class="card kpi">
          <h3>Constância</h3>
          <p class="value"><%= stats?.dias || 0 %></p>
          <span class="label">Dias estudados</span>
        </div>

      </section>

      <!-- =========================
           EVOLUÇÃO
      ========================== -->
      <section class="dashboard-section">
        <h2>Evolução de estudos</h2>

        <% if (!evolucao || evolucao.length === 0) { %>
          <p class="muted">Ainda não há dados suficientes.</p>
        <% } else { %>
          <canvas id="evolucaoChart" height="90"></canvas>
        <% } %>
      </section>

      <!-- =========================
           AÇÃO FINAL
      ========================== -->
      <section class="dashboard-action">
        <p>O que vamos fazer agora?</p>
        <a href="/registrar/novo" class="btn-primary">
          Registrar estudo de hoje
        </a>
      </section>

    </div>
  </main>

  <% if (evolucao && evolucao.length > 0) { %>
  <script>
    const ctx = document.getElementById("evolucaoChart").getContext("2d");

    new Chart(ctx, {
      type: "line",
      data: {
        labels: <%- JSON.stringify(evolucao.map(e => e.label)) %>,
        datasets: [{
          data: <%- JSON.stringify(evolucao.map(e => e.horas)) %>,
          borderColor: "#2ee59d",
          backgroundColor: "rgba(46,229,157,0.15)",
          tension: 0.35,
          fill: true
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { grid: { color: "#1f2a3a" } }
        }
      }
    });
  </script>
  <% } %>

</body>
</html>
