<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>KMed | Erros do Simulado</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- CSS GLOBAL -->
  <link rel="stylesheet" href="/public/css/components/sidebar.css">

  <!-- CSS DA TELA -->
  <link rel="stylesheet" href="/public/css/app/simulados-erros.css">
</head>

<body class="page-bg">

<%- include("../partials/sidebar", {
  active: "simulados",
  userNome,
  userFoto
}) %>

<main class="with-sidebar">
<section class="page simulados-erros">

<header class="kmed-header">
  <h1>Erros do Simulado</h1>
  <p>
    <strong><%= simulado.nome %></strong> •
    <%= simulado.tipo %> •
    <span class="status <%= simulado.status === 'FINALIZADO' ? 'ok' : 'warn' %>">
      <%= simulado.status === "FINALIZADO" ? "Finalizado" : "Em andamento" %>
    </span>
  </p>
</header>

<div class="acoes-topo">
  <a href="/simulados/lista" class="btn-voltar">← Voltar para lista</a>
</div>

<% if (!simulado.partes || simulado.partes.length === 0) { %>

  <p class="vazio">Nenhuma parte cadastrada ainda.</p>

<% } else { %>

<%
  const partesPorDia = { DIA_1: [], DIA_2: [] };
  simulado.partes.forEach(p => partesPorDia[p.dia].push(p));
%>

<% ["DIA_1", "DIA_2"].forEach(dia => {
  if (partesPorDia[dia].length === 0) return;

  const tempo = partesPorDia[dia][0].tempo_minutos;
  const data  = partesPorDia[dia][0].data_prova;
%>

<div class="bloco-dia">
  <h2><%= dia === "DIA_1" ? "Dia 1" : "Dia 2" %></h2>
  <div class="meta-dia"><%= data %> • <%= tempo %> min</div>

  <% partesPorDia[dia].forEach(parte => { %>
    <div class="bloco-area">
      <h3><%= parte.area %></h3>

      <% if (!parte.erros || parte.erros.length === 0) { %>
        <p class="sem-erros">Nenhuma questão errada 🎉</p>
      <% } else { %>

        <div class="lista-erros">
          <% parte.erros
            .sort((a, b) => a.questao - b.questao)
            .forEach(e => { %>

            <label class="erro-item <%= e.revisado ? 'revisado' : '' %>">
              <input
                type="checkbox"
                <%= e.revisado ? "checked" : "" %>
                onchange="toggleRevisado(<%= e.id %>, this)"
              >
              <span class="questao-erro"><%= e.questao %></span>
            </label>

          <% }) %>
        </div>

      <% } %>
    </div>
  <% }) %>
</div>

<% }) %>

<% } %>

</section>
</main>

<script>
async function toggleRevisado(id, checkbox) {
  try {
    const res = await fetch(`/simulados/erros/${id}/revisar`, {
      method: "POST"
    });

    const data = await res.json();

    if (data.ok) {
      checkbox.closest(".erro-item")
        .classList.toggle("revisado", data.revisado);
    }
  } catch (err) {
    alert("Erro ao atualizar revisão");
  }
}
</script>

</body>
</html>
