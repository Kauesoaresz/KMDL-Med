<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title>KMed | Estatísticas de Redação</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function() {
      const savedTheme = localStorage.getItem('kmed-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if ((!savedTheme && !prefersDark) || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <link rel="stylesheet" href="/public/css/components/theme.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/estatisticas-conteudo.css">
  <link rel="stylesheet" href="/public/css/app/estatisticas-redacao.css">
</head>
<body class="page-bg">
<%- include("../partials/sidebar", { active: "estatisticas", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page redacao-page">
    <header class="topbar">
      <div>
        <h1>Estatísticas de Redação</h1>
        <p>Visão clara da evolução das suas redações, competências e consistência.</p>
      </div>
      <div class="period-filter">
        <a href="/estatisticas/redacao?period=week" class="filter-btn <%= period === 'week' ? 'active' : '' %>">Semana</a>
        <a href="/estatisticas/redacao?period=month" class="filter-btn <%= period === 'month' ? 'active' : '' %>">Mês</a>
        <a href="/estatisticas/redacao?period=all" class="filter-btn <%= period === 'all' ? 'active' : '' %>">Total</a>
      </div>
    </header>

    <section class="kpis">
      <article class="kpi"><span class="kpi-label">Redações</span><strong class="kpi-value"><%= redacao.total || 0 %></strong></article>
      <article class="kpi"><span class="kpi-label">Nota média</span><strong class="kpi-value"><%= redacao.mediaNota || "—" %></strong></article>
      <article class="kpi"><span class="kpi-label">Melhor nota</span><strong class="kpi-value"><%= redacao.melhorNota || "—" %></strong></article>
      <article class="kpi"><span class="kpi-label">Pior nota</span><strong class="kpi-value"><%= redacao.piorNota || "—" %></strong></article>
      <article class="kpi"><span class="kpi-label">Tempo total</span><strong class="kpi-value"><%= Math.floor(redacao.horas || 0) %>h <%= Math.round(((redacao.horas || 0) % 1) * 60) %>m</strong></article>
      <article class="kpi"><span class="kpi-label">Média C1-C5</span><strong class="kpi-value"><%= redacao.mediaCompetencias || "—" %></strong></article>
    </section>

    <section class="content-grid">
      <article class="panel">
        <header class="panel-head"><h2>Médias por competência</h2></header>
        <div class="competencias-list">
          <div><span>C1</span><strong><%= redacao.mediaC1 != null ? redacao.mediaC1.toFixed(1) : "—" %></strong></div>
          <div><span>C2</span><strong><%= redacao.mediaC2 != null ? redacao.mediaC2.toFixed(1) : "—" %></strong></div>
          <div><span>C3</span><strong><%= redacao.mediaC3 != null ? redacao.mediaC3.toFixed(1) : "—" %></strong></div>
          <div><span>C4</span><strong><%= redacao.mediaC4 != null ? redacao.mediaC4.toFixed(1) : "—" %></strong></div>
          <div><span>C5</span><strong><%= redacao.mediaC5 != null ? redacao.mediaC5.toFixed(1) : "—" %></strong></div>
        </div>
      </article>

      <article class="panel">
        <header class="panel-head"><h2>Indicadores</h2></header>
        <div class="mini-kpis">
          <div><span>Streak</span><strong><%= redacao.avancado?.redacaoStreak || 0 %> dias</strong></div>
          <div><span>Tempo médio</span><strong><%= redacao.avancado?.tempoMedio || 0 %>h</strong></div>
          <div><span>Correlação tempo/nota</span><strong><%= redacao.avancado?.correlacaoTempoNota != null ? Math.round(redacao.avancado.correlacaoTempoNota * 100) + '%' : '—' %></strong></div>
          <div><span>Notas >= 800</span><strong><%= redacao.porcentagem800 || 0 %>%</strong></div>
        </div>
      </article>
    </section>

    <section class="charts-grid">
      <article class="panel chart-panel">
        <header class="panel-head"><h2>Distribuição de notas</h2></header>
        <canvas id="notaHistogramChart"></canvas>
      </article>
      <article class="panel chart-panel">
        <header class="panel-head"><h2>Top estilos</h2></header>
        <canvas id="topEstilosChart"></canvas>
      </article>
      <article class="panel chart-panel">
        <header class="panel-head"><h2>Tempo vs Nota</h2></header>
        <canvas id="tempoNotaScatter"></canvas>
      </article>
      <article class="panel chart-panel">
        <header class="panel-head"><h2>Evolução recente</h2></header>
        <canvas id="evolucaoNotaChart"></canvas>
      </article>
    </section>

    <section class="panel">
      <header class="panel-head"><h2>Redações registradas</h2></header>
      <% if (redacao.porRedacao && redacao.porRedacao.length > 0) { %>
      <div class="table-wrap">
        <table class="redacao-table">
          <thead>
            <tr>
              <th>Data</th>
              <th>Tema</th>
              <th>Nota</th>
              <th>Tempo</th>
              <th>Comp.</th>
              <th>Evol.</th>
              <th>Comentário</th>
              <th>Ações</th>
              <th>Ver</th>
            </tr>
          </thead>
          <tbody>
            <% redacao.porRedacao.forEach(function(row){ %>
            <tr class="redacao-table-row" data-entry-id="<%= row.id %>">
              <td><%= new Date(row.data).toLocaleDateString('pt-BR') %></td>
              <td><div class="tema"><%= row.tema || "Não informado" %></div><small><%= row.estilo || "Redação" %></small></td>
              <td><strong><%= row.nota != null ? Number(row.nota).toFixed(1) : "—" %></strong></td>
              <td><%= Math.floor(Number(row.horas || 0)) %>h <%= Math.round((Number(row.horas || 0) % 1) * 60) %>m</td>
              <td><%= (parseFloat(row.totalCompetencias) || 0).toFixed(0) %></td>
              <td>
                <% if (row.deltaNota == null) { %>—
                <% } else if (row.deltaNota > 0) { %><span class="delta up">+<%= row.deltaNota.toFixed(1) %></span>
                <% } else if (row.deltaNota < 0) { %><span class="delta down"><%= row.deltaNota.toFixed(1) %></span>
                <% } else { %><span class="delta">0.0</span><% } %>
              </td>
              <td>
                <textarea class="inline-comentario" data-entry-id="<%= row.id %>" rows="2"><%= row.comentario || '' %></textarea>
                <button class="btn-inline-save-comment" data-entry-id="<%= row.id %>" type="button">Salvar</button>
              </td>
              <td>
                <div class="actions">
                  <a href="/redacao/editar/<%= row.id %>">Editar</a>
                  <form method="POST" action="/redacao/excluir/<%= row.id %>" onsubmit="return confirm('Deseja excluir esta redação?');">
                    <button type="submit" class="danger">Excluir</button>
                  </form>
                </div>
              </td>
              <td><button class="expand-btn">👁️</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <p class="empty">Nenhuma redação no período selecionado.</p>
      <% } %>
    </section>
  </div>

  <div id="redacaoDetailsModal" class="details-modal">
    <div class="modal-content">
      <button id="closeModal" class="modal-close">×</button>
      <div id="modalContent"><p>Carregando...</p></div>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>window.redacaoData = <%- JSON.stringify(redacao || {}) %>;</script>
<script src="/public/js/app/estatisticas-redacao.js"></script>
</body>
</html>
