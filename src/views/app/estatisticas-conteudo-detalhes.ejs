<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: materia.nome + " · Conteúdo", css: ["estatisticas-conteudo-detalhes"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "estatisticas", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📚 <%= materia.nome %></h1>
        <p>Desempenho por tópico.</p>
      </div>
      <a href="/estatisticas/conteudo/dashboard" class="btn-ghost btn-sm">← Conteúdo</a>
    </header>

    <!-- FILTRO -->
    <div class="chips">
      <a href="/estatisticas/conteudo/<%= materia.id %>?period=week"  class="chip <%= period === 'week'  ? 'active' : '' %>">📅 Semana</a>
      <a href="/estatisticas/conteudo/<%= materia.id %>?period=month" class="chip <%= period === 'month' ? 'active' : '' %>">🗓 Mês</a>
      <a href="/estatisticas/conteudo/<%= materia.id %>?period=all"   class="chip <%= period === 'all'   ? 'active' : '' %>">∞ Total</a>
    </div>

    <!-- KPIs -->
    <section class="grid-4">
      <div class="card kpi">
        <h3>Horas</h3>
        <p class="value"><%= formatHours(materia.horas) %></p>
        <span class="label">
          <%= period === 'week' ? 'Nesta semana' : period === 'month' ? 'Neste mês' : 'Total geral' %>
        </span>
      </div>

      <div class="card kpi">
        <h3>Questões</h3>
        <p class="value"><%= materia.questoes %></p>
        <span class="label">
          <span class="ok">✓ <%= materia.acertos %></span>
          <span class="err">✗ <%= materia.erros %></span>
          · <%= materia.aproveitamento %>%
        </span>
      </div>

      <div class="card kpi">
        <h3>Dias estudados</h3>
        <p class="value"><%= materia.dias_estudados %></p>
        <span class="label">Com registro</span>
      </div>

      <div class="card kpi">
        <h3>Aproveitamento</h3>
        <p class="value"><%= materia.aproveitamento %>%</p>
        <span class="label">
          <%= materia.ultimo_study ? "Último: " + new Date(materia.ultimo_study).toLocaleDateString('pt-BR') : "Nunca estudado" %>
        </span>
      </div>
    </section>

    <!-- TÓPICOS -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">📋 Tópicos</h2>
        <span class="muted"><%= materia.topicos.length %> <%= materia.topicos.length === 1 ? "tópico" : "tópicos" %></span>
      </div>

      <% if (materia.topicos.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📋</div>
          <h3>Nenhum tópico estudado ainda</h3>
          <p>Registre estudos nesta matéria para ver os tópicos aqui.</p>
        </div>
      <% } else { %>
        <div class="top-grid">
          <% materia.topicos.forEach(function(t) { %>
            <article class="top-card">
              <header class="top-head">
                <h3 class="top-name"><%= t.nome %></h3>
                <span class="badge <%= t.aproveitamento >= 70 ? 'badge-ok' : t.aproveitamento >= 50 ? 'badge-warn' : 'badge-err' %>">
                  <%= t.aproveitamento %>%
                </span>
              </header>

              <div class="top-stats">
                <div><small>Horas</small><strong class="num"><%= formatHours(t.horas) %></strong></div>
                <div><small>Questões</small><strong class="num"><%= t.questoes %></strong></div>
                <div><small>Acertos</small><strong class="num ok"><%= t.acertos %></strong></div>
                <div><small>Erros</small><strong class="num err"><%= t.erros %></strong></div>
              </div>

              <div class="progress"><span style="width: <%= t.aproveitamento %>%"></span></div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- TABELA -->
    <% if (materia.topicos.length > 0) { %>
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">📊 Tabela completa</h2>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Tópico</th>
                <th>Horas</th>
                <th>Questões</th>
                <th>Acertos</th>
                <th>Erros</th>
                <th>Aproveitamento</th>
              </tr>
            </thead>
            <tbody>
              <% materia.topicos.forEach(function(t) { %>
                <tr>
                  <td><%= t.nome %></td>
                  <td><%= formatHours(t.horas) %></td>
                  <td><%= t.questoes %></td>
                  <td class="ok"><%= t.acertos %></td>
                  <td class="err"><%= t.erros %></td>
                  <td>
                    <span class="badge <%= t.aproveitamento >= 70 ? 'badge-ok' : t.aproveitamento >= 50 ? 'badge-warn' : 'badge-err' %>">
                      <%= t.aproveitamento %>%
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

  </div>
</main>

</body>
</html>