<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Provas - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/provas.css" />
</head>

<body class="page-bg">

<%- include("../../partials/sidebar", { active, userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <div class="page-header">
      <div>
        <h1>🎯 Provas</h1>
        <p>Acompanhe suas inscrições e tempo restante</p>
      </div>
      <a href="/provas/nova" class="btn-primary">
        + Adicionar Prova
      </a>
    </div>

    <div class="provas-grid">
      <% if (provas.length === 0) { %>
        <p>Nenhuma prova cadastrada.</p>
      <% } %>

      <% provas.forEach(prova => { 

  const hoje = new Date();
  const hojeSemHora = new Date(
    hoje.getFullYear(),
    hoje.getMonth(),
    hoje.getDate()
  );

  const partes = prova.data_prova_1.split("-");
  const dataObj = new Date(partes[0], partes[1] - 1, partes[2]);

  const diffTime = dataObj - hojeSemHora;
  const diasRestantes = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  const diasSemana = [
    "Domingo","Segunda-feira","Terça-feira",
    "Quarta-feira","Quinta-feira","Sexta-feira","Sábado"
  ];

  const diaSemana = diasSemana[dataObj.getDay()];
  const dataFormatada = partes.reverse().join("/");

%>


     

      <div class="prova-card">

  <h2><%= prova.nome %></h2>

  <small>
    <strong><%= diaSemana %> - <%= dataFormatada %></strong>
  </small>

  <div class="info">

    <p>📌 Tipo: <strong><%= prova.tipo %></strong></p>

    <p>⏳ 
      <% if (diasRestantes > 0) { %>
        Faltam <strong><%= diasRestantes %> dias</strong>
      <% } else if (diasRestantes === 0) { %>
        É hoje!
      <% } else { %>
        Prova já realizada
      <% } %>
    </p>

    <p>💰 Valor: 
      <strong>
        R$ <%= prova.valor_inscricao ? Number(prova.valor_inscricao).toFixed(2) : "0,00" %>
      </strong>
    </p>

    <p>
      💳 Pagamento:
      <% if (prova.pago) { %>
        <span class="badge success">Pago</span>
      <% } else { %>
        <span class="badge warning">Pendente</span>
      <% } %>
    </p>

  </div>


        <div class="card-actions">
          <a href="/provas/<%= prova.id %>/editar" class="btn-secondary">
            Editar
          </a>

          <form action="/provas/<%= prova.id %>/excluir" method="POST">
            <button type="submit" class="btn-danger">
              Excluir
            </button>
          </form>
        </div>

      </div>

      <% }) %>
    </div>

  </div>
</main>

</body>
</html>
