<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Nova Prova - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/nova-prova.css" />

</head>

<body class="page-bg">

<%- include("../../partials/sidebar", { active, userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <h1>🎯 Nova Prova</h1>

    <form action="/provas" method="POST" class="form-prova">

      <div class="form-group">
        <label>Nome da Prova</label>
        <input type="text" name="nome" required>
      </div>

      <div class="form-group">
        <label>Tipo</label>
        <select name="tipo" required>
          <option value="">Selecione</option>
          <option value="Vestibular">Vestibular</option>
          <option value="ENEM">ENEM</option>
          <option value="Outro">Outro</option>
        </select>
      </div>

      <div class="form-group">
        <label>Data da Prova</label>
        <input type="date" name="data_prova_1" required>
      </div>

      <div class="form-group">
        <label>Segunda Data (opcional)</label>
        <input type="date" name="data_prova_2">
      </div>

      <div class="form-group">
        <label>Valor da Inscrição</label>
        <input type="number" name="valor_inscricao" step="0.01">
      </div>

      <div class="form-group">
        <label>
          <input type="checkbox" name="pago">
          Inscrição paga
        </label>
      </div>

      <div class="form-group">
        <label>Local</label>
        <input type="text" name="local">
      </div>

      <div class="form-group">
        <label>Observações</label>
        <textarea name="observacoes"></textarea>
      </div>

      <button type="submit" class="btn-primary">
        Salvar Prova
      </button>

    </form>

  </div>
</main>

</body>
</html>
