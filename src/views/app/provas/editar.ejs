<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Prova - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/editar-prova.css" />

</head>

<body class="page-bg">

<%- include("../../partials/sidebar", { active, userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <div class="page-header">
      <h1>✏️ Editar Prova</h1>
      <a href="/provas" class="btn-secondary">Voltar</a>
    </div>

    <%
      const partes = prova.data_prova_1.split("-");
      const dataFormatada = partes.reverse().join("/");
    %>

    <form action="/provas/<%= prova.id %>/editar" method="POST" class="form-prova">

      <div class="form-group">
        <label>Nome da Prova</label>
        <input type="text" name="nome" value="<%= prova.nome %>" required>
      </div>

      <div class="form-group">
  <label>Tipo</label>
  <select name="tipo" required>
    <option value="Vestibular" <%= prova.tipo === "Vestibular" ? "selected" : "" %>>
      Vestibular
    </option>

    <option value="ENEM" <%= prova.tipo === "ENEM" ? "selected" : "" %>>
      ENEM
    </option>

    <option value="Outro" <%= prova.tipo === "Outro" ? "selected" : "" %>>
      Outro
    </option>
  </select>
</div>


      <div class="form-group">
        <label>Data da Prova</label>
        <input type="date" name="data_prova_1" value="<%= prova.data_prova_1 %>" required>
        <small>Data atual: <strong><%= dataFormatada %></strong></small>
      </div>

      <div class="form-group">
        <label>Valor da Inscrição</label>
        <input type="number" step="0.01" name="valor_inscricao"
          value="<%= prova.valor_inscricao || '' %>">
      </div>

      <div class="form-group">
        <label>Local</label>
        <input type="text" name="local"
          value="<%= prova.local || '' %>">
      </div>

      <div class="form-group">
        <label>Observações</label>
        <textarea name="observacoes"><%= prova.observacoes || '' %></textarea>
      </div>

      <div class="form-group checkbox">
        <label>
          <input type="checkbox" name="pago" <%= prova.pago ? "checked" : "" %>>
          Inscrição paga
        </label>
      </div>

      <button type="submit" class="btn-primary">
        Salvar Alterações
      </button>

    </form>

  </div>
</main>

</body>
</html>
