<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Estatísticas · Simulados", css: ["estatisticas-simulados"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "estatisticas", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📝 Simulados</h1>
        <p>Evolução, áreas e análise de erros.</p>
      </div>
      <a href="/estatisticas" class="btn-ghost btn-sm">← Estatísticas</a>
    </header>

    <!-- FILTRO -->
    <div class="chips">
      <a href="/estatisticas/simulados?periodo=30"    class="chip <%= periodo === '30'    ? 'active' : '' %>">30 dias</a>
      <a href="/estatisticas/simulados?periodo=90"    class="chip <%= periodo === '90'    ? 'active' : '' %>">90 dias</a>
      <a href="/estatisticas/simulados?periodo=180"   class="chip <%= periodo === '180'   ? 'active' : '' %>">6 meses</a>
      <a href="/estatisticas/simulados?periodo=365"   class="chip <%= periodo === '365'   ? 'active' : '' %>">1 ano</a>
      <a href="/estatisticas/simulados?periodo=total" class="chip <%= periodo === 'total' ? 'active' : '' %>">∞ Total</a>
    </div>

    <!-- KPIs -->
    <section class="grid-4">
      <div class="card kpi">
        <h3>Simulados</h3>
        <p class="value"><%= totalSimulados %></p>
        <span class="label"><%= simuladosFinalizados %> finalizados · <%= simuladosEmAndamento %> em andamento</span>
      </div>

      <div class="card kpi">
        <h3>Questões</h3>
        <p class="value"><%= totalQuestoes %></p>
        <span class="label">
          <span class="ok">✓ <%= totalAcertos %></span>
          <span class="err">✗ <%= totalErros %></span>
          · <%= aproveitamento %>%
        </span>
      </div>

      <div class="card kpi">
        <h3>Média de acertos</h3>
        <p class="value"><%= mediaAcertos %></p>
        <span class="label">Consistência: <%= consistencia %>%</span>
      </div>

      <div class="card kpi">
        <h3>Tempo total</h3>
        <p class="value"><%= totalTempoMinutos %>min</p>
        <span class="label">
          <%= mediaTempo %>min média · <%= velocidadeMedia %> q/min
        </span>
      </div>
    </section>

    <!-- RANKINGS -->
    <section class="grid-3">

      <div class="card rank-card">
        <h2 class="card-heading">🏆 Melhores</h2>
        <% if (!rankingMelhores.length) { %>
          <p class="muted">Sem simulados.</p>
        <% } else { %>
          <ol class="rank-list">
            <% rankingMelhores.forEach(function(r, i) { %>
              <li>
                <span class="rank-pos"><%= i + 1 %></span>
                <span class="rank-name"><%= r.nome %></span>
                <span class="rank-sub muted"><%= r.acertos %>/<%= r.questoes %></span>
                <span class="rank-val ok"><%= r.percentual %>%</span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>

      <div class="card rank-card">
        <h2 class="card-heading">⚠️ Atenção</h2>
        <% if (!rankingPiores.length) { %>
          <p class="muted">Sem simulados.</p>
        <% } else { %>
          <ol class="rank-list">
            <% rankingPiores.forEach(function(r, i) { %>
              <li>
                <span class="rank-pos"><%= i + 1 %></span>
                <span class="rank-name"><%= r.nome %></span>
                <span class="rank-sub muted"><%= r.acertos %>/<%= r.questoes %></span>
                <span class="rank-val err"><%= r.percentual %>%</span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>

      <div class="card rank-card">
        <h2 class="card-heading">📊 Extremos</h2>
        <div class="extremes">
          <div class="extreme">
            <span class="extreme-ico">🥇</span>
            <div>
              <small>Melhor</small>
              <strong><%= melhorSimulado ? melhorSimulado.nome : "—" %></strong>
              <span class="ok"><%= melhorSimulado ? melhorSimulado.percentual : 0 %>%</span>
            </div>
          </div>
          <div class="extreme">
            <span class="extreme-ico">📉</span>
            <div>
              <small>Pior</small>
              <strong><%= piorSimulado ? piorSimulado.nome : "—" %></strong>
              <span class="err"><%= piorSimulado ? piorSimulado.percentual : 0 %>%</span>
            </div>
          </div>
          <div class="extreme">
            <span class="extreme-ico">💪</span>
            <div>
              <small>Área mais forte</small>
              <strong><%= areaMaisForte && areaMaisForte.nome ? areaMaisForte.nome : "—" %></strong>
              <span class="ok"><%= areaMaisForte ? areaMaisForte.percentual : 0 %>%</span>
            </div>
          </div>
          <div class="extreme">
            <span class="extreme-ico">🎯</span>
            <div>
              <small>Área a melhorar</small>
              <strong><%= areaMaisFraca && areaMaisFraca.nome ? areaMaisFraca.nome : "—" %></strong>
              <span class="err"><%= areaMaisFraca ? areaMaisFraca.percentual : 0 %>%</span>
            </div>
          </div>
        </div>
      </div>

    </section>

    <!-- GRÁFICOS -->
    <section class="grid-2">
      <div class="card">
        <h2 class="card-heading">📊 Acertos vs erros por área</h2>
        <div class="chart-box"><canvas id="chartArea"></canvas></div>
      </div>

      <div class="card">
        <h2 class="card-heading">📈 Evolução · aproveitamento</h2>
        <% if (!evolucao.length) { %>
          <p class="muted empty-note">Sem simulados com questões.</p>
        <% } else { %>
          <div class="chart-box"><canvas id="chartEvolucao"></canvas></div>
        <% } %>
      </div>
    </section>

    <!-- DETALHAMENTO POR ÁREA -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">🎯 Detalhamento por área</h2>
      </div>

      <div class="area-grid">
        <%
          const areaNames = {
            linguagens: "Linguagens", humanas: "Humanas",
            naturezas: "Naturezas",  matematica: "Matemática"
          };
          const areaIcons = {
            linguagens: "📖", humanas: "🏛️", naturezas: "🔬", matematica: "➗"
          };
        %>
        <% Object.entries(porArea).forEach(function([key, d]) { %>
          <article class="card area-card">
            <header class="area-head">
              <span class="area-ico"><%= areaIcons[key] %></span>
              <h3 class="area-name"><%= areaNames[key] %></h3>
              <span class="badge <%= d.percentual >= 70 ? 'badge-ok' : d.percentual >= 50 ? 'badge-warn' : 'badge-err' %>">
                <%= d.percentual %>%
              </span>
            </header>

            <div class="area-stats">
              <div><small>Questões</small><strong class="num"><%= d.questoes %></strong></div>
              <div><small>Acertos</small><strong class="num ok"><%= d.acertos %></strong></div>
              <div><small>Erros</small><strong class="num err"><%= d.erros %></strong></div>
              <div><small>Tempo médio</small><strong class="num"><%= d.tempoMedio %>min</strong></div>
            </div>

            <div class="progress"><span style="width: <%= d.percentual %>%"></span></div>

            <div class="area-foot muted">
              <span>📅 <%= d.simulados %> simulados</span>
              <span>⚡ <%= d.velocidade %> q/min</span>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <!-- ANÁLISE DE ERROS -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">❌ Análise de erros</h2>
      </div>

      <div class="err-block">
        <div class="err-kpis">
          <div class="card kpi">
            <h3>Total</h3>
            <p class="value"><%= errosTotal %></p>
            <span class="label">Erros registrados</span>
          </div>
          <div class="card kpi">
            <h3>Revisados</h3>
            <p class="value ok"><%= errosRevisados %></p>
            <span class="label"><%= taxaRevisao %>% do total</span>
          </div>
          <div class="card kpi">
            <h3>Pendentes</h3>
            <p class="value err"><%= errosPendentes %></p>
            <span class="label">A revisar</span>
          </div>
          <div class="card kpi">
            <h3>Motivo dominante</h3>
            <p class="value small"><%= motivoDominante ? motivoDominante.replace('_', ' ') : '—' %></p>
            <span class="label">Mais frequente</span>
          </div>
        </div>

        <div class="card motivos-card">
          <h2 class="card-heading">📋 Erros por motivo</h2>
          <div class="motivos-list">
            <%
              const motivos = [
                { key: "falta_conteudo", label: "Falta de conteúdo" },
                { key: "falta_atencao",  label: "Falta de atenção" },
                { key: "lacuna",         label: "Lacuna" },
              ];
            %>
            <% motivos.forEach(function(m) { %>
              <div class="motivo-row">
                <span class="motivo-label"><%= m.label %></span>
                <div class="progress motivo-bar">
                  <span style="width: <%= errosTotal > 0 ? Math.round((errosPorMotivo[m.key] / errosTotal) * 100) : 0 %>%"></span>
                </div>
                <span class="motivo-val num"><%= errosPorMotivo[m.key] %></span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <!-- LACUNAS -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">🔍 Lacunas de conteúdo</h2>
      </div>

      <div class="grid-2">
        <div class="card">
          <h2 class="card-heading">📘 Por matéria</h2>
          <% if (!lacunas.materias.length) { %>
            <p class="muted">Nenhuma lacuna registrada.</p>
          <% } else { %>
            <ul class="lac-list">
              <% lacunas.materias.forEach(function(l) { %>
                <li><span><%= l.nome %></span><strong class="num"><%= l.total %></strong></li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="card">
          <h2 class="card-heading">📗 Por tópico</h2>
          <% if (!lacunas.topicos.length) { %>
            <p class="muted">Nenhuma lacuna registrada.</p>
          <% } else { %>
            <ul class="lac-list">
              <% lacunas.topicos.forEach(function(l) { %>
                <li><span><%= l.nome %></span><strong class="num"><%= l.total %></strong></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </section>

    <!-- TABELA -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">📊 Histórico</h2>
        <span class="muted"><%= evolucao.length %> simulados</span>
      </div>

      <% if (!evolucao.length) { %>
        <div class="empty-state">
          <div class="empty-icon">📊</div>
          <h3>Nenhum simulado com questões ainda</h3>
          <p>Preencha a grade de um simulado para ver o histórico.</p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Simulado</th>
                <th>Status</th>
                <th>Data</th>
                <th>Questões</th>
                <th>Acertos</th>
                <th>Erros</th>
                <th>%</th>
                <th>Δ</th>
                <th>M. móvel</th>
                <th>Tempo</th>
              </tr>
            </thead>
            <tbody>
              <% evolucao.forEach(function(e) { %>
                <tr>
                  <td><%= e.nome %></td>
                  <td>
                    <span class="badge <%= e.status === 'finalizado' ? 'badge-ok' : 'badge-warn' %>">
                      <%= e.status === 'finalizado' ? '✓ Finalizado' : '⏳ Em andamento' %>
                    </span>
                  </td>
                  <td><%= e.data.split('-').reverse().join('/') %></td>
                  <td><%= e.questoes %></td>
                  <td class="ok"><%= e.acertos %></td>
                  <td class="err"><%= e.erros %></td>
                  <td>
                    <span class="badge <%= e.percentual >= 70 ? 'badge-ok' : e.percentual >= 50 ? 'badge-warn' : 'badge-err' %>">
                      <%= e.percentual %>%
                    </span>
                  </td>
                  <td>
                    <% if (e.delta > 0) { %>
                      <span class="ok">+<%= e.delta %>%</span>
                    <% } else if (e.delta < 0) { %>
                      <span class="err"><%= e.delta %>%</span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td><%= e.mediaMovel %>%</td>
                  <td><%= e.tempo || 0 %>min</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  window.SIMSTATS = {
    porArea: <%- JSON.stringify(porArea || {}).replace(/</g, '\\u003c') %>,
    evolucao: <%- JSON.stringify(evolucao || []).replace(/</g, '\\u003c') %>
  };
</script>
<script src="/public/js/app/estatisticas-simulados.js"></script>

</body>
</html>