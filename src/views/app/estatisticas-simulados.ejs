<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>KMed | Estatísticas de Simulados</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/estatisticas-simulados.css">
</head>

<body class="page-bg">

<%- include("../partials/sidebar", {
  active: "estatisticas",
  userNome,
  userFoto
}) %>

<main class="with-sidebar">
<section class="page estatisticas-simulados">

<!-- =========================
     TOPO
========================= -->
<header class="topo">
  <h1>🧪 Estatísticas de Simulados</h1>
  <p class="sub">Análise real do seu desempenho em prova</p>
</header>

<!-- =========================
     RESUMO GERAL
========================= -->
<div class="cards">
  <div class="card">
    <span>Total de simulados</span>
    <strong><%= totalSimulados %></strong>
  </div>

  <div class="card">
    <span>Acertos totais (180)</span>
    <strong><%= acertosTotais %></strong>
  </div>

  <div class="card danger">
    <span>Total de erros</span>
    <strong><%= totalErros %></strong>
  </div>

  <div class="card ok">
    <span>Proficiência média</span>
    <strong><%= proficiencia %>%</strong>
  </div>
</div>

<!-- =========================
     MÉDIAS E LEITURA GERAL
========================= -->
<section class="block">
  <h2>Resumo de desempenho</h2>

  <div class="comparacao">
    <div class="box">
      <span>Média de acertos por simulado</span>
      <strong><%= mediaAcertos %></strong>
    </div>

    <div class="box">
      <span>Área mais forte</span>
      <strong><%= areaMaisForte.area %></strong>
    </div>

    <div class="box">
      <span>Área mais fraca</span>
      <strong><%= areaMaisFraca.area %></strong>
    </div>
  </div>

  <% if (piorDia !== "EQUILIBRADO") { %>
    <p class="dica">
      ⚠️ Seu maior ponto de atenção está no <strong><%= piorDia === "DIA_1" ? "Dia 1" : "Dia 2" %></strong>.
    </p>
  <% } else { %>
    <p class="dica ok">✅ Seu desempenho está equilibrado entre os dois dias.</p>
  <% } %>
</section>

<!-- =========================
     ERROS POR ÁREA
========================= -->
<section class="block">
  <h2>Erros por área</h2>

  <% 
    const maxErros = Math.max(...errosPorArea.map(e => e.erros));
  %>

  <div class="ranking">
    <% errosPorArea.forEach(a => {
      const perc = maxErros > 0 ? Math.round((a.erros / maxErros) * 100) : 0;
    %>
      <div class="rank-item <%= a.area === areaMaisFraca.area ? 'critica' : '' %>">
        <div class="info">
          <span class="area"><%= a.area %></span>
          <span class="qtd">
            <%= a.erros %> erros · <%= a.acertos %> acertos
          </span>
        </div>

        <div class="barra">
          <div class="fill" style="width:<%= perc %>%"></div>
        </div>
      </div>
    <% }) %>
  </div>

  <p class="dica">
    🎯 Priorize reforçar <strong><%= areaMaisFraca.area %></strong> para subir sua média geral.
  </p>
</section>

<!-- =========================
     DIA 1 x DIA 2
========================= -->
<section class="block">
  <h2>Dia 1 x Dia 2</h2>

  <div class="comparacao">
    <div class="box">
      <span>Dia 1 (90 questões)</span>
      <strong><%= 90 - dia1 %></strong>
      <small><%= dia1 %> erros</small>
    </div>

    <div class="box">
      <span>Dia 2 (90 questões)</span>
      <strong><%= 90 - dia2 %></strong>
      <small><%= dia2 %> erros</small>
    </div>
  </div>

  <% if (dia1 !== dia2) { %>
    <p class="dica">
      📉 Você tem melhor desempenho no <strong><%= dia1 < dia2 ? "Dia 1" : "Dia 2" %></strong>.
    </p>
  <% } else { %>
    <p class="dica ok">✅ Mesmo nível de desempenho nos dois dias.</p>
  <% } %>
</section>

</section>
</main>

</body>
</html>
