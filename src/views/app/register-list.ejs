<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Dias registrados", css: ["registrar"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "registrar", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <%
      const meses = ["jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"];
      const totH = dias.reduce((s, d) => s + d.total_horas, 0);
      const totQ = dias.reduce((s, d) => s + d.total_questoes, 0);
      const totA = dias.reduce((s, d) => s + d.total_acertos, 0);
      const fmtH = (h) => { const hi = Math.floor(h); return hi + "h " + Math.round((h - hi) * 60) + "min"; };
    %>

    <header class="page-header">
      <div>
        <h1>Dias registrados</h1>
        <p>Veja, edite ou exclua seus dias de estudo.</p>
      </div>
      <a href="/registrar/novo" class="btn-primary">＋ Registrar dia</a>
    </header>

    <section class="grid-4">
      <div class="card kpi"><h3>Dias</h3><p class="value"><%= dias.length %></p></div>
      <div class="card kpi"><h3>Tempo total</h3><p class="value"><%= fmtH(totH) %></p></div>
      <div class="card kpi"><h3>Questões</h3><p class="value"><%= totQ %></p></div>
      <div class="card kpi"><h3>Acerto geral</h3><p class="value"><%= totQ > 0 ? Math.round(totA / totQ * 100) + "%" : "—" %></p></div>
    </section>

    <% if (dias.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">✍️</div>
        <h3>Nenhum dia registrado</h3>
        <p>Comece registrando o estudo de hoje.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Data</th><th>Tempo</th><th>Questões</th><th>Acertos</th><th>Taxa</th><th></th></tr>
          </thead>
          <tbody>
            <% dias.forEach(d => {
              const p = d.total_questoes > 0 ? Math.round(d.total_acertos / d.total_questoes * 100) : null;
              const [y, m, dd] = d.data.split("-");
            %>
              <tr>
                <td>
                  <strong><%= dd %> <%= meses[parseInt(m, 10) - 1] %> <%= y %></strong>
                  <% if (d.materias && d.materias.length) { %>
                    <div class="faint" style="font-size: var(--fs-xs);"><%= d.materias.join(", ") %></div>
                  <% } %>
                </td>
                <td><%= fmtH(d.total_horas) %></td>
                <td><%= d.total_questoes %></td>
                <td><%= d.total_acertos %></td>
                <td>
                  <% if (p !== null) { %>
                    <span class="badge <%= p >= 70 ? 'badge-ok' : p >= 50 ? 'badge-warn' : 'badge-err' %>"><%= p %>%</span>
                  <% } else { %><span class="faint">—</span><% } %>
                </td>
                <td>
                  <div class="row" style="justify-content:flex-end; flex-wrap:nowrap;">
                    <a href="/registrar/editar/<%= d.data %>" class="btn btn-sm">✏️ Editar</a>
                    <form method="POST" action="/registrar/excluir/<%= d.data %>" class="inline-form"
                          onsubmit="return confirm('Excluir este dia?')">
                      <button type="submit" class="btn-danger btn-sm">🗑</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

  </div>
</main>

</body>
</html>