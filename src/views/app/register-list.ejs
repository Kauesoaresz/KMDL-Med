<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMed | Dias Registrados</title>

  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/register-list.css" />
</head>

<body class="page-bg">

  <%- include("../partials/sidebar", { 
    active: "registrar", 
    userNome 
  }) %>

  <main class="with-sidebar">
    <div class="page">

      <h1>Dias registrados</h1>
      <a href="/registrar" class="btn-back">← Voltar</a>

      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Horas</th>
            <th>Questões</th>
            <th>Acertos</th>
            <th>%</th>
            <th>Ações</th>
          </tr>
        </thead>

        <tbody>
          <% if (dias.length === 0) { %>
            <tr class="empty">
              <td colspan="6">Nenhum dia registrado</td>
            </tr>
          <% } %>

          <% dias.forEach(d => { 
            const percent = d.total_questoes > 0
              ? ((d.total_acertos / d.total_questoes) * 100).toFixed(1)
              : 0;

            const percentClass =
              percent >= 85 ? "good" :
              percent >= 70 ? "medium" :
              "bad";

            // 🔥 FORMATAÇÃO SEGURA DA DATA (SEM Date())
            const [year, month, day] = d.data.split("-");
            const meses = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
            const mesLabel = meses[parseInt(month, 10) - 1];
          %>

            <tr>
              <td data-label="Data">
                <strong style="font-size:1rem">
                  <%= `${day} ${mesLabel} ${year}` %>
                </strong>

                <% if (d.materias && d.materias.length) { %>
                  <div style="font-size:.7rem;opacity:.6;margin-top:2px">
                    <%= d.materias.join(", ") %>
                  </div>
                <% } %>
              </td>

              <td data-label="Horas">
                <% 
                  const horas = d.total_horas;
                  const horasInt = Math.floor(horas);
                  const minutos = Math.round((horas - horasInt) * 60);
                %>
                <%= horasInt %>h <%= minutos %>min
              </td>
              <td data-label="Questões"><%= d.total_questoes %></td>
              <td data-label="Acertos"><%= d.total_acertos %></td>

              <td data-label="%">
                <span class="percent <%= percentClass %>">
                  <%= percent %>%
                </span>
              </td>

              <td data-label="Ações" class="actions">
                <a href="/registrar/editar/<%= d.data %>">✏️ Editar</a>

                <form 
                  method="POST" 
                  action="/registrar/excluir/<%= d.data %>" 
                  onsubmit="return confirm('Deseja realmente excluir este dia?')">
                  <button type="submit">🗑 Excluir</button>
                </form>
              </td>
            </tr>

          <% }) %>
        </tbody>
      </table>

    </div>
  </main>

</body>
</html>
