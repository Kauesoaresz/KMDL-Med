<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KMed | Conquistas</title>

  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/conquistas.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "conquistas", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- Header -->
    <div class="page-header">
      <div class="header-text">
        <h1>🏆 Conquistas</h1>
        <p class="subtitle">Veja todas as suas conquistas e emblemas desbloqueados</p>
      </div>
      <a href="/dashboard" class="btn-back">← Voltar</a>
    </div>

    <!-- Card de Progresso -->
    <div class="progress-card">
      <div class="progress-header">
        <div class="level-badge">
          <span class="level-number"><%= progress.nivel %></span>
          <span class="level-label">NÍVEL</span>
        </div>
        <div class="progress-info">
          <h2><%= progress.titulo %></h2>
          <p class="xp-text">
            <span class="xp-atual"><%= progress.xp_total.toLocaleString('pt-BR') %></span> XP Total
          </p>
        </div>
      </div>
      
      <div class="progress-bar-container">
        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= Math.round((progress.xp_atual / progress.xp_proximo_nivel) * 100) %>%"></div>
        </div>
        <div class="progress-text">
          <%= progress.xp_atual.toLocaleString('pt-BR') %> / <%= progress.xp_proximo_nivel.toLocaleString('pt-BR') %> XP para próximo nível
        </div>
      </div>
      
      <div class="progress-stats">
        <div class="stat">
          <i class="fas fa-fire"></i>
          <span class="stat-value"><%= progress.streak_atual || 0 %></span>
          <span class="stat-label">Dias Seguidos</span>
        </div>
        <div class="stat">
          <i class="fas fa-trophy"></i>
          <span class="stat-value"><%= conquistadasCount %></span>
          <span class="stat-label">Conquistas</span>
        </div>
        <div class="stat">
          <i class="fas fa-star"></i>
          <span class="stat-value"><%= totalConquistas %></span>
          <span class="stat-label">Total</span>
        </div>
      </div>
    </div>

    <!-- Detalhamento de XP -->
    <div class="quick-stats">
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.horas.valor %></span>
        <span class="qs-label">Horas Estudo</span>
        <span class="qs-xp">+<%= detalhamentoXP.horas.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.questoesCertas.valor %></span>
        <span class="qs-label">Q. Certas</span>
        <span class="qs-xp">+<%= detalhamentoXP.questoesCertas.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.questoesErradas.valor %></span>
        <span class="qs-label">Q. Erradas</span>
        <span class="qs-xp">+<%= detalhamentoXP.questoesErradas.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.simulados.valor %></span>
        <span class="qs-label">Simulados</span>
        <span class="qs-xp">+<%= detalhamentoXP.simulados.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.revisoes.valor %></span>
        <span class="qs-label">Revisões</span>
        <span class="qs-xp">+<%= detalhamentoXP.revisoes.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.metas.valor %></span>
        <span class="qs-label">Metas</span>
        <span class="qs-xp">+<%= detalhamentoXP.metas.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
      <div class="quick-stat">
        <span class="qs-value"><%= detalhamentoXP.conquistas.xp > 0 ? '✓' : '0' %></span>
        <span class="qs-label">Conquistas</span>
        <span class="qs-xp">+<%= detalhamentoXP.conquistas.xp.toLocaleString('pt-BR') %> XP</span>
      </div>
    </div>

    <!-- Filtro de Conquistas -->
    <div class="conquistas-filter">
      <label class="filter-label">Filtrar por categoria:</label>
      <select id="categoriaFilter" class="filter-select">
        <option value="todas">Todas as Conquistas</option>
        <option value="horas">Horas de Estudo</option>
        <option value="questoes">Questões</option>
        <option value="acertos">Acertos</option>
        <option value="materias">Matérias</option>
        <option value="topicos">Tópicos</option>
        <option value="blocos">Blocos</option>
        <option value="erros_revisados">Erros Revisados</option>
        <option value="fds">Fim de Semana</option>
        <option value="maratonas">Maratonas</option>
        <option value="perfeitos">Perfeitos</option>
        <option value="volume">Volume Diário</option>
        <option value="estudo_diario">Estudo Diário</option>
        <option value="diversidade">Diversidade</option>
        <option value="consistencia_semanal">Consistência Semanal</option>
        <option value="highscore">Highscore</option>
        <option value="nota_simulado">Nota Simulado</option>
        <option value="dia_semana">Dia da Semana</option>
      </select>
    </div>

    <!-- Conquistas Desbloqueadas -->
    <% if (conquistadas && conquistadas.length > 0) { %>
      <section class="section">
        <h2 class="section-title">
          <i class="fas fa-check-circle"></i>
          Conquistas Desbloqueadas
          <span class="count"><%= conquistadas.length %></span>
        </h2>
        
        <div class="conquistas-grid">
          <% conquistadas.forEach(function(c) { %>
            <div class="conquista-card desbloqueada" data-categoria="<%= c.categoria || '' %>" title="<%= c.descricao %>">
              <div class="conquista-icone"><%= c.icone %></div>
              <div class="conquista-info">
                <h3><%= c.titulo %></h3>
                <p><%= c.descricao %></p>
              </div>
              <div class="conquista-bonus">
                <span class="xp-badge">+<%= c.xp_bonus %> XP</span>
                <span class="dificuldade-badge <%= c.dificuldade %>"><%= c.dificuldade %></span>
              </div>
              <div class="conquista-date">
                <i class="fas fa-calendar"></i>
                <%= new Date(c.data_conquista).toLocaleDateString('pt-BR') %>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Conquistas Não Desbloqueadas -->
    <% if (naoConquistadas && naoConquistadas.length > 0) { %>
      <section class="section">
        <h2 class="section-title">
          <i class="fas fa-lock"></i>
          Conquistas Não Desbloqueadas
          <span class="count"><%= naoConquistadas.length %></span>
        </h2>
        
        <div class="conquistas-grid">
          <% naoConquistadas.forEach(function(c) { %>
            <div class="conquista-card bloqueada" data-categoria="<%= c.categoria || '' %>" title="<%= c.descricao %>">
              <div class="conquista-icone"><%= c.icone %></div>
              <div class="conquista-info">
                <h3><%= c.titulo %></h3>
                <p><%= c.descricao %></p>
              </div>
              <div class="conquista-progress">
                <div class="progress-mini">
                  <div class="progress-mini-fill" style="width: <%= c.percentual %>%"></div>
                </div>
                <span class="progress-mini-text"><%= c.progresso %> / <%= c.meta %></span>
              </div>
              <div class="conquista-bonus">
                <span class="xp-badge">+<%= c.xp_bonus %> XP</span>
                <span class="dificuldade-badge <%= c.dificuldade %>"><%= c.dificuldade %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Empty State -->
    <% if ((!conquistadas || conquistadas.length === 0) && (!naoConquistadas || naoConquistadas.length === 0)) { %>
      <div class="empty-state">
        <div class="empty-icon">🎮</div>
        <h3>Carregando conquistas...</h3>
        <p>Continue estudando para desbloquear suas primeiras conquistas!</p>
      </div>
    <% } %>

  </div>
</main>

<script>
  // Filtro de Conquistas
  const categoriaFilter = document.getElementById('categoriaFilter');
  const conquistaCards = document.querySelectorAll('.conquista-card');
  
  if (categoriaFilter) {
    categoriaFilter.addEventListener('change', function() {
      const categoriaSelecionada = this.value;
      
      conquistaCards.forEach(card => {
        const categoriaCard = card.getAttribute('data-categoria');
        
        if (categoriaSelecionada === 'todas' || categoriaCard === categoriaSelecionada) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>

</body>
</html>

