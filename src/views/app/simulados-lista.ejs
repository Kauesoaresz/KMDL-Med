<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>KMed | Meus Simulados</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/simulados-lista.css">
</head>

<body class="page-bg">

<%- include("../partials/sidebar", {
  active: "simulados",
  userNome,
  userFoto
}) %>

<main class="with-sidebar">
<section class="page simulados-lista">

<header class="kmed-header">
  <h1>Meus Simulados</h1>
  <p>Acompanhe, edite, continue ou exclua seus simulados.</p>
</header>

<a href="/simulados" class="btn-voltar">← Voltar ao hub</a>

<% if (!simulados || simulados.length === 0) { %>
  <p class="vazio">Nenhum simulado cadastrado ainda.</p>
<% } else { %>

<div class="lista-simulados">

<% simulados.forEach(simulado => { 
  const partes = simulado.partes || [];

  const porDia = {};
  partes.forEach(p => {
    if (!porDia[p.dia]) {
      porDia[p.dia] = {
        tempo: p.tempo_minutos,
        areas: []
      };
    }
    porDia[p.dia].areas.push(p.area);
  });

  const fezDia1 = !!porDia["DIA_1"];
  const fezDia2 = !!porDia["DIA_2"];
%>

<div class="simulado-card <%= simulado.status === 'FINALIZADO' ? 'finalizado' : 'andamento' %>">

  <!-- CABEÇALHO -->
  <div class="simulado-header">
    <strong><%= simulado.nome %></strong>
    <span class="badge <%= simulado.status === 'FINALIZADO' ? 'badge-ok' : 'badge-warn' %>">
      <%= simulado.status === "FINALIZADO" ? "Finalizado" : "Em andamento" %>
    </span>
  </div>

  <!-- INFO -->
  <div class="simulado-info">
    <span>Tipo: <strong><%= simulado.tipo %></strong></span>
    <span>Dias feitos:
      <strong>
        Dia 1 <%= fezDia1 ? "✔" : "—" %> |
        Dia 2 <%= fezDia2 ? "✔" : "—" %>
      </strong>
    </span>
  </div>

  <!-- DIAS -->
  <div class="simulado-partes">
    <% Object.keys(porDia).forEach(dia => { %>
      <div class="parte">
        <strong><%= dia === "DIA_1" ? "Dia 1" : "Dia 2" %></strong>
        — <%= porDia[dia].tempo %> min
        <div class="areas">
          <% porDia[dia].areas.forEach(a => { %>
            <span class="area"><%= a %></span>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- AÇÕES -->
  <div class="simulado-acoes">
    <% if (simulado.status === "EM_ANDAMENTO") { %>
      <a href="/simulados/novo?simulado_id=<%= simulado.id %>" class="btn-secundario">
        Editar / Continuar
      </a>
    <% } %>

    <a href="/simulados/<%= simulado.id %>/erros" class="btn-primario">
      Ver erros
    </a>

    <form action="/simulados/<%= simulado.id %>/deletar" method="POST" onsubmit="return confirm('Deseja realmente excluir este simulado?');">
      <button type="submit" class="btn-danger">
        Deletar
      </button>
    </form>
  </div>

</div>

<% }) %>

</div>
<% } %>

</section>
</main>

</body>
</html>
