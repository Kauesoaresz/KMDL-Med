<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Calendário", css: ["calendario"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "calendario", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- TOPO -->
    <header class="page-header">
      <div>
        <h1>Calendário de Estudos</h1>
        <p>Sua constância, mês a mês.</p>
      </div>

      <div class="streak">
        <span class="streak-icon">🔥</span>
        <div>
          <strong class="num"><%= streak %></strong>
          <small><%= streak === 1 ? "dia seguido" : "dias seguidos" %></small>
        </div>
      </div>
    </header>

    <!-- RESUMO DO MÊS -->
    <%
      const fmtH = (h) => {
        h = h || 0;
        const hi = Math.floor(h);
        const mi = Math.round((h - hi) * 60);
        return hi + "h " + mi + "min";
      };
    %>
    <section class="grid-3">
      <div class="card kpi">
        <h3>Total de horas</h3>
        <p class="value"><%= fmtH(totalHorasMes) %></p>
        <span class="label"><%= diasEstudados %> <%= diasEstudados === 1 ? "dia estudado" : "dias estudados" %></span>
      </div>

      <div class="card kpi">
        <h3>Questões</h3>
        <p class="value"><%= totalQuestoesMes %></p>
        <span class="label"><%= acertoPctMes %>% de acerto</span>
      </div>

      <div class="card kpi">
        <h3>Média / dia</h3>
        <p class="value"><%= fmtH(mediaDiaria) %></p>
        <span class="label"><%= mediaDiariaQuestoes %> questões / dia</span>
      </div>
    </section>

    <!-- DIAGNÓSTICO -->
    <% if (diagnostico) { %>
      <div class="card cal-diag diag-<%= diagnostico.nivel %>">
        <div class="cal-diag-head">
          <h2 class="card-heading">🩺 Matéria mais estudada</h2>
          <span class="badge badge-accent"><%= diagnostico.materia %></span>
        </div>
        <div class="cal-diag-stats">
          <div><small>Tempo</small><strong class="num"><%= diagnostico.horas %></strong></div>
          <div><small>% do tempo</small><strong class="num"><%= diagnostico.share %>%</strong></div>
          <div><small>Questões</small><strong class="num"><%= diagnostico.questoes %></strong></div>
          <div><small>Acerto</small><strong class="num"><%= diagnostico.acertoPct %>%</strong></div>
        </div>
        <p class="muted cal-diag-text"><%= diagnostico.texto %></p>
      </div>
    <% } else { %>
      <div class="card">
        <h2 class="card-heading">🩺 Matéria mais estudada</h2>
        <p class="muted">Sem dados suficientes neste mês.</p>
      </div>
    <% } %>

    <!-- NAVEGAÇÃO DO MÊS + MODOS -->
    <div class="cal-bar">
      <div class="cal-nav">
        <a href="/calendario?ano=<%= anoAnterior %>&mes=<%= mesAnterior %>" class="btn-ghost btn-sm">⬅ Mês anterior</a>
        <strong class="cal-month"><%= mesLabel %></strong>
        <a href="/calendario?ano=<%= anoProximo %>&mes=<%= mesProximo %>" class="btn-ghost btn-sm">Próximo mês ➜</a>
      </div>

      <div class="chips" id="cal-modes">
        <button type="button" data-mode="horas" class="chip active">⏱ Horas</button>
        <button type="button" data-mode="questoes" class="chip">📝 Questões</button>
        <button type="button" data-mode="lendario" class="chip">🔥 Lendário</button>
      </div>
    </div>

    <!-- GRADE -->
    <div class="cal-card">
      <div class="cal-weekdays">
        <span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span>
      </div>

      <div class="kmed-calendar-grid" id="cal-grid">
        <% diasMes.forEach(d => { %>
          <button
            type="button"
            class="kmed-cal-day <%= d.cor %> <%= d.isHoje ? 'today' : '' %> <%= d.futuro ? 'future' : '' %> <%= d.perfeito ? 'perfect' : '' %>"
            data-dia="<%= d.dia %>"
            data-h="<%= d.cor %>"
            data-q="<%= d.corQuestoes %>"
            data-l="<%= d.corLendario %>"
            <%= d.futuro ? 'disabled' : '' %>
          >
            <span class="day-number"><%= d.dia %></span>

            <% if (d.iconeLendario) { %>
              <span class="day-icon"><%= d.iconeLendario %></span>
            <% } %>

            <% if (d.horas && d.horas !== '0h 0min') { %>
              <span class="day-hours"><%= d.horas %></span>
            <% } %>

            <% if (d.questoes && d.questoes > 0) { %>
              <span class="day-stats">
                <span class="day-stats-questoes">Q<%= d.questoes %></span>
                <span class="day-stats-acerto"><%= Math.round(d.acertoPct) %>%</span>
              </span>
            <% } %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- LEGENDAS -->
    <div class="kmed-calendar-legend" data-legend="horas">
      <span><i class="h12"></i> 12h</span>
      <span><i class="h11"></i> 11h</span>
      <span><i class="h10"></i> 10h</span>
      <span><i class="h9"></i> 9h</span>
      <span><i class="h8"></i> 8h</span>
      <span><i class="h7"></i> 7h</span>
      <span><i class="h6"></i> 6h</span>
      <span><i class="h5"></i> 5h</span>
      <span><i class="h4"></i> 4h</span>
      <span><i class="h3"></i> 3h</span>
      <span><i class="h2"></i> 2h</span>
      <span><i class="h1"></i> 1h</span>
      <span><i class="zero"></i> 0h</span>
    </div>

    <div class="kmed-calendar-legend" data-legend="questoes" style="display:none;">
      <% for (let i = 12; i >= 1; i--) { %>
        <span><i class="h<%= i %>"></i> <%= i === 12 ? '111+' : ((i - 1) * 10 + 1) + '–' + (i * 10) %> q</span>
      <% } %>
      <span><i class="zero"></i> 0</span>
    </div>

    <div class="kmed-calendar-legend" data-legend="lendario" style="display:none;">
      <% niveisLendario.slice().reverse().forEach(n => { %>
        <span title="<%= n.regra %>"><i class="<%= n.classe %>"></i> <%= n.icone %> <%= n.label %> <em>(<%= n.regra %>)</em></span>
      <% }) %>
    </div>

  </div>
</main>

<!-- MODAL DO DIA -->
<div class="cal-modal-bg" id="cal-modal">
  <div class="cal-modal-box">
    <button type="button" class="cal-modal-close" id="cal-modal-close" aria-label="Fechar">×</button>
    <h3 id="cal-m-title"></h3>
    <div id="cal-m-body"></div>
    <div class="cal-modal-actions">
      <a id="cal-m-edit" href="#" class="btn-primary btn-sm">✏️ Editar dia</a>
    </div>
  </div>
</div>

<script>
  window.CAL = {
    dias: <%- JSON.stringify(diasMes.map(d => ({
      dia: d.dia,
      data: d.dataISO,
      horas: d.horas,
      horasNum: d.horasNum,
      questoes: d.questoes,
      acertos: d.acertos,
      erros: d.erros,
      acertoPct: d.acertoPct,
      nivel: d.labelLendario,
      icone: d.iconeLendario,
      materias: d.materias
    }))).replace(/</g, '\\u003c') %>
  };
</script>
<script src="/public/js/app/calendario.js"></script>

</body>
</html>