<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>KMed | Estatísticas</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Prevent flash of wrong theme -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('kmed-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (!savedTheme && !prefersDark || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="stylesheet" href="/public/css/components/theme.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/statistics.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="page-bg">

  <%- include("../partials/sidebar", { 
    active: "estatisticas", 
    userNome, 
    userFoto 
  }) %>

  <main class="with-sidebar">
    <div class="page statistics-page">

      <!-- HEADER -->
      <header class="stats-header">
        <div class="header-content">
          <h1>📊 Seu Painel de Estudos</h1>
          <p class="sub">Acompanhe sua evolução e conquiste seus objetivos</p>
        </div>
        
        <!-- FILTRO DE PERÍODO -->
        <div class="period-filter">
          <a href="/estatisticas/estudos?period=week" class="filter-btn <%= period === 'week' ? 'active' : '' %>">
            <span class="filter-icon">📅</span> Essa Semana
          </a>
          <a href="/estatisticas/estudos?period=month" class="filter-btn <%= period === 'month' ? 'active' : '' %>">
            <span class="filter-icon">🗓️</span> Esse Mês
          </a>
          <a href="/estatisticas/estudos?period=all" class="filter-btn <%= period === 'all' ? 'active' : '' %>">
            <span class="filter-icon">∞</span> Total
          </a>
        </div>
      </header>

      <!-- LINHA 1: CARDS PRINCIPAIS -->
      <section class="stats-cards-grid">
        <!-- Card Tempo -->
        <div class="stat-card main-card tempo">
          <div class="card-icon">⏱️</div>
          <div class="card-content">
            <span class="card-label">Tempo Estudado</span>
            <div class="card-value">
              <%= formatHours(stats.horas) %>
            </div>
            <div class="card-sub">
              <% if (period === 'week') { %>
                Essa semana
              <% } else if (period === 'month') { %>
                Esse mês
              <% } else { %>
                Total geral
              <% } %>
            </div>
          </div>
          <div class="card-badge">
            <%= formatHours(total.horas) %> total
          </div>
        </div>

        <!-- Card Questões -->
        <div class="stat-card main-card questoes">
          <div class="card-icon">📝</div>
          <div class="card-content">
            <span class="card-label">Questões Resolvidas</span>
            <div class="card-value"><%= stats.questoes %></div>
            <div class="card-sub">
              <span class="acertos-text">✓ <%= stats.acertos %> acertos</span>
              <span class="erros-text">✗ <%= stats.erros %> erros</span>
            </div>
          </div>
          <div class="card-badge warning">
            <%= stats.aproveitamento %>% aproveitamento
          </div>
        </div>

        <!-- Card Streak -->
        <div class="stat-card main-card streak">
          <div class="card-icon">🔥</div>
          <div class="card-content">
            <span class="card-label">Sequência Atual</span>
            <div class="card-value"><%= streak %> <small>dias</small></div>
            <div class="card-sub">
              <% if (streak >= 7) { %>
                Impressionante! 🎉
              <% } else if (streak >= 3) { %>
                Muito bem! 💪
              <% } else { %>
                Continue assim! 🌟
              <% } %>
            </div>
          </div>
          <div class="card-badge streak-badge">
            <%= diasTotal %> dias no total
          </div>
        </div>

        <!-- Card Dias Estudados -->
        <div class="stat-card main-card dias">
          <div class="card-icon">📅</div>
          <div class="card-content">
            <span class="card-label">Dias Estudados</span>
            <div class="card-value"><%= diasEstudados %></div>
            <div class="card-sub">
              <% if (period === 'week') { %>
                Nessa semana
              <% } else if (period === 'month') { %>
                Nesse mês
              <% } else { %>
                Diferentes dias
              <% } %>
            </div>
          </div>
          <div class="card-badge">
            <%= Math.round((diasEstudados / (period === 'week' ? 7 : period === 'month' ? 30 : diasTotal)) * 100) %>% do período
          </div>
        </div>
      </section>

      <!-- LINHA 2: GRÁFICOS -->
      <section class="charts-grid">
        <!-- Evolução -->
        <div class="chart-card evolucao">
          <div class="chart-header">
            <h2>📈 Evolução de Estudos</h2>
            <span class="chart-sub">Últimos 30 dias</span>
          </div>
          <div class="chart-container">
            <canvas id="evolucaoChart"></canvas>
          </div>
        </div>

        <!-- Dia da Semana -->
        <div class="chart-card dia-semana">
          <div class="chart-header">
            <h2>🗓️ Padrão Semanal</h2>
            <span class="chart-sub">Horas por dia da semana</span>
          </div>
          <div class="chart-container">
            <canvas id="diaSemanaChart"></canvas>
          </div>
        </div>
      </section>

      <!-- LINHA 3: DIFICULDADE E TAXA -->
      <section class="stats-row-3">

        <!-- Taxa Geral -->
        <div class="stats-block taxa-block">
          <h2>🎯 Sua Performance</h2>
          <div class="taxa-display">
            <div class="taxa-circle">
              <svg viewBox="0 0 36 36" class="circular-chart">
                <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <path class="circle" stroke-dasharray="<%= stats.aproveitamento %>, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <text x="18" y="20.35" class="percentage"><%= stats.aproveitamento %>%</text>
              </svg>
            </div>
            <div class="taxa-info">
              <div class="taxa-stat">
                <span class="taxa-num"><%= stats.acertos %></span>
                <span class="taxa-label">Acertos</span>
              </div>
              <div class="taxa-stat">
                <span class="taxa-num"><%= stats.erros %></span>
                <span class="taxa-label">Erros</span>
              </div>
              <div class="taxa-stat">
                <span class="taxa-num"><%= stats.questoes %></span>
                <span class="taxa-label">Total</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- LINHA 4: METAS -->
      <section class="stats-row-4">
        <!-- Metas -->
        <div class="stats-block metas-block">
          <h2>🎯 Suas Metas</h2>
          <% if (metas && metas.length > 0) { %>
            <div class="metas-list">
              <% metas.forEach(function(meta) { %>
                <div class="meta-item">
                  <div class="meta-header">
                    <span class="meta-nome"><%= meta.nome %></span>
                    <span class="meta-dias"><%= meta.dias_restantes %> dias restantes</span>
                  </div>
                  <div class="meta-progress">
                    <div class="meta-bar">
                      <div class="meta-fill" style="width: <%= meta.progresso_horas %>%"></div>
                    </div>
                    <span class="meta-percent"><%= meta.progresso_horas %>%</span>
                  </div>
                  <div class="meta-details">
                    <%
                      const metaHorasConcluidas = meta.horasConcluidas || 0;
                      const metaHorasInt = Math.floor(metaHorasConcluidas);
                      const metaMinutosInt = Math.round((metaHorasConcluidas - metaHorasInt) * 60);
                    %>
                    <span>⏱️ <%= metaHorasInt %>h <%= metaMinutosInt %>min / <%= meta.meta_horas %>h</span>
                    <% if (meta.meta_questoes > 0) { %>
                      <span>📝 <%= meta.questoesConcluidas %> / <%= meta.meta_questoes %></span>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <p>Você não tem metas ativas no momento.</p>
              <a href="/metas" class="btn-criar-meta">Criar Meta</a>
            </div>
          <% } %>
        </div>

      </section>

      <!-- LINHA 6: ESTATÍSTICAS GERAIS -->
      <section class="stats-gerais">
        <div class="stats-block geral-block">
          <h2>📋 Resumo Geral</h2>
          <div class="geral-grid">
            <div class="geral-item">
              <span class="geral-icon">⏱️</span>
              <div class="geral-info">
                <%
                  const horasTotais = horasTotal;
                  const horasTotaisInt = Math.floor(horasTotais);
                  const minutosTotais = Math.round((horasTotais - horasTotaisInt) * 60);
                %>
                <span class="geral-value"><%= horasTotaisInt %>h <%= minutosTotais %>min</span>
                <span class="geral-label">Horas Totais</span>
              </div>
            </div>
            <div class="geral-item">
              <span class="geral-icon">📝</span>
              <div class="geral-info">
                <span class="geral-value"><%= questoesTotal %></span>
                <span class="geral-label">Questões Totais</span>
              </div>
            </div>
            <div class="geral-item">
              <span class="geral-icon">📅</span>
              <div class="geral-info">
                <span class="geral-value"><%= diasTotal %></span>
                <span class="geral-label">Dias Estudados</span>
              </div>
            </div>
            <div class="geral-item">
              <span class="geral-icon">🔥</span>
              <div class="geral-info">
                <span class="geral-value"><%= streakGeral %></span>
                <span class="geral-label">Sequência Atual</span>
              </div>
            </div>
            <div class="geral-item">
              <span class="geral-icon">🎯</span>
              <div class="geral-info">
                <span class="geral-value"><%= taxaGeral %>%</span>
                <span class="geral-label">Taxa Geral</span>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // Dados do servidor
    const evolucaoData = <%- JSON.stringify(evolucao || []) %>;
    const horasPorDia = <%- JSON.stringify(horasPorDia || [0,0,0,0,0,0,0]) %>;
    const questoesPorDia = <%- JSON.stringify(questoesPorDia || [0,0,0,0,0,0,0]) %>;

    // Gráfico de Evolução
    const ctxEvolucao = document.getElementById('evolucaoChart');
    if (ctxEvolucao) {
      new Chart(ctxEvolucao, {
        type: 'line',
        data: {
          labels: evolucaoData.map(e => e.label),
          datasets: [{
            label: 'Horas',
            data: evolucaoData.map(e => e.horas),
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointBackgroundColor: '#3b82f6'
          }, {
            label: 'Questões',
            data: evolucaoData.map(e => e.questoes),
            borderColor: '#22c55e',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointBackgroundColor: '#22c55e',
            yAxisID: 'y1'
          }]
        },
        options: {
          responsive: true,
          interaction: {
            mode: 'index',
            intersect: false,
          },
          scales: {
            y: {
              beginAtZero: true,
              title: { display: true, text: 'Horas', color: '#9ca3af' },
              grid: { color: 'rgba(255,255,255,0.1)' },
              ticks: { color: '#9ca3af' }
            },
            y1: {
              beginAtZero: true,
              position: 'right',
              title: { display: true, text: 'Questões', color: '#9ca3af' },
              grid: { drawOnChartArea: false },
              ticks: { color: '#9ca3af' }
            },
            x: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#9ca3af' }
            }
          },
          plugins: {
            legend: {
              labels: { color: '#e5e7eb' }
            }
          }
        }
      });
    }

    // Gráfico Dia da Semana
    const ctxDiaSemana = document.getElementById('diaSemanaChart');
    if (ctxDiaSemana) {
      const diasLabels = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
      new Chart(ctxDiaSemana, {
        type: 'bar',
        data: {
          labels: diasLabels,
          datasets: [{
            label: 'Horas',
            data: horasPorDia,
            backgroundColor: [
              'rgba(239, 68, 68, 0.8)',
              'rgba(59, 130, 246, 0.8)',
              'rgba(59, 130, 246, 0.8)',
              'rgba(59, 130, 246, 0.8)',
              'rgba(59, 130, 246, 0.8)',
              'rgba(59, 130, 246, 0.8)',
              'rgba(239, 68, 68, 0.8)'
            ],
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: {
              beginAtZero: true,
              title: { display: true, text: 'Horas', color: '#9ca3af' },
              grid: { color: 'rgba(255,255,255,0.1)' },
              ticks: { color: '#9ca3af' }
            },
            x: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#9ca3af' }
            }
          },
          plugins: {
            legend: {
              display: false
            }
          }
        }
      });
    }
  </script>
</body>
</html>

