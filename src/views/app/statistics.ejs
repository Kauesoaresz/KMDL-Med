<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>KMed | Estatísticas</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/statistics.css">
</head>
<body class="page-bg">

  <%- include("../partials/sidebar", { 
    active: "estatisticas", 
    userNome, 
    userFoto 
  }) %>

  <main class="with-sidebar">
    <div class="page statistics-page">

      <!-- HEADER -->
      <header class="stats-header">
        <h1>📊 Estatísticas</h1>
        <p class="sub">Acompanhe seu desempenho em detalhes</p>
      </header>

      <!-- TEMPO DE ESTUDO -->
      <section class="stats-cards">
        <div class="stat-card orange">
  <div class="stat-title">Essa Semana</div>
  <div class="stat-value"><%= semana.horas %>h</div>
  <div class="stat-sub">Últimos 7 dias</div>
</div>

<div class="stat-card purple">
  <div class="stat-title">Esse Mês</div>
  <div class="stat-value"><%= mes.horas %>h</div>
  <div class="stat-sub">Últimos 30 dias</div>
</div>

<div class="stat-card blue">
  <div class="stat-title">Total Geral</div>
  <div class="stat-value"><%= total.horas %>h</div>
  <div class="stat-sub">Desde o início</div>
</div>

      </section>

      <!-- QUESTÕES -->
      <!-- QUESTÕES -->
<section class="stats-block">
  <h2>Relatório de Questões & Desempenho</h2>

  <div class="stats-mini-cards">
    <div class="mini-card">
      <span>Questões</span>
      <strong><%= total.questoes %></strong>
    </div>

    <div class="mini-card success">
      <span>Acertos</span>
      <strong><%= total.acertos %></strong>
    </div>

    <div class="mini-card danger">
      <span>Erros</span>
      <strong><%= total.erros %></strong>
    </div>

    <div class="mini-card warning">
      <span>Aproveitamento</span>
      <strong><%= total.aproveitamento %>%</strong>
    </div>
  </div>
</section>


      <!-- FILTRO -->
      <div class="period-filter">
        <button data-period="7">Semana</button>
        <button data-period="30">Mês</button>
        <button data-period="all" class="active">Total</button>
      </div>

      <!-- MATÉRIAS -->
      <section class="stats-block">
        <h2>Desempenho por Matéria</h2>
        <div id="materias-list" class="stats-list">
          <div class="placeholder">Carregando matérias...</div>
        </div>
      </section>

      <!-- DETALHES -->
      <section class="stats-block">
        <h2 id="detail-title">Detalhes</h2>
        <div id="detail-list" class="stats-list">
          <div class="placeholder">Selecione uma matéria para ver tópicos</div>
        </div>
      </section>

      <!-- GRÁFICO -->
      <section class="stats-block">
        <h2>Aproveitamento por Matéria</h2>
        <canvas id="materiasChart" height="120"></canvas>
      </section>

    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/public/js/app/statistics.js"></script>
</body>
</html>
