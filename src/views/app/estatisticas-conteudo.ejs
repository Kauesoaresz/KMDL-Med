<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Estatísticas · Conteúdo", css: ["estatisticas-conteudo"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "estatisticas", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📘 Conteúdo</h1>
        <p>Desempenho por matéria e por tópico.</p>
      </div>
      <a href="/estatisticas" class="btn-ghost btn-sm">← Estatísticas</a>
    </header>

    <!-- FILTRO -->
    <div class="chips">
      <a href="/estatisticas/conteudo/dashboard?period=week"  class="chip <%= period === 'week'  ? 'active' : '' %>">📅 Semana</a>
      <a href="/estatisticas/conteudo/dashboard?period=month" class="chip <%= period === 'month' ? 'active' : '' %>">🗓 Mês</a>
      <a href="/estatisticas/conteudo/dashboard?period=all"   class="chip <%= period === 'all'   ? 'active' : '' %>">∞ Total</a>
    </div>

    <!-- KPIs -->
    <section class="grid-4">
      <div class="card kpi">
        <h3>Horas</h3>
        <p class="value"><%= formatHours(stats.horas) %></p>
        <span class="label"><%= formatHours(total.horas) %> no total</span>
      </div>

      <div class="card kpi">
        <h3>Questões</h3>
        <p class="value"><%= stats.questoes %></p>
        <span class="label">
          <span class="ok">✓ <%= stats.acertos %></span>
          <span class="err">✗ <%= stats.erros %></span>
          · <%= stats.aproveitamento %>%
        </span>
      </div>

      <div class="card kpi">
        <h3>Matérias ativas</h3>
        <p class="value"><%= materias.length %></p>
        <span class="label"><%= totalTopics %> tópicos estudados</span>
      </div>

      <div class="card kpi">
        <h3>Média geral</h3>
        <p class="value"><%= mediaGeral %>%</p>
        <span class="label">Média entre matérias</span>
      </div>
    </section>

    <!-- RANKINGS -->
    <section class="grid-4">
      <div class="card rank-card">
        <h2 class="card-heading">🏆 Melhores</h2>
        <% if (rankingMelhores.length === 0) { %>
          <p class="muted">Sem dados.</p>
        <% } else { %>
          <ol class="rank-list">
            <% rankingMelhores.slice(0, 5).forEach(function(item, i) { %>
              <li>
                <span class="rank-pos"><%= i + 1 %></span>
                <span class="rank-name"><%= item.nome %></span>
                <span class="rank-val ok"><%= item.aproveitamento %>%</span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>

      <div class="card rank-card">
        <h2 class="card-heading">⚠️ Atenção</h2>
        <% if (rankingAtencao.length === 0) { %>
          <p class="muted">Sem dados.</p>
        <% } else { %>
          <ol class="rank-list">
            <% rankingAtencao.slice(0, 5).forEach(function(item, i) { %>
              <li>
                <span class="rank-pos"><%= i + 1 %></span>
                <span class="rank-name"><%= item.nome %></span>
                <span class="rank-val err"><%= item.aproveitamento %>%</span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>

      <div class="card rank-card">
        <h2 class="card-heading">🔥 Mais horas</h2>
        <% if (rankingHoras.length === 0) { %>
          <p class="muted">Sem dados.</p>
        <% } else { %>
          <ol class="rank-list">
            <% rankingHoras.slice(0, 5).forEach(function(item, i) { %>
              <li>
                <span class="rank-pos"><%= i + 1 %></span>
                <span class="rank-name"><%= item.nome %></span>
                <span class="rank-val"><%= formatHours(item.horas) %></span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>

      <div class="card rank-card">
        <h2 class="card-heading">📝 Mais questões</h2>
        <% if (rankingQuestoes.length === 0) { %>
          <p class="muted">Sem dados.</p>
        <% } else { %>
          <ol class="rank-list">
            <% rankingQuestoes.slice(0, 5).forEach(function(item, i) { %>
              <li>
                <span class="rank-pos"><%= i + 1 %></span>
                <span class="rank-name"><%= item.nome %></span>
                <span class="rank-val"><%= item.questoes %></span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>
    </section>

    <!-- GRÁFICOS -->
    <section class="grid-2">
      <div class="card">
        <h2 class="card-heading">📊 Distribuição por matéria</h2>
        <% if (materias.length === 0) { %>
          <p class="muted empty-note">Sem matérias no período.</p>
        <% } else { %>
          <div class="chart-box"><canvas id="chartDistribuicao"></canvas></div>
        <% } %>
      </div>

      <div class="card">
        <h2 class="card-heading">✓✗ Acertos vs erros (top 5)</h2>
        <% if (materias.length === 0) { %>
          <p class="muted empty-note">Sem matérias no período.</p>
        <% } else { %>
          <div class="chart-box"><canvas id="chartAcertosErros"></canvas></div>
        <% } %>
      </div>
    </section>

    <!-- TABELA COMPLETA -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">📋 Matérias</h2>
        <span class="muted"><%= materias.length %> <%= materias.length === 1 ? "matéria" : "matérias" %></span>
      </div>

      <% if (materias.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📘</div>
          <h3>Nenhuma matéria com estudo no período</h3>
          <p>Registre estudos para ver estatísticas por matéria.</p>
        </div>
      <% } else { %>
        <div class="mat-grid">
          <% materias.forEach(function(m) { %>
            <article class="mat-card">
              <header class="mat-head">
                <h3 class="mat-name"><%= m.nome %></h3>
                <span class="badge <%= m.aproveitamento >= 70 ? 'badge-ok' : m.aproveitamento >= 50 ? 'badge-warn' : 'badge-err' %>">
                  <%= m.aproveitamento %>%
                </span>
              </header>

              <div class="mat-stats">
                <div><small>Horas</small><strong class="num"><%= formatHours(m.horas) %></strong></div>
                <div><small>Questões</small><strong class="num"><%= m.questoes %></strong></div>
                <div><small>Acertos</small><strong class="num ok"><%= m.acertos %></strong></div>
                <div><small>Erros</small><strong class="num err"><%= m.erros %></strong></div>
              </div>

              <div class="progress"><span style="width: <%= m.aproveitamento %>%"></span></div>

              <div class="mat-foot">
                <span class="muted">📅 <%= m.dias_estudados %> dias</span>
                <span class="muted">🕐 <%= m.ultimo_study ? new Date(m.ultimo_study).toLocaleDateString('pt-BR') : 'nunca' %></span>
              </div>

              <% if (m.topicos && m.topicos.length) { %>
                <div class="mat-topics">
                  <% m.topicos.slice(0, 3).forEach(function(t) { %>
                    <span class="topic-pill">
                      <%= t.nome %> <span class="muted"><%= t.aproveitamento %>%</span>
                    </span>
                  <% }) %>
                  <% if (m.topicos.length > 3) { %>
                    <span class="topic-pill muted">+<%= m.topicos.length - 3 %></span>
                  <% } %>
                </div>
              <% } %>

              <a href="/estatisticas/conteudo/<%= m.id %>?period=<%= period %>" class="btn btn-sm mat-open">
                Ver detalhes →
              </a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  window.CONTEUDO = {
    materias: <%- JSON.stringify(materias || []).replace(/</g, '\\u003c') %>
  };
</script>
<script src="/public/js/app/estatisticas-conteudo.js"></script>

</body>
</html>