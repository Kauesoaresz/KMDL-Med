<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>KMed | Revisões</title>

  <!-- Prevent flash of wrong theme -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('kmed-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (!savedTheme && !prefersDark || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/theme.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/revisoes.css" />
</head>

<body class="page-bg">

  <%- include("../partials/sidebar", { 
    active: "revisoes", 
    userNome 
  }) %>

  <main class="with-sidebar">
    <div class="page">

      <div class="page-header">
        <div class="header-text">
          <h1>Revisões</h1>
          <p class="subtitle">Gerencie suas revisões de conteúdo</p>
        </div>
        <a href="/dashboard" class="btn-back">← Voltar</a>
      </div>

      <!-- Filtros -->
      <div class="filters">
        <div class="filter-group">
          <label for="filter-materia">Matéria</label>
          <select id="filter-materia">
            <option value="">Todas as matérias</option>
            <% if (materias && materias.length > 0) { %>
              <% materias.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.nome %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-prioridade">Prioridade</label>
          <select id="filter-prioridade">
            <option value="">Todas</option>
            <option value="alta">Alta</option>
            <option value="media">Média</option>
            <option value="baixa">Baixa</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-status">Status</label>
          <select id="filter-status">
            <option value="">Todos</option>
            <option value="atrasada">Atrasadas</option>
            <option value="hoje">Hoje</option>
            <option value="em_dia">Em dia</option>
          </select>
        </div>

        <div class="filter-stats">
          <div class="stat-item stat-atrasadas">
            <span class="stat-number"><%= revisoesAtrasadas.length %></span>
            <span class="stat-label">Atrasadas</span>
          </div>
          <div class="stat-item stat-hoje">
            <span class="stat-number"><%= revisoesHoje.length %></span>
            <span class="stat-label">Hoje</span>
          </div>
          <div class="stat-item stat-outras">
            <span class="stat-number"><%= outrasRevisoes.length %></span>
            <span class="stat-label">Em dia</span>
          </div>
        </div>
      </div>

      <!-- Seção: Revisões Atrasadas -->
      <% if (revisoesAtrasadas.length > 0) { %>
        <section class="review-section section-atrasada">
          <h2 class="section-title">
            <span class="icon">⚠️</span>
            Revisões Atrasadas
            <span class="count"><%= revisoesAtrasadas.length %></span>
          </h2>
          <div class="cards-grid">
            <% revisoesAtrasadas.forEach(r => { %>
              <%- include('./partials/review-card', { review: r }) %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <!-- Seção: Revisões para Hoje -->
      <% if (revisoesHoje.length > 0) { %>
        <section class="review-section section-hoje">
          <h2 class="section-title">
            <span class="icon">📅</span>
            Revisões para Hoje
            <span class="count"><%= revisoesHoje.length %></span>
          </h2>
          <div class="cards-grid">
            <% revisoesHoje.forEach(r => { %>
              <%- include('./partials/review-card', { review: r }) %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <!-- Seção: Outras Revisões -->
      <% if (outrasRevisoes.length > 0) { %>
        <section class="review-section section-outras">
          <h2 class="section-title">
            <span class="icon">📚</span>
            Outras Revisões
            <span class="count"><%= outrasRevisoes.length %></span>
          </h2>
          <div class="cards-grid">
            <% outrasRevisoes.forEach(r => { %>
              <%- include('./partials/review-card', { review: r }) %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <!-- Empty State -->
      <% if (revisoes.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🎉</div>
          <h3>Nenhuma revisão encontrada</h3>
          <p>Comece a estudar para criar suas revisões!</p>
        </div>
      <% } %>

    </div>
  </main>

  <!-- Modal: Registrar Revisão -->
  <div id="modal-revisao" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Registrar Revisão</h3>
        <button class="modal-close" onclick="closeModal('modal-revisao')">&times;</button>
      </div>
      <form id="form-revisao">
        <div class="modal-body">
          <input type="hidden" id="revisao-subject-id" name="subjectId">
          <input type="hidden" id="revisao-topic-id" name="topicId">

          <div class="form-group">
            <label>Matéria</label>
            <input type="text" id="revisao-subject" class="form-input" readonly>
          </div>

          <div class="form-group">
            <label>Tópico</label>
            <input type="text" id="revisao-topic" class="form-input" readonly>
          </div>

          <div class="form-group">
            <label>Como foi a revisão?</label>
            <div class="difficulty-options">
              <label class="difficulty-option">
                <input type="radio" name="dificuldade" value="muito_facil">
                <span class="difficulty-btn muito-facil">Muito Fácil</span>
              </label>
              <label class="difficulty-option">
                <input type="radio" name="dificuldade" value="facil">
                <span class="difficulty-btn facil">Fácil</span>
              </label>
              <label class="difficulty-option">
                <input type="radio" name="dificuldade" value="medio" checked>
                <span class="difficulty-btn medio">Médio</span>
              </label>
              <label class="difficulty-option">
                <input type="radio" name="dificuldade" value="dificil">
                <span class="difficulty-btn dificil">Difícil</span>
              </label>
              <label class="difficulty-option">
                <input type="radio" name="dificuldade" value="muito_dificil">
                <span class="difficulty-btn muito-dificil">Muito Difícil</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label>Assunto (opcional)</label>
            <input type="text" id="revisao-assunto" name="assunto" class="form-input" placeholder="O que você revisou especificamente?">
          </div>

          <div class="interval-info">
            <p>Próxima revisão calculada automaticamente:</p>
            <ul class="interval-list">
              <li><span class="level">Muito Fácil</span> <span class="interval">45 dias</span></li>
              <li><span class="level">Fácil</span> <span class="interval">20 dias</span></li>
              <li><span class="level">Médio</span> <span class="interval">14 dias</span></li>
              <li><span class="level">Difícil</span> <span class="interval">7 dias</span></li>
              <li><span class="level">Muito Difícil</span> <span class="interval">3 dias</span></li>
            </ul>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('modal-revisao')">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar Revisão</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Ver Erros -->
  <div id="modal-erros" class="modal">
    <div class="modal-content modal-large">
      <div class="modal-header">
        <h3>Erros do Simulado</h3>
        <button class="modal-close" onclick="closeModal('modal-erros')">&times;</button>
      </div>
      <div class="modal-body">
        <div id="erros-list" class="erros-list">
          <!-- Erros serão carregados aqui via AJAX -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modal-erros')">Fechar</button>
        <button type="button" class="btn btn-primary" id="btn-marcar-revisados">Marcar como Revisados</button>
      </div>
    </div>
  </div>

  <!-- Modal: Histórico de Revisões -->
  <div id="modal-historico" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Histórico de Revisões</h3>
        <button class="modal-close" onclick="closeModal('modal-historico')">&times;</button>
      </div>
      <div class="modal-body">
        <div id="historico-list" class="historico-list">
          <!-- Histórico será carregado aqui via AJAX -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modal-historico')">Fechar</button>
      </div>
    </div>
  </div>

  <script>
    // =====================================================
    // MODAIS
    // =====================================================
    function openModal(modalId) {
      document.getElementById(modalId).classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
      document.body.style.overflow = '';
    }

    // Fechar modal ao clicar fora
    document.querySelectorAll('.modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal(modal.id);
        }
      });
    });

    // =====================================================
    // ABRIR MODAL DE REGISTRAR REVISÃO
    // =====================================================
    function openRegistrarRevisao(subjectId, topicId, subjectName, topicName) {
      document.getElementById('revisao-subject-id').value = subjectId;
      document.getElementById('revisao-topic-id').value = topicId;
      document.getElementById('revisao-subject').value = subjectName;
      document.getElementById('revisao-topic').value = topicName;
      document.getElementById('revisao-assunto').value = '';
      
      // Reset radio button to médio
      document.querySelector('input[name="dificuldade"][value="medio"]').checked = true;
      
      openModal('modal-revisao');
    }

    // =====================================================
    // ENVIAR REVISÃO
    // =====================================================
    document.getElementById('form-revisao').addEventListener('submit', async (e) => {
      e.preventDefault();

      const subjectId = document.getElementById('revisao-subject-id').value;
      const topicId = document.getElementById('revisao-topic-id').value;
      const dificuldade = document.querySelector('input[name="dificuldade"]:checked').value;
      const assunto = document.getElementById('revisao-assunto').value;

      try {
        const response = await fetch('/revisoes/registrar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subjectId, topicId, dificuldade, assunto })
        });

        const data = await response.json();

        if (data.success) {
          closeModal('modal-revisao');
          showToast('Revisão registrada com sucesso!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.message || 'Erro ao registrar', 'error');
        }
      } catch (error) {
        showToast('Erro ao conectar com servidor', 'error');
      }
    });

    // =====================================================
    // VER ERROS DO TÓPICO
    // =====================================================
    let currentErros = [];

    async function openVerErros(subjectId, topicId) {
      const errosList = document.getElementById('erros-list');
      errosList.innerHTML = '<div class="loading">Carregando erros...</div>';
      
      currentErros = [];
      
      openModal('modal-erros');

      try {
        const response = await fetch(`/revisoes/erros/${subjectId}/${topicId}`);
        const data = await response.json();

        if (data.success && data.erros.length > 0) {
          currentErros = data.erros;
          errosList.innerHTML = data.erros.map(erro => `
            <div class="erro-item">
              <div class="erro-number">Questão ${erro.numero_questao}</div>
              <div class="erro-motivo">${getMotivoLabel(erro.motivo)}</div>
              <div class="erro-area">${erro.area}</div>
              <div class="erro-simulado">📝 ${erro.simuladoNome}</div>
            </div>
          `).join('');
          
          document.getElementById('btn-marcar-revisados').style.display = 'inline-block';
        } else {
          errosList.innerHTML = '<div class="empty-erros">Nenhum erro pendente para este tópico!</div>';
          document.getElementById('btn-marcar-revisados').style.display = 'none';
        }
      } catch (error) {
        errosList.innerHTML = '<div class="error">Erro ao carregar erros</div>';
      }
    }

    function getMotivoLabel(motivo) {
      const labels = {
        'falta_conteudo': 'Falta de conteúdo',
        'lacuna': 'Lacuna de conhecimento',
        'falta_atencao': 'Falta de atenção'
      };
      return labels[motivo] || motivo;
    }

    // Marcar erros como revisados
    document.getElementById('btn-marcar-revisados').addEventListener('click', async () => {
      if (currentErros.length === 0) return;

      const erroIds = currentErros.map(e => e.id);

      try {
        const response = await fetch('/revisoes/erros/revisar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ erroIds })
        });

        const data = await response.json();

        if (data.success) {
          closeModal('modal-erros');
          showToast('Erros marcados como revisados!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.message || 'Erro ao atualizar', 'error');
        }
      } catch (error) {
        showToast('Erro ao conectar com servidor', 'error');
      }
    });

    // =====================================================
    // VER HISTÓRICO DE REVISÕES
    // =====================================================
    async function openHistorico(subjectId, topicId) {
      const historicoList = document.getElementById('historico-list');
      historicoList.innerHTML = '<div class="loading">Carregando histórico...</div>';
      
      openModal('modal-historico');

      try {
        const response = await fetch(`/revisoes/historico/${subjectId}/${topicId}`);
        const data = await response.json();

        if (data.success && data.historico.length > 0) {
          historicoList.innerHTML = data.historico.map(r => `
            <div class="historico-item">
              <div class="historico-date">${formatDate(r.data_revisao)}</div>
              <div class="historico-dificuldade ${getDifficultyClass(r.dificuldade)}">${getDifficultyLabel(r.dificuldade)}</div>
              ${r.assunto ? `<div class="historico-assunto">${r.assunto}</div>` : ''}
            </div>
          `).join('');
        } else {
          historicoList.innerHTML = '<div class="empty-erros">Nenhuma revisão registrada ainda!</div>';
        }
      } catch (error) {
        historicoList.innerHTML = '<div class="error">Erro ao carregar histórico</div>';
      }
    }

    function formatDate(dateStr) {
      const date = new Date(dateStr);
      return date.toLocaleDateString('pt-BR');
    }

    function getDifficultyClass(dificuldade) {
      const classes = {
        'muito_facil': 'muito-facil',
        'facil': 'facil',
        'medio': 'medio',
        'dificil': 'dificil',
        'muito_dificil': 'muito-dificil'
      };
      return classes[dificuldade] || '';
    }

    function getDifficultyLabel(dificuldade) {
      const labels = {
        'muito_facil': 'Muito Fácil',
        'facil': 'Fácil',
        'medio': 'Médio',
        'dificil': 'Difícil',
        'muito_dificil': 'Muito Difícil'
      };
      return labels[dificuldade] || dificuldade;
    }

    // =====================================================
    // FILTROS
    // =====================================================
    const allCards = document.querySelectorAll('.review-card');

    function applyFilters() {
      const materia = document.getElementById('filter-materia').value;
      const prioridade = document.getElementById('filter-prioridade').value;
      const status = document.getElementById('filter-status').value;

      allCards.forEach(card => {
        const cardMateria = card.dataset.materia;
        const cardPrioridade = card.dataset.prioridade;
        const cardStatus = card.dataset.status;

        let show = true;

        if (materia && cardMateria !== materia) show = false;
        if (prioridade && cardPrioridade !== prioridade) show = false;
        if (status && cardStatus !== status) show = false;

        card.style.display = show ? 'block' : 'none';
      });
    }

    document.getElementById('filter-materia').addEventListener('change', applyFilters);
    document.getElementById('filter-prioridade').addEventListener('change', applyFilters);
    document.getElementById('filter-status').addEventListener('change', applyFilters);

    // =====================================================
    // TOAST NOTIFICATIONS
    // =====================================================
    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      document.body.appendChild(toast);

      setTimeout(() => toast.classList.add('show'), 10);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }
  </script>

  <style>
    /* Toast Styles */
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      padding: 16px 24px;
      border-radius: 12px;
      color: white;
      font-weight: 600;
      z-index: 10000;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s ease;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .toast-success { background: linear-gradient(135deg, #22c55e, #16a34a); }
    .toast-error { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .toast-info { background: linear-gradient(135deg, #3b82f6, #2563eb); }
  </style>

</body>
</html>

