<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KMed | Perfil</title>

  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/profile.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "perfil", userNome }) %>

<main class="with-sidebar">
  <div class="page profile-page">

    <h1>Meu Perfil</h1>

    <% if (erro) { %>
      <div class="alert error"><%= erro %></div>
    <% } %>

    <% if (ok) { %>
      <div class="alert ok"><%= ok %></div>
    <% } %>

    <!-- Seção de Estatísticas -->
    <div class="stats-section">
      <div class="stats-grid">
        
        <div class="stat-card hours">
          <div class="stat-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.totalHoras.toFixed(1) %></span>
            <span class="stat-label">Horas Estudadas</span>
          </div>
        </div>

        <div class="stat-card questions">
          <div class="stat-icon">
            <i class="fas fa-pen"></i>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.totalQuestoes %></span>
            <span class="stat-label">Questões Respondidas</span>
          </div>
        </div>

        <div class="stat-card correct">
          <div class="stat-icon">
            <i class="fas fa-check-circle"></i>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.totalAcertos %></span>
            <span class="stat-label">Acertos</span>
          </div>
        </div>

        <div class="stat-card accuracy">
          <div class="stat-icon">
            <i class="fas fa-bullseye"></i>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.taxaAcertos %>%</span>
            <span class="stat-label">Taxa de Acerto</span>
          </div>
        </div>

        <div class="stat-card exams">
          <div class="stat-icon">
            <i class="fas fa-file-alt"></i>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.simuladoCount %></span>
            <span class="stat-label">Simulados Feitos</span>
          </div>
        </div>

        <div class="stat-card streak">
          <div class="stat-icon">
            <i class="fas fa-fire"></i>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.streak %></span>
            <span class="stat-label">Dias Seguidos</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Card do Perfil -->
    <form method="POST" enctype="multipart/form-data" class="profile-card">

      <div class="avatar-section">
        <div class="avatar">
          <img src="<%= user.foto || '/public/img/avatar-default.png' %>" alt="Foto de perfil">
          <label for="foto" class="avatar-edit">
            <i class="fas fa-camera"></i>
          </label>
          <input type="file" id="foto" name="foto" accept="image/*">
        </div>
        <div class="user-name">
          <h2><%= user.nome %></h2>
          <p>Membro desde <%= dataCadastro %></p>
        </div>
      </div>

      <div class="form-section">
        <div class="form-group">
          <label><i class="fas fa-user"></i> Nome</label>
          <input type="text" name="nome" value="<%= user.nome %>" required>
        </div>

        <div class="form-group">
          <label><i class="fas fa-envelope"></i> Email</label>
          <input type="email" name="email" value="<%= user.email %>" required>
        </div>

        <div class="form-group">
          <label><i class="fas fa-lock"></i> Nova senha (opcional)</label>
          <input type="password" name="senha" placeholder="mínimo 6 caracteres">
        </div>

        <div class="form-group">
          <label><i class="fas fa-align-left"></i> Bio / Descrição</label>
          <textarea name="bio" placeholder="Conte um pouco sobre você... (ex: estudante de medicina, focado no vestibular...)" maxlength="500"><%= user.bio || '' %></textarea>
          <span class="char-count"><%= (user.bio || '').length %>/500</span>
        </div>
      </div>

      <button class="btn">Salvar alterações</button>
    </form>

  </div>
</main>

<script>
  // Atualizar contador de caracteres
  document.querySelector('textarea[name="bio"]').addEventListener('input', function() {
    document.querySelector('.char-count').textContent = this.value.length + '/500';
  });

  // Preview da foto
  document.querySelector('input[name="foto"]').addEventListener('change', function(e) {
    if (e.target.files && e.target.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.querySelector('.avatar img').src = e.target.result;
      }
      reader.readAsDataURL(e.target.files[0]);
    }
  });
</script>

</body>
</html>

