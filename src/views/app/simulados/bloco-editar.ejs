<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Editar Bloco</title>
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/simulados-bloco-editar.css">

</head>
<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="main-content">
<div class="container">

<h1>Editar Bloco</h1>

<form action="/simulados/bloco/<%= bloco.id %>/editar" method="POST">
  <select name="area" required>
    <option value="linguagens" <%= bloco.area==="linguagens"?"selected":"" %>>Linguagens</option>
    <option value="humanas" <%= bloco.area==="humanas"?"selected":"" %>>Humanas</option>
    <option value="naturezas" <%= bloco.area==="naturezas"?"selected":"" %>>Naturezas</option>
    <option value="matematica" <%= bloco.area==="matematica"?"selected":"" %>>Matemática</option>
  </select>

  <input type="number" name="total_questoes" value="<%= bloco.total_questoes %>" required>
  <input type="number" name="acertos" value="<%= bloco.acertos %>" required>
  <input type="number" name="tempo_minutos" value="<%= bloco.tempo_minutos %>">
  <input type="date" name="data_realizacao" value="<%= bloco.data_realizacao %>" required>

  <button class="btn primary">Salvar alterações</button>
</form>

</div>
</main>
</body>
</html>
