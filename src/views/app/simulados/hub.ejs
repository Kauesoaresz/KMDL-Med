<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simulados - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/simulados-hub.css">
</head>

<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <!-- Header -->
    <div class="page-header">
      <div>
        <h1>📘 Simulados</h1>
        <p>Gerencie seus simulados, revise erros e acompanhe sua evolução</p>
      </div>
      <a href="/simulados/lista" class="btn-primary">
        + Novo Simulado
      </a>
    </div>

    <!-- Quick Actions -->
    <div class="section">
      <h2 class="section-title">Acesso Rápido</h2>
      <div class="hub-grid">
        <a href="/simulados/lista" class="hub-card">
          <div class="icon">📝</div>
          <h3>Meus Simulados</h3>
          <p>Crie simulados, continue simulados em andamento e veja resultados</p>
        </a>

        <a href="/simulados/erros" class="hub-card">
          <div class="icon">❌</div>
          <h3>Questões Erradas</h3>
          <p>Veja todos os erros, filtre por área e marque revisões</p>
        </a>
      </div>
    </div>

  </div>
</main>

</body>
</html>
