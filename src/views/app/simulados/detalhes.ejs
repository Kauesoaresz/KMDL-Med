<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../../partials/head", { title: simulado.nome, css: ["detalhes"] }) %>
</head>
<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page sim-page">

    <!-- TOPO STICKY -->
    <header class="sim-topbar">
      <div class="sim-topbar-row">
        <a href="/simulados" class="btn-ghost btn-sm">← Simulados</a>

        <input id="sim-nome" class="sim-nome" type="text" maxlength="255" value="<%= simulado.nome %>" />

        <span class="sim-badge <%= simulado.status %>" id="sim-status-label">
          <%= simulado.status === "finalizado" ? "✅ Finalizado" : "⏳ Em andamento" %>
        </span>

        <span class="sim-date">📅 <%= simulado.data_realizacao.split("-").reverse().join("/") %></span>
      </div>

      <div class="sim-topbar-row">
        <label class="sim-inline">
          <span>Redação</span>
          <input id="sim-redacao" type="number" min="0" max="1000" step="1"
                 value="<%= simulado.redacao_nota != null ? simulado.redacao_nota : '' %>" placeholder="0–1000" />
        </label>

        <button type="button" id="btn-salvar" class="btn">💾 Salvar</button>
        <button type="button" id="btn-status" class="btn-primary"
                data-status="<%= simulado.status %>">
          <%= simulado.status === "finalizado" ? "↩ Reabrir" : "✅ Salvar e finalizar" %>
        </button>

        <span id="msg-salvo" class="sim-save-msg"></span>
      </div>

      <!-- RESUMO -->
      <div class="sim-summary">
        <div class="sim-sum-item"><small>Acertos</small><strong id="sum-acertos">0</strong></div>
        <div class="sim-sum-item"><small>Feitas</small><strong id="sum-feitas">0</strong></div>
        <div class="sim-sum-item"><small>Desempenho</small><strong id="sum-pct">0%</strong></div>
        <% areas.forEach(a => { %>
          <div class="sim-sum-item"><small><%= a.label %></small><strong id="sum-<%= a.key %>">0/0 · 0%</strong></div>
        <% }) %>
      </div>
    </header>

    <!-- CORPO: grade + lista lateral -->
    <div class="sim-body">

      <div class="sim-main">
        <!-- SWITCH modo não feita -->
        <div class="sim-switch-bar">
          <label class="sim-switch">
            <input type="checkbox" id="btn-modo-nf" />
            <span class="sim-switch-track"><span class="sim-switch-dot"></span></span>
            <span class="sim-switch-label">Modo “não feita”</span>
          </label>
          <span class="sim-switch-hint">
            Desligado: certa → errada → não feita → certa.
            Ligado: alterna direto entre não feita e certa.
          </span>
        </div>

        <!-- GRADES -->
        <% areas.forEach(a => { %>
          <section class="sim-area">
            <header class="sim-area-head">
              <h3><%= a.label %> <small class="muted">(<%= a.start %>–<%= a.start + 44 %>)</small></h3>
              <div class="sim-area-actions">
                <label class="sim-inline">
                  <span>⏱ min</span>
                  <input id="tempo-<%= a.key %>" type="number" min="0"
                         value="<%= tempos[a.key] != null ? tempos[a.key] : '' %>" />
                </label>
                <button type="button" id="lock-<%= a.key %>" class="btn-sm btn">🔓 Fechar área</button>
              </div>
            </header>

            <p id="closed-<%= a.key %>" class="sim-closed" style="display:none;">
              🔒 Área fechada: todas as questões contam como não feitas.
            </p>

            <div class="sim-grid" id="grid-<%= a.key %>"></div>
          </section>
        <% }) %>
      </div>

      <!-- LISTA DE ERRADAS -->
      <aside class="sim-aside">
        <div class="sim-aside-head">
          <h3>✕ Questões erradas</h3>
          <span class="muted" id="err-count"></span>
        </div>
        <div class="sim-erros" id="lista-erros"></div>
      </aside>

    </div>

  </div>
</main>

<!-- MODAL DE DIAGNÓSTICO -->
<div class="modal-bg" id="modal">
  <div class="modal-box">
    <h3 id="m-title">Questão</h3>
    <p class="muted">Por que você errou?</p>

    <div class="sim-motivos" id="m-motivos">
      <button type="button" data-motivo="falta_atencao">👀 Falta de atenção</button>
      <button type="button" data-motivo="falta_conteudo">📖 Falta de conteúdo</button>
      <button type="button" data-motivo="lacuna">🕳 Lacuna de conhecimento</button>
    </div>

    <div id="m-lacuna" class="m-lacuna" style="display:none;">
  <div class="m-band">
    <div class="m-band-label">Matéria</div>
    <div class="chip-grid" id="m-subj-chips"></div>
  </div>

  <div class="m-band">
    <div class="m-band-label">Tópico</div>
    <div class="chip-grid" id="m-topic-chips"></div>
  </div>
</div>

    <textarea id="m-anot" rows="2" maxlength="255" placeholder="Anotação (opcional)"></textarea>

    <div id="m-err" class="sim-err"></div>

    <div class="modal-actions">
      <button type="button" id="m-cancel" class="btn">Cancelar</button>
      <button type="button" id="m-ok" class="btn-primary">Confirmar</button>
    </div>
  </div>
</div>

<script>

window.SIM = Object.assign(
  <%- simJson %>,
  { subjects: <%- JSON.stringify(subjects.map(s => ({ id: s.id, nome: s.nome, hue: s.hue || 245 }))).replace(/</g, '\\u003c') %> }
);

</script>
<script src="/public/js/app/simulado-grade.js"></script>

</body>
</html>