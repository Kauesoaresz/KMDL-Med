<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../../partials/head", { title: "Caderno de erros", css: ["simulados-erros"] }) %>
</head>
<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<%
  // contadores (sobre o conjunto filtrado)
  const pendentes = erros.filter(e => !e.revisada).length;
  const revisadas = erros.filter(e => e.revisada).length;

  // filtros ativos (vêm da query)
  const qArea   = (locals.qArea   || "");
  const qMotivo = (locals.qMotivo || "");
  const qStatus = (locals.qStatus || "");

  // agrupa por matéria
  const porMateria = {};
  erros.forEach(e => {
    const key = e.subject_id || "sem";
    if (!porMateria[key]) {
      porMateria[key] = {
        nome: e.subject ? e.subject.nome : "Sem matéria",
        hue: e.subject && e.subject.hue ? e.subject.hue : 245,
        itens: [],
      };
    }
    porMateria[key].itens.push(e);
  });
  const materias = Object.values(porMateria)
    .sort((a, b) => b.itens.length - a.itens.length);

  const AREAS = [
    { k: "",           l: "Todas" },
    { k: "linguagens", l: "Linguagens" },
    { k: "humanas",    l: "Humanas" },
    { k: "naturezas",  l: "Naturezas" },
    { k: "matematica", l: "Matemática" },
  ];
  const MOTIVOS = [
    { k: "",               l: "Todos" },
    { k: "falta_atencao",  l: "Falta de atenção" },
    { k: "falta_conteudo", l: "Falta de conteúdo" },
    { k: "lacuna",         l: "Lacuna" },
  ];
  const STATUS = [
    { k: "",          l: "Todas" },
    { k: "pendentes", l: "Pendentes" },
    { k: "revisadas", l: "Revisadas" },
  ];
  const buildHref = (key, value) => {
    const p = new URLSearchParams();
    const cur = { area: qArea, motivo: qMotivo, status: qStatus };
    cur[key] = value;
    if (cur.area)   p.set("area", cur.area);
    if (cur.motivo) p.set("motivo", cur.motivo);
    if (cur.status) p.set("status", cur.status);
    const qs = p.toString();
    return "/simulados/erros" + (qs ? "?" + qs : "");
  };
%>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>🧠 Caderno de erros</h1>
        <p>Revise e organize o que você errou.</p>
      </div>
      <a href="/simulados" class="btn-ghost btn-sm">← Simulados</a>
    </header>

    <!-- CONTADORES + FILTROS -->
    <section class="err-filters">
      <div class="err-counts">
        <span class="badge badge-warn">⏳ <%= pendentes %> pendentes</span>
        <span class="badge badge-ok">✓ <%= revisadas %> revisadas</span>
      </div>

      <div class="err-filters-row">
        <div class="err-filter-group">
          <span class="err-filter-label">Área</span>
          <div class="chips">
            <% AREAS.forEach(a => { %>
              <a href="<%= buildHref('area', a.k) %>"
                 class="chip <%= qArea === a.k ? 'active' : '' %>"><%= a.l %></a>
            <% }) %>
          </div>
        </div>

        <div class="err-filter-group">
          <span class="err-filter-label">Motivo</span>
          <div class="chips">
            <% MOTIVOS.forEach(m => { %>
              <a href="<%= buildHref('motivo', m.k) %>"
                 class="chip <%= qMotivo === m.k ? 'active' : '' %>"><%= m.l %></a>
            <% }) %>
          </div>
        </div>

        <div class="err-filter-group">
          <span class="err-filter-label">Status</span>
          <div class="chips">
            <% STATUS.forEach(s => { %>
              <a href="<%= buildHref('status', s.k) %>"
                 class="chip <%= qStatus === s.k ? 'active' : '' %>"><%= s.l %></a>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <!-- LISTA -->
    <% if (erros.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">✨</div>
        <h3>Nenhum erro <%= qArea || qMotivo || qStatus ? "com estes filtros" : "registrado ainda" %></h3>
        <p><%= qArea || qMotivo || qStatus ? "Tente limpar os filtros acima." : "Seus erros dos simulados aparecerão aqui." %></p>
      </div>
    <% } else { %>

      <div class="err-list">
        <% materias.forEach(m => { %>
          <section class="err-subject" style="--h: <%= m.hue %>">
            <header class="err-subject-head">
              <div class="err-subject-info">
                <span class="err-dot"></span>
                <h2 class="err-subject-name"><%= m.nome %></h2>
                <span class="muted"><%= m.itens.length %> <%= m.itens.length === 1 ? "questão" : "questões" %></span>
              </div>
              <span class="badge"><%= m.itens.filter(e => !e.revisada).length %> pendentes</span>
            </header>

            <div class="err-items">
              <% m.itens.forEach(erro => { %>
                <article class="err-item <%= erro.revisada ? 'is-revisada' : '' %>">

                  <div class="err-item-main">
                    <div class="err-item-top">
                      <span class="err-q">Q<%= erro.numero_questao %></span>

                      <span class="badge err-motivo motivo-<%= erro.motivo %>">
                        <%= erro.motivo === 'falta_atencao'  ? '👀 Falta de atenção'
                          : erro.motivo === 'falta_conteudo' ? '📖 Falta de conteúdo'
                          : erro.motivo === 'lacuna'         ? '🕳 Lacuna'
                          : erro.motivo %>
                      </span>

                      <% if (erro.topic) { %>
                        <span class="err-topic">📚 <%= erro.topic.nome %></span>
                      <% } %>

                      <% if (erro.revisada) { %>
                        <span class="badge badge-ok err-rev">✓ revisada</span>
                      <% } %>
                    </div>

                    <% if (erro.anotacao) { %>
                      <p class="err-anot">“<%= erro.anotacao %>”</p>
                    <% } %>

                    <small class="err-sim">📝 <%= erro.bloco.simulado.nome %></small>
                  </div>

                  <div class="err-item-actions">
                    <% if (!erro.revisada) { %>
                      <form action="/simulados/erro/<%= erro.id %>/revisar" method="POST" class="inline-form">
                        <button type="submit" class="btn-ok btn-sm" title="Marcar como revisada">✓ Revisar</button>
                      </form>
                    <% } else { %>
                      <form action="/simulados/erro/<%= erro.id %>/desfazer" method="POST"
                            onsubmit="return confirm('Desfazer revisão?')" class="inline-form">
                        <button type="submit" class="btn-ghost btn-sm" title="Desfazer revisão">↩ Desfazer</button>
                      </form>
                    <% } %>
                  </div>

                </article>
              <% }) %>
            </div>
          </section>
        <% }) %>
      </div>

    <% } %>

  </div>
</main>

</body>
</html>