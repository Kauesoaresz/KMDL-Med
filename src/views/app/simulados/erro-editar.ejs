<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Editar Erro</title>
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/simulados-erro-editar.css">

</head>
<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="with-sidebar">
<div class="container">

<h1>Editar Erro</h1>

<form action="/simulados/erro/<%= erro.id %>/editar" method="POST">
  <input
    type="number"
    name="numero_questao"
    value="<%= erro.numero_questao %>"
    required
  >

  <select name="motivo" required>
    <option value="falta_conteudo" <%= erro.motivo==="falta_conteudo"?"selected":"" %>>Falta de conteúdo</option>
    <option value="lacuna" <%= erro.motivo==="lacuna"?"selected":"" %>>Lacuna</option>
    <option value="falta_atencao" <%= erro.motivo==="falta_atencao"?"selected":"" %>>Falta de atenção</option>
  </select>

  <button class="btn primary">Salvar alterações</button>
</form>

</div>
</main>
</body>
</html>
