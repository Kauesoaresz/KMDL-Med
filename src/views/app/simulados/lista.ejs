<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meus Simulados - KMDL Med</title>
  <link rel="stylesheet" href="/public/css/components/global-responsive.css">
  <link rel="stylesheet" href="/public/css/components/sidebar.css">
  <link rel="stylesheet" href="/public/css/app/simulados-lista.css">
</head>

<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <div class="page-header">
      <div>
        <h1>📘 Meus Simulados</h1>
        <p>Crie e acompanhe seus simulados</p>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (ok) { %>
      <div class="alert alert-success"><%= ok %></div>
    <% } %>

    <div class="section">
      <div class="form-card">
        <h2 class="section-title">Criar Novo Simulado</h2>
        <form action="/simulados" method="POST" class="form-row">
          <div class="form-group">
            <label for="nome">Nome do simulado</label>
            <input type="text" id="nome" name="nome" placeholder="Ex: ENEM 2023, Simulado 1" required />
          </div>

          <div class="form-group">
            <label for="data_realizacao">Data de realização</label>
            <input type="date" id="data_realizacao" name="data_realizacao" required />
          </div>

          <div class="form-group form-actions">
            <button type="submit" class="btn-primary">+ Criar Simulado</button>
          </div>
        </form>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">Simulados Criados</h2>

      <% if (simulados.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📘</div>
          <h3>Nenhum simulado criado ainda</h3>
          <p>Crie seu primeiro simulado acima para começar a praticar!</p>
        </div>
      <% } else { %>
        <div class="list-grid">
          <% simulados.forEach(simulado => { %>
            <div class="list-card <%= simulado.status %>">
              <div class="list-card-header">
                <span class="status-badge <%= simulado.status %>">
                  <%= simulado.status === "finalizado" ? "✅ Finalizado" : "⏳ Em andamento" %>
                </span>
              </div>

              <h3 class="list-card-title"><%= simulado.nome %></h3>

              <div class="list-card-meta">
                <span class="meta-item">
                  📅 <%= simulado.data_realizacao ? simulado.data_realizacao.split("-").reverse().join("/") : "Sem data" %>
                </span>
              </div>

              <div class="list-card-actions">
                <a href="/simulados/<%= simulado.id %>" class="btn-secondary">Abrir</a>
                <form
                  action="/simulados/<%= simulado.id %>/excluir"
                  method="POST"
                  onsubmit="return confirm('Tem certeza que deseja excluir este simulado?')"
                  class="inline-form"
                >
                  <button type="submit" class="btn-danger">Excluir</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</main>

</body>
</html>