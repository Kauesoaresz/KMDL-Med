<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../../partials/head", { title: "Simulados", css: ["simulados-lista"] }) %>
</head>
<body class="page-bg">

<%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📘 Simulados</h1>
        <p>Crie e acompanhe seus simulados.</p>
      </div>
      <a href="/simulados/erros" class="btn-ghost btn-sm">🧠 Caderno de erros →</a>
    </header>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (ok)    { %><div class="alert alert-success"><%= ok %></div><% } %>

    <!-- CRIAR -->
    <section class="card" id="criar">
      <h2 class="card-heading">➕ Novo simulado</h2>
      <form action="/simulados" method="POST" class="form-row">
        <div class="form-group">
          <label for="nome">Nome</label>
          <input type="text" id="nome" name="nome" placeholder="Ex: ENEM 2023, Simulado 1" required />
        </div>
        <div class="form-group">
          <label for="data_realizacao">Data</label>
          <input type="date" id="data_realizacao" name="data_realizacao" required />
        </div>
        <div class="form-group form-actions">
          <button type="submit" class="btn-primary">Criar</button>
        </div>
      </form>
    </section>

    <!-- LISTA -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Simulados criados</h2>
        <span class="muted"><%= simulados.length %> <%= simulados.length === 1 ? "simulado" : "simulados" %></span>
      </div>

      <% if (simulados.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📘</div>
          <h3>Nenhum simulado criado ainda</h3>
          <p>Crie o primeiro acima para começar.</p>
        </div>
      <% } else { %>
        <div class="sim-grid">
          <% simulados.forEach(s => { %>
            <article class="sim-card <%= s.status %>">
              <div class="sim-card-top">
                <span class="badge <%= s.status === 'finalizado' ? 'badge-ok' : 'badge-warn' %>">
                  <%= s.status === "finalizado" ? "✅ Finalizado" : "⏳ Em andamento" %>
                </span>
                <span class="sim-date">📅 <%= s.data_realizacao ? s.data_realizacao.split("-").reverse().join("/") : "—" %></span>
              </div>

              <h3 class="sim-title"><%= s.nome %></h3>

              <div class="sim-actions">
                <a href="/simulados/<%= s.id %>" class="btn-primary btn-sm">Abrir</a>
                <form action="/simulados/<%= s.id %>/excluir" method="POST"
                      onsubmit="return confirm('Excluir este simulado?')" class="inline-form">
                  <button type="submit" class="btn-ghost btn-sm sim-del">Excluir</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

  </div>
</main>

</body>
</html>