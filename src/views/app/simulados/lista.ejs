<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title>KMDL Med | Simulados</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/public/css/components/sidebar.css" />
  <link rel="stylesheet" href="/public/css/app/simulados-lista.css" />
</head>
<body class="page-bg">

  <%- include("../../partials/sidebar", { active: "simulados", userNome, userFoto }) %>

<main class="with-sidebar">
    <div class="container">

      <!-- HEADER -->
      <div class="header">
        <h1>📘 Simulados</h1>

        <form action="/simulados" method="POST" class="novo-simulado-form">
          <input
            type="text"
            name="nome"
            placeholder="Nome do simulado (ex: ENEM 2023)"
            required
          />

          <input
            type="date"
            name="data_realizacao"
            required
          />

          <button type="submit">Criar simulado</button>
        </form>
      </div>

      <!-- LISTA -->
      <div class="simulados-lista">

        <% if (simulados.length === 0) { %>
          <p class="empty">
            Nenhum simulado criado ainda.
          </p>
        <% } %>

        <% simulados.forEach(simulado => { %>
          <div class="simulado-card <%= simulado.status %>">

            <div class="info">
              <h3><%= simulado.nome %></h3>

              <span class="status <%= simulado.status %>">
                <%= simulado.status === "finalizado" ? "Finalizado" : "Em andamento" %>
              </span>
            </div>

            <div class="meta">
              <span>
                Realizado em:
                <%= simulado.data_realizacao.split("-").reverse().join("/") %>

              </span>
            </div>

            <div class="actions">
              <a href="/simulados/<%= simulado.id %>" class="btn">
                Abrir simulado
              </a>

              <form
                action="/simulados/<%= simulado.id %>/excluir"
                method="POST"
                onsubmit="return confirm('Tem certeza que deseja excluir este simulado?')"
              >
                <button type="submit" class="btn danger small">
                  Excluir
                </button>
              </form>
            </div>

          </div>
        <% }) %>

      </div>

    </div>
  </main>

</body>
</html>
