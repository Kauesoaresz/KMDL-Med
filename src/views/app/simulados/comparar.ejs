<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../../partials/head", { title: "Comparar simulados", css: ["estatisticas", "comparar"] }) %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="page-bg">

<%- include("../../partials/sidebar", { active: "estatisticas", userNome, userFoto }) %>

<%
  const nomes = { linguagens: "Linguagens", humanas: "Humanas", naturezas: "Natureza", matematica: "Matemática" };
  const icones = { linguagens: "📖", humanas: "🏛️", naturezas: "🔬", matematica: "➗" };
  const sinal = (n) => (n > 0 ? "+" : "");
  const cls = (n) => (n > 0 ? "pos" : n < 0 ? "neg" : "");

  const rows = resultado ? Object.keys(resultado.A.areas).map((k) => {
    const a = resultado.A.areas[k], b = resultado.B.areas[k];
    const pa = a.questoes > 0 ? Math.round((a.acertos / a.questoes) * 100) : null;
    const pb = b.questoes > 0 ? Math.round((b.acertos / b.questoes) * 100) : null;
    return { k, nome: nomes[k], a, b, pa, pb, delta: pa !== null && pb !== null ? pb - pa : null };
  }) : [];
  const comparaveis = rows.filter((r) => r.delta !== null);
  const melhor = comparaveis.length ? comparaveis.reduce((x, y) => (y.delta > x.delta ? y : x)) : null;
  const pior = comparaveis.length ? comparaveis.reduce((x, y) => (y.delta < x.delta ? y : x)) : null;
%>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>⚖️ Comparar simulados</h1>
        <p>Veja a evolução entre dois simulados, área por área.</p>
      </div>
      <a href="/estatisticas" class="btn">← Estatísticas</a>
    </header>

    <!-- SELEÇÃO -->
    <form method="POST" class="card cmp-form">
      <div class="form-group">
        <label for="sA"><span class="tagdot a"></span> Simulado A (base)</label>
        <select id="sA" name="simuladoA" required>
          <option value="">Selecione…</option>
          <% simulados.forEach(s => { %>
            <option value="<%= s.id %>" <%= resultado && resultado.A.id == s.id ? "selected" : "" %>>
              <%= s.nome %> · <%= String(s.data_realizacao).split("-").reverse().join("/") %><%= s.status === "finalizado" ? "" : " (em andamento)" %>
            </option>
          <% }) %>
        </select>
      </div>

      <button type="button" class="btn swap" id="swap" title="Inverter">⇄</button>

      <div class="form-group">
        <label for="sB"><span class="tagdot b"></span> Simulado B (comparar)</label>
        <select id="sB" name="simuladoB" required>
          <option value="">Selecione…</option>
          <% simulados.forEach(s => { %>
            <option value="<%= s.id %>" <%= resultado && resultado.B.id == s.id ? "selected" : "" %>>
              <%= s.nome %> · <%= String(s.data_realizacao).split("-").reverse().join("/") %><%= s.status === "finalizado" ? "" : " (em andamento)" %>
            </option>
          <% }) %>
        </select>
      </div>

      <button type="submit" class="btn-primary">Comparar</button>
    </form>

    <% if (!resultado) { %>
      <div class="empty-state">
        <div class="empty-icon">⚖️</div>
        <h3>Escolha dois simulados</h3>
        <p>Selecione A e B acima para ver a diferença de desempenho.</p>
      </div>
    <% } else { %>

      <!-- CARDS -->
      <section class="grid-3">
        <% [{ t: "A", r: resultado.A, c: "a" }, { t: "B", r: resultado.B, c: "b" }].forEach(x => { %>
          <div class="card cmp-card <%= x.c %>">
            <div class="cmp-top">
              <span class="tagdot <%= x.c %>"></span>
              <div>
                <strong><%= x.r.nome %></strong>
                <div class="faint" style="font-size: var(--fs-xs);">Simulado <%= x.t %> · <%= x.r.dataFormatada %></div>
              </div>
            </div>
            <div class="cmp-big num <%= x.r.percentual >= 70 ? 'pos' : x.r.percentual >= 50 ? '' : 'neg' %>"><%= x.r.totalQ > 0 ? x.r.percentual + "%" : "—" %></div>
            <div class="muted" style="font-size: var(--fs-sm);"><%= x.r.totalA %> acertos em <%= x.r.totalQ %> questões</div>
          </div>
        <% }) %>

        <div class="card cmp-card delta">
          <div class="cmp-top"><span style="font-size:1.3rem;">📈</span><strong>Evolução</strong></div>
          <div class="cmp-big num <%= cls(resultado.deltaGeral) %>"><%= sinal(resultado.deltaGeral) %><%= resultado.deltaGeral %>%</div>
          <div class="muted" style="font-size: var(--fs-sm);">
            <%= resultado.deltaGeral > 0 ? "Melhorou" : resultado.deltaGeral < 0 ? "Piorou" : "Estável" %>
            · <%= resultado.diasEntre %> dia(s) entre eles
          </div>
        </div>
      </section>

      <!-- GRÁFICO + ÁREAS -->
      <section class="grid-2">
        <div class="card">
          <h2 class="card-heading">Aproveitamento por área</h2>
          <div class="chart-box"><canvas id="areaChart"></canvas></div>
        </div>

        <div class="card stack" style="gap: var(--s-4);">
          <h2 class="card-heading">Detalhe por área</h2>
          <% rows.forEach(r => { %>
            <div class="area-row">
              <div class="area-head">
                <span><%= icones[r.k] %> <%= r.nome %></span>
                <% if (r.delta !== null) { %>
                  <span class="badge <%= r.delta > 0 ? 'badge-ok' : r.delta < 0 ? 'badge-err' : '' %>"><%= sinal(r.delta) %><%= r.delta %>%</span>
                <% } else { %><span class="badge">sem comparação</span><% } %>
              </div>
              <div class="bar-pair">
                <span class="tagdot a"></span>
                <div class="progress"><span class="fa" style="width: <%= r.pa || 0 %>%"></span></div>
                <span class="num"><%= r.pa === null ? "—" : r.pa + "%" %></span>
              </div>
              <div class="bar-pair">
                <span class="tagdot b"></span>
                <div class="progress"><span class="fb" style="width: <%= r.pb || 0 %>%"></span></div>
                <span class="num"><%= r.pb === null ? "—" : r.pb + "%" %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <!-- DIAGNÓSTICO -->
      <section class="card diag <%= cls(resultado.deltaGeral) %>">
        <h2 class="card-heading">
          <%= resultado.deltaGeral > 0 ? "🚀 Boa evolução" : resultado.deltaGeral < 0 ? "💪 Hora de analisar" : "⚖️ Desempenho estável" %>
        </h2>
        <ul class="diag-list">
          <% if (resultado.deltaGeral > 0) { %>
            <li>O aproveitamento geral subiu <strong><%= resultado.deltaGeral %> pontos</strong>.</li>
          <% } else if (resultado.deltaGeral < 0) { %>
            <li>O aproveitamento geral caiu <strong><%= Math.abs(resultado.deltaGeral) %> pontos</strong>. Olhe o caderno de erros dos dois.</li>
          <% } else { %>
            <li>O aproveitamento geral ficou igual.</li>
          <% } %>
          <% if (melhor && melhor.delta > 0) { %>
            <li>Maior avanço: <strong><%= melhor.nome %></strong> (<%= sinal(melhor.delta) %><%= melhor.delta %>%).</li>
          <% } %>
          <% if (pior && pior.delta < 0) { %>
            <li>Maior queda: <strong><%= pior.nome %></strong> (<%= pior.delta %>%). Vale revisar essa área.</li>
          <% } %>
          <% if (!comparaveis.length) { %>
            <li>Nenhuma área tem questões nos dois simulados, então não dá para comparar por área.</li>
          <% } %>
        </ul>
      </section>

      <!-- TABELA -->
      <section class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Métrica</th><th><span class="tagdot a"></span> <%= resultado.A.nome %></th><th><span class="tagdot b"></span> <%= resultado.B.nome %></th><th>Δ</th></tr>
          </thead>
          <tbody>
            <tr><td>Questões</td><td><%= resultado.A.totalQ %></td><td><%= resultado.B.totalQ %></td><td class="faint">—</td></tr>
            <% const dAc = resultado.B.totalA - resultado.A.totalA;
               const dEr = (resultado.B.totalQ - resultado.B.totalA) - (resultado.A.totalQ - resultado.A.totalA); %>
            <tr><td>Acertos</td><td><%= resultado.A.totalA %></td><td><%= resultado.B.totalA %></td><td class="<%= cls(dAc) %>"><%= sinal(dAc) %><%= dAc %></td></tr>
            <tr><td>Erros</td><td><%= resultado.A.totalQ - resultado.A.totalA %></td><td><%= resultado.B.totalQ - resultado.B.totalA %></td><td class="<%= cls(-dEr) %>"><%= sinal(dEr) %><%= dEr %></td></tr>
            <tr><td><strong>Aproveitamento</strong></td><td><strong><%= resultado.A.percentual %>%</strong></td><td><strong><%= resultado.B.percentual %>%</strong></td><td class="<%= cls(resultado.deltaGeral) %>"><%= sinal(resultado.deltaGeral) %><%= resultado.deltaGeral %>%</td></tr>
            <% rows.forEach(r => { %>
              <tr>
                <td><%= r.nome %></td>
                <td><%= r.a.questoes > 0 ? r.a.acertos + "/" + r.a.questoes + " (" + r.pa + "%)" : "—" %></td>
                <td><%= r.b.questoes > 0 ? r.b.acertos + "/" + r.b.questoes + " (" + r.pb + "%)" : "—" %></td>
                <td class="<%= r.delta === null ? 'faint' : cls(r.delta) %>"><%= r.delta === null ? "—" : sinal(r.delta) + r.delta + "%" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>

    <% } %>

  </div>
</main>

<script>
  document.getElementById("swap").addEventListener("click", () => {
    const a = document.getElementById("sA"), b = document.getElementById("sB");
    [a.value, b.value] = [b.value, a.value];
  });

  <% if (resultado) { %>
  const D = <%- JSON.stringify({
    nomeA: resultado.A.nome, nomeB: resultado.B.nome,
    labels: rows.map(r => r.nome),
    a: rows.map(r => r.pa), b: rows.map(r => r.pb)
  }).replace(/</g, "\\u003c") %>;

  let chart;
  function desenhar() {
    const cs = getComputedStyle(document.documentElement);
    const v = (n) => cs.getPropertyValue(n).trim();
    if (chart) chart.destroy();

    chart = new Chart(document.getElementById("areaChart"), {
      type: "bar",
      data: {
        labels: D.labels,
        datasets: [
          { label: D.nomeA, data: D.a, backgroundColor: v("--chart-3"), borderRadius: 6 },
          { label: D.nomeB, data: D.b, backgroundColor: v("--chart-1"), borderRadius: 6 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: "top", labels: { color: v("--text-muted"), usePointStyle: true } },
          tooltip: { callbacks: { label: (c) => " " + c.dataset.label + ": " + (c.raw === null ? "sem questões" : c.raw + "%") } }
        },
        scales: {
          y: { beginAtZero: true, max: 100, grid: { color: v("--border") }, ticks: { color: v("--text-muted"), callback: (x) => x + "%" } },
          x: { grid: { display: false }, ticks: { color: v("--text-muted") } }
        }
      }
    });
  }
  desenhar();
  document.addEventListener("themechange", desenhar);
  <% } %>
</script>

</body>
</html>