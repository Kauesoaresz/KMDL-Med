<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include("../partials/head", { title: "Estatísticas", css: ["estatisticas"] }) %>
</head>
<body class="page-bg">

<%- include("../partials/sidebar", { active: "estatisticas", userNome, userFoto }) %>

<main class="with-sidebar">
  <div class="page">

    <header class="page-header">
      <div>
        <h1>📊 Estatísticas</h1>
        <p>Escolha o que você quer analisar.</p>
      </div>
    </header>

    <div class="hub-grid">
      <a href="/estatisticas/estudos" class="card hub-card" style="--c: var(--chart-2)">
        <span class="hub-icon">📚</span>
        <h3>Estudos</h3>
        <p>Horas, questões, sequência e padrão semanal.</p>
        <span class="hub-go">Abrir →</span>
      </a>

      <a href="/estatisticas/conteudo/dashboard" class="card hub-card" style="--c: var(--chart-5)">
        <span class="hub-icon">📘</span>
        <h3>Conteúdo</h3>
        <p>Desempenho por matéria e por tópico.</p>
        <span class="hub-go">Abrir →</span>
      </a>

      <a href="/estatisticas/simulados" class="card hub-card" style="--c: var(--chart-1)">
        <span class="hub-icon">📝</span>
        <h3>Simulados</h3>
        <p>Evolução, áreas fortes e fracas, erros e lacunas.</p>
        <span class="hub-go">Abrir →</span>
      </a>

      <a href="/estatisticas/simulados/comparar" class="card hub-card" style="--c: var(--chart-3)">
        <span class="hub-icon">⚖️</span>
        <h3>Comparar simulados</h3>
        <p>Dois simulados lado a lado, área por área.</p>
        <span class="hub-go">Abrir →</span>
      </a>
    </div>

  </div>
</main>

</body>
</html>